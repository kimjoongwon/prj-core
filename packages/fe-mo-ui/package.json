{
	"name": "@cocrepo/mo-ui",
	"version": "1.0.0",
	"description": "mobile ui library",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./index.ts",
			"import": "./index.ts",
			"default": "./index.ts"
		},
		"./storybook": {
			"types": "./src/storybook/index.ts",
			"import": "./src/storybook/index.ts",
			"default": "./src/storybook/index.ts"
		},
		"./package.json": "./package.json"
	},
	"main": "./index.ts",
	"module": "./index.ts",
	"types": "./index.ts",
	"files": [
		"src",
		"index.ts",
		"README.md",
		"!dist/**/*.map",
		"!dist/**/*.tsbuildinfo",
		"!src/**/test/**",
		"!src/**/tests/**",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"scripts": {
		"build": "echo 'Build not needed - using source files directly'",
		"start:dev": "echo 'Development mode - no build needed'",
		"lint": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs",
		"lint:fix": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --fix",
		"test": "node ./node_modules/jest/bin/jest.js --config ./jest.config.js --runInBand --passWithNoTests",
		"type-check": "tsc --noEmit -p tsconfig.typecheck.json",
		"type-check:prod": "tsc --noEmit -p tsconfig.prod.json",
		"clean": "rm -rf .turbo && rm -rf node_modules",
		"lint:prod": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --prod"
	},
	"author": "kimjoongwon",
	"license": "ISC",
	"dependencies": {
		"@cocrepo/hook": "workspace:*",
		"@cocrepo/toolkit": "workspace:*",
		"@cocrepo/type": "workspace:*",
		"mobx": "catalog:",
		"mobx-react-lite": "catalog:",
		"tailwind-variants": "^3.3.1"
	},
	"peerDependencies": {
		"@gorhom/bottom-sheet": ">=5.2.9",
		"heroui-native": "^1.0.4",
		"lottie-react-native": ">=7.3.8",
		"react-native-safe-area-context": ">=5.6.0",
		"react-native-svg": ">=15.15.0",
		"uniwind": ">=1.6.0"
	},
	"devDependencies": {
		"@expo/dom-webview": "~57.0.1",
		"@expo/metro-runtime": "~57.0.17",
		"@gorhom/bottom-sheet": "catalog:",
		"@react-native/jest-preset": "0.88.0",
		"@storybook/react-native": "10.7.0",
		"@testing-library/react-native": "^13.3.3",
		"@types/jest": "^30.0.0",
		"@types/react": "~19.3.0",
		"expo": "~58.0.19",
		"expo-constants": "~58.0.13",
		"expo-linking": "~58.0.14",
		"expo-router": "~58.0.26",
		"heroui-native": "catalog:",
		"jest": "^30.5.2",
		"jest-expo": "~58.0.12",
		"lottie-react-native": "~7.5.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-svg": "15.16.0",
		"react-native-worklets": "0.13.0",
		"react-test-renderer": "19.3.0",
		"storybook": "10.4.0",
		"typescript": "~6.0.3",
		"uniwind": "^1.13.0"
	},
	"private": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kimjoongwon/prj-core.git",
		"directory": "packages/fe-mo-ui"
	}
}
