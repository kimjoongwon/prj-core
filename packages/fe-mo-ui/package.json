{
  "name": "@cocrepo/mo-ui",
  "version": "1.0.0",
  "description": "mobile ui library",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./index.ts",
  "module": "./index.ts",
  "types": "./index.ts",
  "files": [
    "src",
    "index.ts",
    "README.md"
  ],
  "scripts": {
    "build": "echo 'Build not needed - using source files directly'",
    "start:dev": "echo 'Development mode - no build needed'",
    "lint": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs",
    "lint:fix": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --fix",
    "test": "node ./node_modules/jest/bin/jest.js --config ./jest.config.js --runInBand --passWithNoTests",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "type-check:prod": "tsc --noEmit -p tsconfig.prod.json",
    "clean": "rm -rf .turbo && rm -rf node_modules",
    "lint:prod": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --prod"
  },
  "author": "kimjoongwon",
  "license": "ISC",
  "dependencies": {
    "@cocrepo/hook": "workspace:*",
    "@cocrepo/toolkit": "workspace:*",
    "@cocrepo/type": "workspace:*",
    "mobx": "catalog:",
    "mobx-react-lite": "catalog:",
    "tailwind-variants": "^3.2.2"
  },
  "peerDependencies": {
    "@gorhom/bottom-sheet": ">=5.2.9",
    "heroui-native": "^1.0.4",
    "lottie-react-native": ">=7.3.8",
    "react-native-svg": ">=15.15.0",
    "react-native-safe-area-context": ">=5.6.0",
    "uniwind": ">=1.6.0"
  },
  "devDependencies": {
    "@gorhom/bottom-sheet": "catalog:",
    "@expo/dom-webview": "~57.0.1",
		"@expo/metro-runtime": "~57.0.15",
		"@react-native/jest-preset": "0.86.3",
		"@storybook/react-native": "10.4.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "heroui-native": "catalog:",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "lottie-react-native": "~7.3.8",
    "@types/react": "catalog:",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "react-test-renderer": "19.2.3",
    "storybook": "10.4.0",
    "uniwind": "^1.6.3",
    "typescript": "~6.0.3"
  }
}
