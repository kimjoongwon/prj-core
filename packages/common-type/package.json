{
  "name": "@cocrepo/type",
  "version": "1.3.18",
  "description": "shared type library",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./database-id": {
      "types": "./src/database-id.ts",
      "import": "./src/database-id.ts",
      "default": "./src/database-id.ts"
    },
    "./bigint-json": {
      "types": "./src/bigint-json.ts",
      "import": "./src/bigint-json.ts",
      "default": "./src/bigint-json.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./index.ts",
  "module": "./index.ts",
  "types": "./index.ts",
  "files": [
    "src",
    "index.ts",
    "README.md"
  ],
  "scripts": {
    "build": "echo 'Build not needed - using source files directly'",
    "lint": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs",
    "lint:fix": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --fix",
    "format": "biome check --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "type-check:prod": "tsc --noEmit",
    "clean": "rm -rf .turbo && rm -rf node_modules",
    "lint:prod": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --prod"
  },
  "author": "kimjoongwon",
  "license": "ISC",
  "devDependencies": {
    "@heroui/react": "catalog:",
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
