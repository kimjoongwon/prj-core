{
	"name": "@cocrepo/controller",
	"version": "0.1.0",
	"private": true,
	"description": "NestJS REST controller layer for cocrepo",
	"files": [
		"dist",
		"README.md"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"type-check": "tsc --noEmit",
		"type-check:prod": "tsc --noEmit",
		"build": "rm -rf dist && tsc --build",
		"start:dev": "tsc --build --watch",
		"lint": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs",
		"lint:fix": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --fix",
		"format": "biome check --write .",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
		"test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
		"clean": "rm -rf dist && rm -rf node_modules",
		"lint:prod": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --prod"
	},
	"dependencies": {
		"@cocrepo/be-common": "workspace:*",
		"@cocrepo/command": "workspace:*",
		"@cocrepo/constant": "workspace:*",
		"@cocrepo/context": "workspace:*",
		"@cocrepo/decorator": "workspace:*",
		"@cocrepo/dto": "workspace:*",
		"@cocrepo/entity": "workspace:*",
		"@cocrepo/enum": "workspace:*",
		"@cocrepo/prisma": "workspace:*",
		"@cocrepo/service": "workspace:*",
		"@cocrepo/type": "workspace:*"
	},
	"peerDependencies": {
		"@nestjs/common": "^12.0.0",
		"@nestjs/cqrs": "^12.0.0",
		"@nestjs/platform-express": "^12.0.0",
		"@nestjs/swagger": "^12.0.0",
		"express": "^5.1.0",
		"multer": "^2.0.2"
	},
	"devDependencies": {
		"@cocrepo/tsconfig": "workspace:*",
		"@nestjs/common": "^12.0.0",
		"@nestjs/cqrs": "^12.0.0",
		"@nestjs/platform-express": "^12.0.0",
		"@nestjs/swagger": "^12.0.0",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/multer": "^2.3.0",
		"@types/node": "catalog:",
		"express": "^5.3.0",
		"jest": "^30.5.2",
		"multer": "^2.5.0",
		"reflect-metadata": "^0.2.2",
		"ts-jest": "^29.4.15",
		"typescript": "catalog:"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		}
	}
}
