{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "incremental": false,
    "outDir": "./dist/esm"
  },
  "include": ["src/**/*", "index.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/__tests__",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
