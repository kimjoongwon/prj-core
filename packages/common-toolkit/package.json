{
  "name": "@cocrepo/toolkit",
  "version": "1.3.16",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "start:dev": "tsc --build --watch",
    "build": "rm -rf dist && tsc --build",
    "format": "biome check --write .",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "type-check:prod": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs",
    "lint:fix": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --fix",
    "lint:prod": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --prod"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.0",
    "path-parser": "^6.1.0",
    "reflect-metadata": "^0.1.13"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "catalog:",
    "path-parser": "6.1.0",
    "reflect-metadata": "^0.1.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@cocrepo/constant": "workspace:*",
    "@cocrepo/type": "workspace:*",
    "es-toolkit": "^1.26.1"
  }
}
