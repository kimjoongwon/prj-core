# ============================================
# Prisma Environment Variables Template
# ============================================
#
# 사용법:
# 1. 이 파일을 .env로 복사
# 2. 실제 값으로 변경
# 3. 절대 .env를 커밋하지 마세요!
#
# ============================================

# Development Environment (기본값)
DATABASE_URL="postgresql://cocrepo:devpassword@localhost:5432/plate?schema=public"
DIRECT_URL="postgresql://cocrepo:devpassword@localhost:5432/plate?schema=public"

# E2E Test Environment (db:e2e:reset 전용)
E2E_DATABASE_URL="postgresql://cocrepo:devpassword@localhost:5432/plate_e2e?schema=public"
E2E_DIRECT_URL="postgresql://cocrepo:devpassword@localhost:5432/plate_e2e?schema=public"

# Staging Environment
DATABASE_URL_STG="postgresql://user:password@stg-host:5432/dbname?schema=public&connection_limit=5&pool_timeout=20"
DIRECT_URL_STG="postgresql://user:password@stg-host:5432/dbname?schema=public"

# Production Environment
DATABASE_URL_PROD="postgresql://user:password@prod-host:5432/dbname?schema=public&connection_limit=5&pool_timeout=20"
DIRECT_URL_PROD="postgresql://user:password@prod-host:5432/dbname?schema=public"

# Bootstrap administrator (required when running bootstrap; never commit the real values)
LOCAL_BOOTSTRAP_ADMIN_EMAIL="admin@example.invalid"
LOCAL_BOOTSTRAP_ADMIN_PASSWORD="change-me-before-start"
LOCAL_BOOTSTRAP_ADMIN_PHONE="00000000000"
LOCAL_BOOTSTRAP_ADMIN_NAME="Local Administrator"
LOCAL_BOOTSTRAP_ADMIN_NICKNAME="local-admin"
# Production additionally requires BOOTSTRAP_ADMIN_PHONE/NAME/NICKNAME.

# Optional OIDC URL Overrides for bootstrap / reference-data
OIDC_ADMIN_BASE_URL="http://localhost:3000"
OIDC_STORYBOOK_BASE_URL="http://localhost:6006"
OIDC_ADMIN_CLIENT_SECRET="admin-secret-change-in-development"
OIDC_STORYBOOK_CLIENT_SECRET="storybook-secret-change-in-development"
OIDC_ISSUER="http://localhost:3000"
