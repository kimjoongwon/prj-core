// @data-type: MASTER
// @description: User에 종속되어 프로필 정보를 관리하는 1:N 하위 모델
/// @displayName 프로필
model Profile {
  id           String    @unique @default(ulid()) @map("profile_id") @db.Char(26)
  seq          BigInt    @id @default(autoincrement()) @map("id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 이름
  name         String
  /// @displayName 닉네임
  nickname     String    @unique
  /// @displayName 주소
  address      String
  userSeq      BigInt    @map("user_id")
  avatarFileId String?   @map("avatar_file_id")
  user         User      @relation(fields: [userSeq], references: [seq])

  @@map("profiles")
}
