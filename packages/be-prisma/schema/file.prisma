// ============================================================================
// File Domain - 파일 도메인
// ============================================================================
//
// File은 시스템의 파일/디렉토리 구조를 관리합니다.
// 자기 참조(self-reference)를 통해 계층 구조를 형성합니다.
//
// 관계 구조:
//   File (구체 엔티티, 트리 구조)
//     │
//     ├─── File (자기 참조: parent/children)
//     ├─── FileClassification ─── Category (분류)
//     └─── FileAssociation ─── Group (그룹핑)
//
// ============================================================================

// @schema-type: CONCRETE ENTITY
// @description: 파일/디렉토리를 관리하는 핵심 도메인 객체 (트리 구조)
// @self-reference: parent/children
model File {
  id             String              @id @default(uuid())
  name           String
  size           Int
  parentId       String?             @map("parent_id")
  mimeType       String              @map("mime_type")
  url            String
  spaceId        String              @map("space_id")
  creatorId      String?             @map("creator_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime?           @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt      DateTime?           @map("removed_at") @db.Timestamptz(6)
  parent         File?               @relation("FileParent", fields: [parentId], references: [id])
  children       File[]              @relation("FileParent")
  space          Space               @relation(fields: [spaceId], references: [id])
  creator        User?               @relation(fields: [creatorId], references: [id])
  associations   FileAssociation[]
  classification FileClassification?

  @@index([spaceId])
  @@map("files")
}

// @schema-type: CLASSIFICATION
// @description: File에 Category를 연결하여 분류 체계 부여
// @connects: File ─── Category
model FileClassification {
  id         String    @id @default(uuid())
  categoryId String    @map("category_id")
  fileId     String    @unique @map("file_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(6)
  category   Category  @relation(fields: [categoryId], references: [id])
  file       File      @relation(fields: [fileId], references: [id])

  @@unique([categoryId, fileId])
  @@map("file_classifications")
}

// @schema-type: ASSOCIATION
// @description: File과 Group을 연결하여 그룹핑
// @connects: File ─── Group
model FileAssociation {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  fileId    String    @map("file_id")
  groupId   String    @map("group_id")
  file      File      @relation(fields: [fileId], references: [id])
  group     Group     @relation(fields: [groupId], references: [id])

  @@unique([groupId, fileId])
  @@map("file_associations")
}
