// @data-type: MASTER
// @aggregate-root: true
// @description: FitnessCenter 등 1:1 상세 모델의 공통 identity와 소속 관계를 제공하는 공간 기반 모델
/// @displayName 공간
model Space {
  spaceId              String                @unique @default(ulid()) @map("space_id") @db.Char(26)
  id                   BigInt                @id @default(autoincrement())
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?             @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt            DateTime?             @map("removed_at") @db.Timestamptz(6)
  /// @displayName 콘텐츠 언어
  contentLanguageCode  LanguageCode          @default(ko_KR) @map("content_language_code")
  fitnessCenter        FitnessCenter?
  associations         SpaceAssociation[]
  classification       SpaceClassification?
  tenants              Tenant[]
  emailVerifications   EmailVerification[]
  tenantAccessRequests TenantAccessRequest[]
  policies             Policy[]
  safeWallets          SafeWallet[]
  folders              Folder[]
  categories           Category[]
  contents             Content[]
  tasks                Task[]
  inquiries            Inquiry[]
  albums               Album[]
  albumEntries         AlbumEntry[]
  groups               Group[]
  reservations         Reservation[]
  routines             Routine[]
  assets               Asset[]
  derivatives          Derivative[]
  timelines            Timeline[]

  @@index([contentLanguageCode])
  @@map("spaces")
}
