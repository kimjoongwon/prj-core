// @data-type: MASTER
// @description: 사업자/회사 정보를 관리하고 여러 피트니스 센터를 묶는 모델
/// @displayName 회사
model Company {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt       DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 회사명
  name            String
  /// @displayName 라벨
  label           String?
  /// @displayName 주소
  address         String
  /// @displayName 전화번호
  phone           String
  /// @displayName 이메일
  email           String
  /// @displayName 사업자등록번호
  businessNo      String    @map("business_no")
  logoImageFileId String?   @map("logo_image_file_id")
  fitnessCenters  FitnessCenter[]

  @@map("companies")
}
