// @data-type: MASTER
// @description: Space와 Category를 연결하는 분류 링크
/// @displayName 공간 분류
model SpaceClassification {
  id          String    @unique @default(ulid()) @db.VarChar(26)
  seq         Int       @id @default(autoincrement())
  categorySeq Int       @map("category_seq")
  spaceSeq    Int       @unique @map("space_seq")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  category    Category  @relation(fields: [categorySeq], references: [seq])
  space       Space     @relation(fields: [spaceSeq], references: [seq])

  @@unique([categorySeq, spaceSeq])
  @@map("space_classifications")
}
