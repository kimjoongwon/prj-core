// @data-type: MASTER
// @description: Space와 Category를 연결하는 분류 링크
/// @displayName 공간 분류
model SpaceClassification {
  id          String    @unique @default(ulid()) @map("space_classification_id") @db.Char(26)
  seq         BigInt    @id @default(autoincrement()) @map("id")
  categorySeq BigInt    @map("category_id")
  spaceSeq    BigInt    @unique @map("space_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  category    Category  @relation(fields: [categorySeq], references: [seq])
  space       Space     @relation(fields: [spaceSeq], references: [seq])

  @@unique([categorySeq, spaceSeq])
  @@map("space_classifications")
}
