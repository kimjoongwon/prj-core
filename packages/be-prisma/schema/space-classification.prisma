// @data-type: MASTER
// @description: Space와 Category를 연결하는 분류 링크
/// @displayName 공간 분류
model SpaceClassification {
  spaceClassificationId String    @unique @default(ulid()) @map("space_classification_id") @db.Char(26)
  id                    BigInt    @id @default(autoincrement())
  categoryId            BigInt    @map("category_id")
  spaceId               BigInt    @unique @map("space_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt             DateTime? @map("removed_at") @db.Timestamptz(6)
  category              Category  @relation(fields: [categoryId], references: [id])
  space                 Space     @relation(fields: [spaceId], references: [id])

  @@unique([categoryId, spaceId])
  @@map("space_classifications")
}
