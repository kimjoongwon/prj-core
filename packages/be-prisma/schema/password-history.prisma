// @data-type: EVENT
// @description: 비밀번호 재사용 방지를 위해 이전 해시를 누적 보관하는 이력 로그
/// @displayName 비밀번호 히스토리
model PasswordHistory {
  id           String   @unique @default(ulid()) @db.VarChar(26)
  seq          Int      @id @default(autoincrement())
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// @displayName 사용자 내부 순번
  userSeq      Int      @map("user_seq")
  /// @displayName 비밀번호 해시
  passwordHash String   @map("password_hash")

  user User @relation(fields: [userSeq], references: [seq], onDelete: Cascade)

  @@index([userSeq])
  @@map("password_histories")
}
