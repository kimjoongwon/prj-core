// ============================================================================
// Tenant Access Request Domain - 테넌트 접근 신청 도메인
// ============================================================================
//
// TenantAccessRequest는 사용자가 특정 Space와 Role을 요청하고,
// 권한 있는 관리자가 승인/반려하는 워크플로우 aggregate입니다.
//
// 관계 구조:
//   TenantAccessRequest (ROOT)
//     │
//     ├─── requester User
//     ├─── reviewer User?
//     ├─── Space
//     ├─── requested Role
//     ├─── previous Role?
//     └─── applied Tenant?
//
// ============================================================================

enum TenantAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

// @schema-type: ROOT
// @schema-owner: true
// @aggregate-root: true
// @usecase-anchor: true
// @description: 사용자의 Space/Role 접근 신청과 승인/반려 이력을 관리하는 aggregate
// @ownership: independent
// @scope: tenant
/// @displayName 테넌트 접근 신청
model TenantAccessRequest {
  id              String                    @id @default(uuid())
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt       DateTime?                 @map("removed_at") @db.Timestamptz(6)
  requesterId     String                    @map("requester_id")
  spaceId         String                    @map("space_id")
  requestedRoleId String                    @map("requested_role_id")
  previousRoleId  String?                   @map("previous_role_id")
  reason          String?
  status          TenantAccessRequestStatus @default(PENDING)
  reviewerId      String?                   @map("reviewer_id")
  reviewComment   String?                   @map("review_comment")
  reviewedAt      DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  appliedTenantId String?                   @map("applied_tenant_id")
  requester       User                      @relation("TenantAccessRequestRequester", fields: [requesterId], references: [id])
  reviewer        User?                     @relation("TenantAccessRequestReviewer", fields: [reviewerId], references: [id])
  space           Space                     @relation(fields: [spaceId], references: [id])
  requestedRole   Role                      @relation("TenantAccessRequestRequestedRole", fields: [requestedRoleId], references: [id])
  previousRole    Role?                     @relation("TenantAccessRequestPreviousRole", fields: [previousRoleId], references: [id])
  appliedTenant   Tenant?                   @relation(fields: [appliedTenantId], references: [id])

  @@index([requesterId])
  @@index([spaceId])
  @@index([status])
  @@index([requesterId, spaceId, status])
  @@map("tenant_access_requests")
}
