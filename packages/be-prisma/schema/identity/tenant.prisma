// ============================================================================
// Tenant Domain - 테넌트 연결 도메인
// ============================================================================

// @schema-type: JOIN
// @schema-owner: true
// @aggregate-root: true
// @description: User + Space + Role을 연결하는 멤버십 모델
// @relation-pattern: many-to-many
// @ownership: independent
// @scope: tenant
// @join-role: membership
// @connects: User ─── Space ─── Role
// @note: 사용자가 특정 공간에서 어떤 역할을 가지는지를 정의
/// @displayName 테넌트
model Tenant {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  userId    String    @map("user_id")
  spaceId   String    @map("space_id")
  roleId    String    @map("role_id")
  role      Role      @relation(fields: [roleId], references: [id])
  space     Space     @relation(fields: [spaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  accessRequests    TenantAccessRequest[]
  policies          Policy[]
  categories        Category[]
  groups            Group[]
  contents          Content[]
  timelines         Timeline[]
  tasks             Task[]
  safeWallets       SafeWallet[]
  routines          Routine[]
  reservations      Reservation[]
  folders           Folder[]
  assets            Asset[]
  albums            Album[]
  albumEntries      AlbumEntry[]
  derivatives       Derivative[]
  inquiries         Inquiry[]

  @@unique([userId, spaceId])
  @@index([spaceId])
  @@index([roleId])
  @@map("tenants")
}
