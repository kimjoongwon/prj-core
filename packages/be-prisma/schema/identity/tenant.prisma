// ============================================================================
// Tenant Domain - 테넌트 연결 도메인
// ============================================================================

// @schema-type: JOIN
// @schema-owner: true
// @aggregate-root: true
// @description: User + Space + Role을 연결하는 멤버십 모델
// @relation-pattern: many-to-many
// @ownership: independent
// @scope: tenant
// @join-role: membership
// @connects: User ─── Space ─── Role
// @note: 사용자가 특정 공간에서 어떤 역할을 가지는지를 정의
/// @displayName 테넌트
model Tenant {
  id          String       @id @default(uuid())
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?    @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime?    @map("removed_at") @db.Timestamptz(6)
  userId      String       @map("user_id")
  spaceId     String       @map("space_id")
  roleId      String       @map("role_id")
  assignments Assignment[]
  role        Role         @relation(fields: [roleId], references: [id])
  space       Space        @relation(fields: [spaceId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  accessRequests TenantAccessRequest[]

  @@unique([userId, spaceId])
  @@map("tenants")
}

// @schema-type: JOIN
// @description: Tenant에 추가 Role을 부여하는 역할 할당 조인 모델
// @relation-pattern: many-to-many
// @ownership: dependent
// @scope: tenant
// @join-role: assignment
// @connects: Tenant ─── Role
/// @displayName 역할 할당
model Assignment {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  roleId    String    @map("role_id")
  tenantId  String    @map("tenant_id")
  role      Role      @relation(fields: [roleId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@map("assignments")
}
