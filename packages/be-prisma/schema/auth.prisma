// ============================================================================
// Auth Security Domain - 인증 보안 도메인
// ============================================================================
//
// 인증 보안 관련 모델들입니다.
// 감사 로그, 비밀번호 히스토리 등이 포함됩니다.
//
// 관계 구조:
//   User (구체 엔티티)
//     │
//     ├─── AuthAuditLog (인증 감사 로그)
//     └─── PasswordHistory (비밀번호 재사용 방지)
//
// ============================================================================

// @schema-type: REFERENCE
// @description: 로그인 시도 감사 로그
/// @displayName 인증 감사 로그
model AuthAuditLog {
  id            String          @id @default(uuid())
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  /// @displayName 이메일
  email         String
  /// @displayName 사용자 ID
  userId        String?         @map("user_id")
  /// @displayName 결과
  result        AuthAuditResult
  /// @displayName 실패 사유
  failureReason String?         @map("failure_reason")
  /// @displayName IP 주소
  ipAddress     String          @map("ip_address")
  /// @displayName User Agent
  userAgent     String?         @map("user_agent")
  /// @displayName 클라이언트 ID
  clientId      String?         @map("client_id")

  user          User?           @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([userId])
  @@index([createdAt])
  @@index([result])
  @@map("auth_audit_logs")
}

/// @displayName 인증 감사 결과
enum AuthAuditResult {
  SUCCESS
  FAILURE
  LOCKED
}

// @schema-type: REFERENCE
// @description: 이전 비밀번호 해시 저장 (재사용 방지)
/// @displayName 비밀번호 히스토리
model PasswordHistory {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// @displayName 사용자 ID
  userId        String   @map("user_id")
  /// @displayName 비밀번호 해시
  passwordHash  String   @map("password_hash")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_histories")
}
