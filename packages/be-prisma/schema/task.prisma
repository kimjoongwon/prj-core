// @data-type: CONFIGURATION
// @aggregate-root: true
// @description: Exercise 등 1:1 상세 모델의 공통 identity와 소속 관계를 제공하는 작업 기반 모델
/// @displayName 태스크
model Task {
  id           String     @unique @default(ulid()) @map("task_id") @db.Char(26)
  seq          BigInt     @id @default(autoincrement()) @map("id")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime?  @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt    DateTime?  @map("removed_at") @db.Timestamptz(6)
  spaceSeq     BigInt     @map("space_id")
  createdBySeq BigInt?    @map("created_by_id")
  space        Space      @relation(fields: [spaceSeq], references: [seq], onDelete: Restrict)
  createdBy    User?      @relation(fields: [createdBySeq], references: [seq], onDelete: SetNull)
  activities   Activity[]
  exercise     Exercise?

  @@index([spaceSeq])
  @@map("tasks")
}
