// @data-type: EVENT
// @description: AI 문의 처리 시도와 결과를 추적하는 실행 로그
/// @displayName AI 에이전트 로그
model AIAgentLog {
  aiAgentLogId   String          @unique @default(ulid()) @map("ai_agent_log_id") @db.Char(26)
  id             BigInt          @id @default(autoincrement())
  /// @displayName 생성 일시
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  /// @displayName 소속 문의 내부 순번
  inquiryId      BigInt          @map("inquiry_id")
  /// @displayName 관련 메시지 내부 순번
  messageId      BigInt?         @unique @map("message_id")
  /// @displayName AI 작업 유형
  action         AIAgentAction
  /// @displayName 입력 데이터
  input          Json?
  /// @displayName 출력 결과
  output         Json?
  /// @displayName AI 신뢰도
  confidence     Float?
  /// @displayName 사용자 수락 여부
  wasAccepted    Boolean?
  /// @displayName 사용자 수정 여부
  wasModified    Boolean?
  /// @displayName 응답 시간 (ms)
  responseTimeMs Int?            @map("response_time_ms")
  /// @displayName 사용된 AI 모델
  model          String?
  /// @displayName 사용된 토큰 수
  tokenCount     Int?            @map("token_count")
  /// @displayName 에러 메시지
  errorMessage   String?         @map("error_message")
  inquiry        Inquiry         @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  message        InquiryMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([inquiryId])
  @@index([action])
  @@map("ai_agent_logs")
}
