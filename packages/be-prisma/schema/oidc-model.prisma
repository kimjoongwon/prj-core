// ============================================================================
// OIDC Model Domain - OIDC 저장소 도메인
// ============================================================================

// @schema-type: REFERENCE
// @description: oidc-provider가 사용하는 범용 모델 저장소
/// @displayName OIDC 모델
model OidcModel {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// @displayName 모델 키 (jti 또는 uid)
  key       String    @unique
  /// @displayName 모델 타입
  modelType String    @map("model_type")
  /// @displayName 페이로드 (JSON)
  payload   Json
  /// @displayName 만료 시간
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  /// @displayName 사용자 코드 (DeviceCode용)
  userCode  String?   @unique @map("user_code")
  /// @displayName Grant ID (토큰 취소용)
  grantId   String?   @map("grant_id")
  /// @displayName 세션 UID
  uid       String?   @unique

  @@index([modelType])
  @@index([grantId])
  @@index([expiresAt])
  @@map("oidc_models")
}
