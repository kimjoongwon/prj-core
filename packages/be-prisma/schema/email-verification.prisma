// @data-type: TRANSACTION
// @aggregate-root: true
// @description: 회원가입 전 이메일 인증 요청과 발송/완료 상태를 기록하는 전역 인증 로그
/// @displayName 이메일 인증
model EmailVerification {
  id              String                  @unique @default(ulid()) @db.VarChar(26)
  seq             Int                     @id @default(autoincrement())
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?               @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt       DateTime?               @map("removed_at") @db.Timestamptz(6)
  /// @displayName 이메일
  email           String
  /// @displayName 이름
  name            String
  /// @displayName 닉네임
  nickname        String
  /// @displayName 전화번호
  phone           String
  /// @displayName 주소
  address         String
  /// @displayName 가입 Space 내부 순번
  spaceSeq        Int                     @map("space_seq")
  space           Space                   @relation(fields: [spaceSeq], references: [seq], onDelete: Restrict)
  /// @displayName 비밀번호 해시
  passwordHash    String                  @map("password_hash")
  /// @displayName 토큰 해시
  tokenHash       String                  @unique @map("token_hash")
  /// @displayName 상태
  status          EmailVerificationStatus @default(PENDING)
  /// @displayName 만료 시각
  expiresAt       DateTime                @map("expires_at") @db.Timestamptz(6)
  /// @displayName 인증 시각
  verifiedAt      DateTime?               @map("verified_at") @db.Timestamptz(6)
  /// @displayName 마지막 발송 시각
  lastSentAt      DateTime?               @map("last_sent_at") @db.Timestamptz(6)
  /// @displayName 발송 횟수
  sendCount       Int                     @default(0) @map("send_count")
  /// @displayName 마지막 발송 상태
  lastSendStatus  String?                 @map("last_send_status")
  /// @displayName 마지막 발송 오류
  lastSendError   String?                 @map("last_send_error")
  /// @displayName 인증 완료 사용자 내부 순번
  verifiedUserSeq Int?                    @map("verified_user_seq")
  verifiedUser    User?                   @relation(fields: [verifiedUserSeq], references: [seq], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([spaceSeq])
  @@index([verifiedUserSeq])
  @@map("email_verifications")
}
