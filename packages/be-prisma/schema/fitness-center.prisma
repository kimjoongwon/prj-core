// @data-type: MASTER
// @description: Company 아래에서 Space와 1:1로 연결되는 피트니스 센터 시설 정보를 관리합니다. 공간의 이름은 Space가 소유합니다.
/// @displayName 피트니스 센터
model FitnessCenter {
  id          String    @unique @default(ulid()) @map("fitness_center_id") @db.Char(26)
  seq         BigInt    @id @default(autoincrement()) @map("id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 주소
  address     String
  /// @displayName 전화번호
  phone       String
  /// @displayName 이메일
  email       String
  companySeq  BigInt    @map("company_id")
  spaceSeq    BigInt    @unique @map("space_id")
  imageFileId String?   @map("image_file_id")
  company     Company   @relation(fields: [companySeq], references: [seq])
  space       Space     @relation(fields: [spaceSeq], references: [seq])

  @@index([companySeq])
  @@map("fitness_centers")
}
