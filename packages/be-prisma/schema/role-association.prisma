// @data-type: REFERENCE
// @description: Role과 Group을 연결하는 그룹 링크
/// @displayName 역할 그룹
model RoleAssociation {
  id        String    @unique @default(ulid()) @db.VarChar(26)
  seq       Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  roleSeq   Int       @unique @map("role_seq")
  groupSeq  Int       @map("group_seq")
  group     Group     @relation(fields: [groupSeq], references: [seq])
  role      Role      @relation(fields: [roleSeq], references: [seq])

  @@unique([groupSeq, roleSeq])
  @@map("role_associations")
}
