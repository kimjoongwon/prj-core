// @data-type: REFERENCE
// @description: Role과 Group을 연결하는 그룹 링크
/// @displayName 역할 그룹
model RoleAssociation {
  id        String    @unique @default(ulid()) @map("role_association_id") @db.Char(26)
  seq       BigInt    @id @default(autoincrement()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  roleSeq   BigInt    @unique @map("role_id")
  groupSeq  BigInt    @map("group_id")
  group     Group     @relation(fields: [groupSeq], references: [seq])
  role      Role      @relation(fields: [roleSeq], references: [seq])

  @@unique([groupSeq, roleSeq])
  @@map("role_associations")
}
