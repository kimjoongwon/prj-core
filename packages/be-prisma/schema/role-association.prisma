// @data-type: REFERENCE
// @description: Role과 Group을 연결하는 그룹 링크
/// @displayName 역할 그룹
model RoleAssociation {
  roleAssociationId String    @unique @default(ulid()) @map("role_association_id") @db.Char(26)
  id                BigInt    @id @default(autoincrement())
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt         DateTime? @map("removed_at") @db.Timestamptz(6)
  roleId            BigInt    @unique @map("role_id")
  groupId           BigInt    @map("group_id")
  group             Group     @relation(fields: [groupId], references: [id])
  role              Role      @relation(fields: [roleId], references: [id])

  @@unique([groupId, roleId])
  @@map("role_associations")
}
