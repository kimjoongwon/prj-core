// ============================================================================
// Folder Domain - 폴더 트리 도메인
// ============================================================================

// @schema-type: ROOT
// @schema-owner: true
// @aggregate-root: true
// @description: 에셋 저장 구조를 독립 관리하는 Space 범위 폴더 루트
// @ownership: independent
// @scope: space
// @self-reference: parent/children
/// @displayName 폴더
model Folder {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt      DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 소속 Space
  tenantId       String    @map("tenant_id")
  /// @displayName 상위 폴더 ID
  parentFolderId String?   @map("parent_folder_id")
  /// @displayName 폴더명
  name           String
  /// @displayName 전체 경로
  path           String    @unique
  /// @displayName 정렬 순서
  sortOrder      Int       @default(0) @map("sort_order")
  /// @displayName 생성자
  creatorId      String?   @map("creator_id")
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  parent         Folder?   @relation("FolderParent", fields: [parentFolderId], references: [id])
  children       Folder[]  @relation("FolderParent")
  creator        User?     @relation(fields: [creatorId], references: [id])
  assets         Asset[]

  @@index([tenantId])
  @@index([parentFolderId])
  @@index([path])
  @@map("folders")
}
