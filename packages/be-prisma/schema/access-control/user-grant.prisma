// ============================================================================
// UserGrant Domain - 사용자 예외 권한 부여 도메인
// ============================================================================

// @schema-type: JOIN
// @schema-owner: true
// @aggregate-root: true
// @description: User와 Ability를 연결하는 사용자 예외 권한 정책 조인 모델
// @relation-pattern: one-to-many
// @ownership: independent
// @scope: tenant
// @join-role: policy-link
// @connects: User ─── Ability
/// @displayName 사용자 권한 부여
model UserGrant {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 사용자 ID
  userId    String    @map("user_id")
  /// @displayName 권한 ID
  abilityId String    @map("ability_id")
  /// @displayName 활성화 여부
  isActive  Boolean   @default(true) @map("is_active")
  /// @displayName 우선순위
  priority  Int       @default(10)
  user      User      @relation(fields: [userId], references: [id])
  ability   Ability   @relation(fields: [abilityId], references: [id])

  @@unique([userId, abilityId])
  @@index([userId])
  @@index([abilityId])
  @@index([isActive])
  @@map("user_grants")
}
