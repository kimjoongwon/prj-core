// ============================================================================
// Role Domain - 역할 도메인
// ============================================================================
//
// Role은 시스템의 권한 체계를 정의합니다.
// RolePolicy를 통해 Policy가 부여되고, Tenant를 통해 User와 Space에 연결됩니다.
//
// 관계 구조:
//   Role (ROOT)
//     │
//     ├─── RolePolicy ─── Policy ─── PolicyAbility ─── Ability (권한 정의)
//     ├─── RoleClassification ─── Category (분류)
//     ├─── RoleAssociation ─── Group (그룹핑)
//     └─── Tenant (JOIN: User + Space + Role)
//
// ============================================================================

// @schema-type: ROOT
// @schema-owner: true
// @aggregate-root: true
// @usecase-anchor: true
// @description: 권한 체계를 정의하는 핵심 역할 도메인 객체
// @ownership: independent
// @scope: tenant
/// @displayName 역할
model Role {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)

  /// @displayName 역할 식별자
  name        String  @unique
  /// @displayName 표시명
  displayName String? @map("display_name")
  /// @displayName 설명
  description String?
  /// @displayName 시스템 역할 여부
  isSystem    Boolean @default(false) @map("is_system")

  associations                  RoleAssociation[]
  classification                RoleClassification?
  rolePolicies                  RolePolicy[]
  tenants                       Tenant[]
  requestedTenantAccessRequests TenantAccessRequest[] @relation("TenantAccessRequestRequestedRole")
  previousTenantAccessRequests  TenantAccessRequest[] @relation("TenantAccessRequestPreviousRole")

  @@map("roles")
}

// @schema-type: JOIN
// @description: Role과 Group을 연결하는 그룹 링크
// @relation-pattern: one-to-many
// @ownership: dependent
// @scope: tenant
// @join-role: simple-link
// @connects: Role ─── Group
/// @displayName 역할 그룹
model RoleAssociation {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  roleId    String    @unique @map("role_id")
  groupId   String    @map("group_id")
  group     Group     @relation(fields: [groupId], references: [id])
  role      Role      @relation(fields: [roleId], references: [id])

  @@unique([groupId, roleId])
  @@map("role_associations")
}

// @schema-type: JOIN
// @description: Role과 Category를 연결하는 분류 링크
// @relation-pattern: one-to-many
// @ownership: dependent
// @scope: tenant
// @join-role: simple-link
// @connects: Role ─── Category
/// @displayName 역할 분류
model RoleClassification {
  id         String    @id @default(uuid())
  categoryId String    @map("category_id")
  roleId     String    @unique @map("role_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(6)
  category   Category  @relation(fields: [categoryId], references: [id])
  role       Role      @relation(fields: [roleId], references: [id])

  @@unique([categoryId, roleId])
  @@map("role_classifications")
}
