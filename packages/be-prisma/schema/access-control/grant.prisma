// ============================================================================
// Grant Domain - 권한 부여 도메인
// ============================================================================

// @schema-type: JOIN
// @schema-owner: true
// @aggregate-root: true
// @description: Role 또는 User와 Ability를 연결하는 권한 정책 조인 모델
// @relation-pattern: polymorphic
// @ownership: independent
// @scope: mixed
// @join-role: policy-link
// @connects: Role/User ─── Ability
// @polymorphic: granteeType (Role | User) + granteeId
/// @displayName 권한 부여
model Grant {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 권한 대상 유형
  granteeType String @map("grantee_type")
  /// @displayName 권한 대상 ID
  granteeId   String @map("grantee_id")
  /// @displayName 권한 ID
  abilityId   String @map("ability_id")
  /// @displayName 활성화 여부
  isActive Boolean @default(true) @map("is_active")
  /// @displayName 우선순위
  priority Int     @default(0)
  ability Ability @relation(fields: [abilityId], references: [id])

  @@unique([granteeType, granteeId, abilityId])
  @@index([granteeType, granteeId])
  @@index([abilityId])
  @@index([isActive])
  @@map("grants")
}
