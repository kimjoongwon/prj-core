// @data-type: CONFIGURATION
// @aggregate-root: true
// @description: 서비스에서 사용자에게 노출하는 약관/동의 문서의 버전 단위 관리 객체
/// @displayName 서비스 문서
model ServiceDocument {
  id        String    @unique @default(ulid()) @db.VarChar(26)
  seq       Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)

  /// @displayName 문서 종류
  kind         ServiceDocumentKind
  /// @displayName 노출 플랫폼
  platform     ServiceDocumentPlatform @default(ALL)
  /// @displayName 로케일
  locale       String                  @default("ko-KR")
  /// @displayName 제목
  title        String
  /// @displayName 요약
  summary      String?
  /// @displayName 본문
  content      String                  @db.Text
  /// @displayName 본문 형식
  format       ServiceDocumentFormat   @default(MARKDOWN)
  /// @displayName 버전
  version      String
  /// @displayName 상태
  status       ServiceDocumentStatus   @default(DRAFT)
  /// @displayName 필수 동의 여부
  isRequired   Boolean                 @default(true) @map("is_required")
  /// @displayName 정렬 순서
  displayOrder Int                     @default(0) @map("display_order")
  /// @displayName 효력 시작 시각
  effectiveAt  DateTime?               @map("effective_at") @db.Timestamptz(6)
  /// @displayName 게시 시각
  publishedAt  DateTime?               @map("published_at") @db.Timestamptz(6)

  @@unique([kind, platform, locale, version])
  @@index([kind, platform, locale, status])
  @@index([status])
  @@index([publishedAt])
  @@map("service_documents")
}
