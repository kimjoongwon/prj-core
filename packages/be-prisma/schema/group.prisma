// @data-type: MASTER
// @aggregate-root: true
// @description: 사용자·공간·역할을 묶는 그룹 루트
/// @displayName 그룹
model Group {
  id                String             @id @default(uuid())
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime?          @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt         DateTime?          @map("removed_at") @db.Timestamptz(6)
  /// @displayName 이름
  name              String
  /// @displayName 유형
  type              GroupTypes         @default(User)
  /// @displayName 라벨
  label             String?
  spaceId           String             @map("space_id")
  createdById       String?            @map("created_by_id")
  space             Space              @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  createdBy         User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  roleAssociations  RoleAssociation[]
  spaceAssociations SpaceAssociation[]
  userAssociations  UserAssociation[]

  @@index([spaceId])
  @@map("groups")
}
