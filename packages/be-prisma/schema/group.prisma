// @data-type: MASTER
// @aggregate-root: true
// @description: 사용자·공간·역할을 묶는 그룹 루트
/// @displayName 그룹
model Group {
  id                String             @unique @default(ulid()) @db.VarChar(26)
  seq               Int                @id @default(autoincrement())
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime?          @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt         DateTime?          @map("removed_at") @db.Timestamptz(6)
  /// @displayName 이름
  name              String
  /// @displayName 유형
  type              GroupTypes         @default(User)
  /// @displayName 라벨
  label             String?
  spaceSeq          Int                @map("space_seq")
  createdBySeq      Int?               @map("created_by_seq")
  space             Space              @relation(fields: [spaceSeq], references: [seq], onDelete: Restrict)
  createdBy         User?              @relation(fields: [createdBySeq], references: [seq], onDelete: SetNull)
  roleAssociations  RoleAssociation[]
  spaceAssociations SpaceAssociation[]
  userAssociations  UserAssociation[]

  @@index([spaceSeq])
  @@map("groups")
}
