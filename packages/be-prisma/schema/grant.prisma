// ============================================================================
// Grant Domain - 권한 부여 도메인
// ============================================================================

// @schema-type: BRIDGE
// @description: Role 또는 User에 Ability를 부여하는 다형성 중간 테이블
// @connects: Role/User ─── Ability (다대다 + 메타데이터)
// @polymorphic: granteeType (Role | User) + granteeId
/// @displayName 권한 부여
model Grant {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 권한 대상 유형
  granteeType String @map("grantee_type")
  /// @displayName 권한 대상 ID
  granteeId   String @map("grantee_id")
  /// @displayName 권한 ID
  abilityId   String @map("ability_id")
  /// @displayName 활성화 여부
  isActive Boolean @default(true) @map("is_active")
  /// @displayName 우선순위
  priority Int     @default(0)
  ability Ability @relation(fields: [abilityId], references: [id])

  @@unique([granteeType, granteeId, abilityId])
  @@index([granteeType, granteeId])
  @@index([abilityId])
  @@index([isActive])
  @@map("grants")
}
