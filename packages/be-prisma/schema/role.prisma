// @data-type: REFERENCE
// @aggregate-root: true
// @description: 권한 체계를 정의하는 핵심 역할 도메인 객체
/// @displayName 역할
model Role {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)

  /// @displayName 역할 식별자
  name        String  @unique
  /// @displayName 표시명
  displayName String? @map("display_name")
  /// @displayName 설명
  description String?
  /// @displayName 시스템 역할 여부
  isSystem    Boolean @default(false) @map("is_system")

  associations                  RoleAssociation[]
  classification                RoleClassification?
  rolePolicies                  RolePolicy[]
  tenants                       Tenant[]
  requestedTenantAccessRequests TenantAccessRequest[] @relation("TenantAccessRequestRequestedRole")
  previousTenantAccessRequests  TenantAccessRequest[] @relation("TenantAccessRequestPreviousRole")

  @@map("roles")
}
