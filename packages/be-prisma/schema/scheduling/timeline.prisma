// ============================================================================
// Timeline Domain - 타임라인/세션 도메인
// ============================================================================

/// @displayName 세션 유형
enum SessionTypes {
  ONE_TIME
  ONE_TIME_RANGE
  RECURRING
}

/// @displayName 반복 주기 유형
enum RepeatCycleTypes {
  WEEKLY
  MONTHLY
}

/// @displayName 반복 요일
enum RecurringDayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// @schema-type: ROOT
// @schema-owner: true
// @aggregate-root: true
// @usecase-anchor: true
// @description: 세션들을 논리적으로 그룹화하는 시간 단위 컨테이너
// @ownership: independent
// @scope: space
// @extended-by: Session
/// @displayName 타임라인
model Timeline {
  id                  String           @id @default(uuid())
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime?        @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt           DateTime?        @map("removed_at") @db.Timestamptz(6)
  tenantId            String           @map("tenant_id")
  creatorId           String?          @map("creator_id")
  name                String
  description         String?
  tenant              Tenant           @relation(fields: [tenantId], references: [id])
  creator             User?            @relation(fields: [creatorId], references: [id])
  sessions            Session[]
  courseOfferings     CourseOffering[]
  assignedEnrollments Enrollment[]
  coursePasses        CoursePass[]
  reservations        Reservation[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([name])
  @@map("timelines")
}

// @schema-type: CHILD
// @description: Timeline에 종속되는 시간 단위 이벤트
// @relation-pattern: one-to-many
// @ownership: dependent
// @scope: space
// @extends: Timeline
// @extended-by: Program
/// @displayName 세션
model Session {
  id                 String              @id @default(uuid())
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime?           @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt          DateTime?           @map("removed_at") @db.Timestamptz(6)
  type               SessionTypes        @default(ONE_TIME)
  repeatCycleType    RepeatCycleTypes?   @map("repeat_cycle_type")
  startDateTime      DateTime?           @map("start_date_time") @db.Timestamptz(6)
  endDateTime        DateTime?           @map("end_date_time") @db.Timestamptz(6)
  recurringDayOfWeek RecurringDayOfWeek? @map("recurring_day_of_week")
  timelineId         String              @map("timeline_id")
  name               String
  description        String?
  programs           Program[]
  timeline           Timeline            @relation(fields: [timelineId], references: [id])
  reservations       Reservation[]

  @@index([timelineId, startDateTime])
  @@index([startDateTime, endDateTime])
  @@index([type, startDateTime])
  @@map("sessions")
}

// @schema-type: JOIN
// @description: Session과 Routine을 연결하고 운영 속성을 보관하는 운영 조인 모델
// @relation-pattern: many-to-many
// @ownership: dependent
// @scope: space
// @join-role: operational-link
// @connects: Session ─── Routine
/// @displayName 프로그램
model Program {
  id                   String            @id @default(uuid())
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?         @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt            DateTime?         @map("removed_at") @db.Timestamptz(6)
  routineId            String            @map("routine_id")
  sessionId            String            @map("session_id")
  instructorId         String            @map("instructor_id")
  capacity             Int
  name                 String
  level                String?
  routineNameSnapshot  String?           @map("routine_name_snapshot")
  routineLabelSnapshot String?           @map("routine_label_snapshot")
  routine              Routine           @relation(fields: [routineId], references: [id])
  session              Session           @relation(fields: [sessionId], references: [id])
  programActivities    ProgramActivity[]
  reservations         Reservation[]

  @@unique([sessionId, routineId])
  @@index([sessionId])
  @@index([routineId])
  @@index([instructorId])
  @@map("programs")
}

// @schema-type: CHILD
// @description: Program 생성 시점의 실행 운동 계획을 보관하는 운영 스냅샷
// @relation-pattern: one-to-many
// @ownership: dependent
// @scope: space
// @extends: Program
/// @displayName 프로그램 활동
model ProgramActivity {
  id                  String    @id @default(uuid())
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt           DateTime? @map("removed_at") @db.Timestamptz(6)
  programId           String    @map("program_id")
  taskId              String    @map("task_id")
  order               Int
  repetitions         Int
  restTime            Int       @map("rest_time")
  notes               String?
  exerciseName        String    @map("exercise_name")
  exerciseDescription String?   @map("exercise_description")
  exerciseDuration    Int       @map("exercise_duration")
  exerciseCount       Int       @map("exercise_count")
  imageFileId         String?   @map("image_file_id")
  videoFileId         String?   @map("video_file_id")
  program             Program   @relation(fields: [programId], references: [id])

  @@unique([programId, taskId])
  @@index([programId, order])
  @@index([taskId])
  @@map("program_activities")
}
