// ============================================================================
// Routine Domain - 루틴/활동 도메인
// ============================================================================

// @schema-type: ROOT
// @schema-owner: true
// @aggregate-root: true
// @usecase-anchor: true
// @description: 반복 수행되는 활동 묶음을 정의하는 루틴
// @ownership: independent
// @scope: space
// @extended-by: Activity, Program
/// @displayName 루틴
model Routine {
  id         String     @id @default(uuid())
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime?  @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt  DateTime?  @map("removed_at") @db.Timestamptz(6)
  tenantId   String     @map("tenant_id")
  creatorId  String?    @map("creator_id")
  name       String
  label      String
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  creator    User?      @relation(fields: [creatorId], references: [id])
  activities Activity[]
  programs   Program[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@map("routines")
}

// @schema-type: JOIN
// @description: Routine과 Task를 연결하고 실행 메타데이터를 보관하는 운영 조인 모델
// @relation-pattern: many-to-many
// @ownership: dependent
// @scope: space
// @join-role: operational-link
// @connects: Routine ─── Task
/// @displayName 활동
model Activity {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  routineId   String    @map("routine_id")
  taskId      String    @map("task_id")
  order       Int
  repetitions Int       @default(1)
  restTime    Int       @default(0) @map("rest_time")
  notes       String?
  routine     Routine   @relation(fields: [routineId], references: [id])
  task        Task      @relation(fields: [taskId], references: [id])

  @@unique([routineId, taskId])
  @@index([routineId, order])
  @@map("activities")
}
