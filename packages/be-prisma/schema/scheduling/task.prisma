// ============================================================================
// Task Domain - 태스크 추상 도메인
// ============================================================================

// @schema-type: BASE
// @schema-owner: true
// @aggregate-root: true
// @usecase-anchor: true
// @description: Exercise 등 1:1 상세 모델의 공통 identity와 소속 관계를 제공하는 작업 기반 모델
// @ownership: independent
// @scope: space
// @materialized-by: Exercise
/// @displayName 태스크
model Task {
  id         String     @id @default(uuid())
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime?  @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt  DateTime?  @map("removed_at") @db.Timestamptz(6)
  tenantId   String     @map("tenant_id")
  creatorId  String?    @map("creator_id")
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  creator    User?      @relation(fields: [creatorId], references: [id])
  activities Activity[]
  exercise   Exercise?

  @@index([tenantId])
  @@map("tasks")
}

// @schema-type: DETAIL
// @description: Task에 종속되는 1:1 운동 상세 모델
// @relation-pattern: one-to-one
// @ownership: dependent
// @scope: space
// @materializes: Task
/// @displayName 운동
model Exercise {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  duration    Int
  count       Int
  taskId      String    @unique @map("task_id")
  description String?
  imageFileId String?   @map("image_file_id")
  videoFileId String?   @map("video_file_id")
  name        String
  task        Task      @relation(fields: [taskId], references: [id])

  @@index([name])
  @@map("exercises")
}
