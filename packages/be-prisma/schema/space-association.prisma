// @data-type: MASTER
// @description: Space와 Group을 연결하는 그룹 링크
/// @displayName 공간 그룹
model SpaceAssociation {
  id        String    @unique @default(ulid()) @map("space_association_id") @db.Char(26)
  seq       BigInt    @id @default(autoincrement()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  spaceSeq  BigInt    @map("space_id")
  groupSeq  BigInt    @map("group_id")
  group     Group     @relation(fields: [groupSeq], references: [seq])
  space     Space     @relation(fields: [spaceSeq], references: [seq])

  @@unique([spaceSeq, groupSeq])
  @@map("space_associations")
}
