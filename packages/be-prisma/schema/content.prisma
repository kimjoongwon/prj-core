// @data-type: MASTER
// @aggregate-root: true
// @description: 사용자 생성 콘텐츠
/// @displayName 콘텐츠
model Content {
  id           String    @unique @default(ulid()) @map("content_id") @db.Char(26)
  seq          BigInt    @id @default(autoincrement()) @map("id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 제목
  title        String?
  /// @displayName 설명
  description  String?
  /// @displayName 유형
  type         TextTypes @default(Editor)
  /// @displayName 본문
  text         String?   @db.VarChar(1000)
  fileId       String?   @map("file_id")
  spaceSeq     BigInt    @map("space_id")
  createdBySeq BigInt?   @map("created_by_id")
  space        Space     @relation(fields: [spaceSeq], references: [seq], onDelete: Restrict)
  createdBy    User?     @relation(fields: [createdBySeq], references: [seq], onDelete: SetNull)
  post         Post?

  @@index([spaceSeq])
  @@map("contents")
}
