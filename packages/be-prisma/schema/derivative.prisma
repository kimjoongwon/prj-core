// @data-type: MASTER
// @description: Asset에 종속되어 파생 리소스를 누적 관리하는 1:N 하위 모델
/// @displayName 파생 리소스
model Derivative {
  id           String         @unique @default(ulid()) @db.VarChar(26)
  seq          Int            @id @default(autoincrement())
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime?      @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt    DateTime?      @map("removed_at") @db.Timestamptz(6)
  /// @displayName 소속 Space
  spaceSeq     Int            @map("space_seq")
  createdBySeq Int?           @map("created_by_seq")
  /// @displayName 원본 Asset 내부 순번
  assetSeq     Int            @map("asset_seq")
  /// @displayName 파생 리소스 종류
  kind         DerivativeKind
  /// @displayName 변환 프로필명
  profile      String         @default("default")
  /// @displayName 스토리지 키
  storageKey   String         @unique @map("storage_key")
  /// @displayName MIME 타입
  mimeType     String         @map("mime_type")
  /// @displayName 파일 크기
  sizeBytes    BigInt         @map("size_bytes")
  /// @displayName 너비 (이미지/비디오)
  width        Int?
  /// @displayName 높이 (이미지/비디오)
  height       Int?
  /// @displayName 재생 시간 (비디오 트랜스코딩)
  durationMs   Int?           @map("duration_ms")
  space        Space          @relation(fields: [spaceSeq], references: [seq], onDelete: Restrict)
  createdBy    User?          @relation(fields: [createdBySeq], references: [seq], onDelete: SetNull)
  asset        Asset          @relation(fields: [assetSeq], references: [seq], onDelete: Cascade)

  @@unique([assetSeq, kind, profile])
  @@index([spaceSeq])
  @@index([assetSeq])
  @@index([kind])
  @@map("derivatives")
}
