// @data-type: MASTER
// @aggregate-root: true
// @description: User + Space + Role을 연결하는 멤버십 모델
/// @displayName 테넌트
model Tenant {
  tenantId  String    @unique @default(ulid()) @map("tenant_id") @db.Char(26)
  id        BigInt    @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  userId    BigInt    @map("user_id")
  spaceId   BigInt    @map("space_id")
  roleId    BigInt    @map("role_id")
  role      Role      @relation(fields: [roleId], references: [id])
  space     Space     @relation(fields: [spaceId], references: [id])
  user      User      @relation("TenantUser", fields: [userId], references: [id])

  accessRequests TenantAccessRequest[]
  currentUsers   User[]                @relation("UserCurrentTenant")

  @@unique([userId, spaceId])
  @@index([spaceId])
  @@index([roleId])
  @@map("tenants")
}
