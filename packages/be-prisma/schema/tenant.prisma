// @data-type: MASTER
// @aggregate-root: true
// @description: User + Space + Role을 연결하는 멤버십 모델
/// @displayName 테넌트
model Tenant {
  id        String    @unique @default(ulid()) @db.VarChar(26)
  seq       Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  userSeq   Int       @map("user_seq")
  spaceSeq  Int       @map("space_seq")
  roleSeq   Int       @map("role_seq")
  role      Role      @relation(fields: [roleSeq], references: [seq])
  space     Space     @relation(fields: [spaceSeq], references: [seq])
  user      User      @relation(fields: [userSeq], references: [seq])

  accessRequests TenantAccessRequest[]

  @@unique([userSeq, spaceSeq])
  @@index([spaceSeq])
  @@index([roleSeq])
  @@map("tenants")
}
