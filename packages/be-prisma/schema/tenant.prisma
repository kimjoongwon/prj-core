// @data-type: MASTER
// @aggregate-root: true
// @description: User + Space + Role을 연결하는 멤버십 모델
/// @displayName 테넌트
model Tenant {
  id        String    @unique @default(ulid()) @map("tenant_id") @db.Char(26)
  seq       BigInt    @id @default(autoincrement()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  userSeq   BigInt    @map("user_id")
  spaceSeq  BigInt    @map("space_id")
  roleSeq   BigInt    @map("role_id")
  role      Role      @relation(fields: [roleSeq], references: [seq])
  space     Space     @relation(fields: [spaceSeq], references: [seq])
  user      User      @relation("TenantUser", fields: [userSeq], references: [seq])

  accessRequests      TenantAccessRequest[]
  currentUserStatuses UserStatus[]          @relation("UserStatusCurrentTenant")

  @@unique([userSeq, spaceSeq])
  @@index([spaceSeq])
  @@index([roleSeq])
  @@map("tenants")
}
