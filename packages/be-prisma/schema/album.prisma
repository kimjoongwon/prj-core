// @data-type: MASTER
// @aggregate-root: true
// @description: 사용자 정의 에셋 컬렉션
/// @displayName 앨범
model Album {
  id            String       @unique @default(ulid()) @db.VarChar(26)
  seq           Int          @id @default(autoincrement())
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime?    @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt     DateTime?    @map("removed_at") @db.Timestamptz(6)
  /// @displayName 소속 Space
  spaceSeq      Int          @map("space_seq")
  /// @displayName 앨범명
  name          String
  /// @displayName 앨범 설명
  description   String?
  /// @displayName 커버 이미지 내부 순번
  coverAssetSeq Int?         @map("cover_asset_seq")
  /// @displayName 정렬 순서
  sortOrder     Int          @default(0) @map("sort_order")
  /// @displayName 생성자
  createdBySeq  Int?         @map("created_by_seq")
  space         Space        @relation(fields: [spaceSeq], references: [seq], onDelete: Restrict)
  coverAsset    Asset?       @relation("AlbumCover", fields: [coverAssetSeq], references: [seq], onDelete: SetNull)
  createdBy     User?        @relation(fields: [createdBySeq], references: [seq], onDelete: SetNull)
  entries       AlbumEntry[]

  @@index([spaceSeq])
  @@index([name])
  @@map("albums")
}
