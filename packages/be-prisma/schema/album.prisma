// ============================================================================
// Album Domain - 앨범 도메인
// ============================================================================

// @schema-type: CONCRETE ENTITY
// @description: 사용자 정의 에셋 컬렉션 (폴더와 분리된 독립적 분류 체계)
/// @displayName 앨범
model Album {
  id           String       @id @default(uuid())
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime?    @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt    DateTime?    @map("removed_at") @db.Timestamptz(6)
  /// @displayName 소속 Space
  spaceId      String       @map("space_id")
  /// @displayName 앨범명
  name         String
  /// @displayName 앨범 설명
  description  String?
  /// @displayName 커버 이미지 ID
  coverAssetId String?      @map("cover_asset_id")
  /// @displayName 정렬 순서
  sortOrder    Int          @default(0) @map("sort_order")
  /// @displayName 생성자
  creatorId    String?      @map("creator_id")
  space        Space        @relation(fields: [spaceId], references: [id])
  coverAsset   Asset?       @relation("AlbumCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  creator      User?        @relation(fields: [creatorId], references: [id])
  entries      AlbumEntry[]

  @@index([spaceId])
  @@index([name])
  @@map("albums")
}

// @schema-type: BRIDGE
// @description: Album과 Asset의 N:M 관계를 관리하는 조인 테이블
// @connects: Album ─── Asset
/// @displayName 앨범 엔트리
model AlbumEntry {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 소속 Space
  spaceId   String    @map("space_id")
  /// @displayName 앨범 ID
  albumId   String    @map("album_id")
  /// @displayName 에셋 ID
  assetId   String    @map("asset_id")
  /// @displayName 앨범 내 순서
  position  Int
  /// @displayName 캡션
  caption   String?
  space     Space     @relation(fields: [spaceId], references: [id])
  album     Album     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([albumId, assetId])
  @@index([spaceId])
  @@index([albumId])
  @@index([assetId])
  @@map("album_entries")
}
