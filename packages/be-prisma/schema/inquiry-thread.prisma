// ============================================================================
// Inquiry Thread Domain - 문의 대화 도메인
// ============================================================================

/// @displayName 문의 참여자 역할
enum InquiryParticipantRole {
  CUSTOMER
  AGENT
  SUPERVISOR
  VIEWER
}

/// @displayName 발신자 유형
enum SenderType {
  USER
  AI
  SYSTEM
}

/// @displayName 스레드 상태
enum ThreadStatus {
  ACTIVE
  RESOLVED
  CLOSED
}

/// @displayName 메시지 콘텐츠 유형
enum MessageContentType {
  TEXT
  HTML
  MARKDOWN
  IMAGE
  FILE
  SYSTEM
}

/// @displayName 첨부파일 유형
enum AttachmentFileType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  ARCHIVE
  OTHER
}

// @schema-type: CONCRETE ENTITY
// @description: 문의 내 대화 스레드 관리
/// @displayName 문의 스레드
model InquiryThread {
  id                  String        @id @default(uuid())
  /// @displayName 생성 일시
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  /// @displayName 수정 일시
  updatedAt           DateTime?     @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// @displayName 종료 일시
  closedAt            DateTime?     @map("closed_at") @db.Timestamptz(6)
  /// @displayName 소속 문의 ID
  inquiryId           String        @map("inquiry_id")
  /// @displayName 제목
  title               String?
  /// @displayName 상태
  status              ThreadStatus  @default(ACTIVE)
  /// @displayName 생성자 ID
  createdBy           String        @map("created_by")
  /// @displayName 마지막 메시지 일시
  lastMessageAt       DateTime?     @map("last_message_at") @db.Timestamptz(6)
  /// @displayName 마지막 메시지 미리보기
  lastMessagePreview  String?       @map("last_message_preview") @db.Char(100)
  /// @displayName 메시지 수
  messageCount        Int           @default(0) @map("message_count")
  inquiry             Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  creator             User          @relation(fields: [createdBy], references: [id])
  messages            InquiryMessage[]
  participants        InquiryParticipant[]

  @@index([inquiryId])
  @@index([status])
  @@map("inquiry_threads")
}

// @schema-type: CONCRETE ENTITY
// @description: 스레드 내 개별 메시지 (실시간 채팅 지원)
/// @displayName 문의 메시지
model InquiryMessage {
  id                String              @id @default(uuid())
  /// @displayName 생성 일시
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  /// @displayName 소속 스레드 ID
  threadId          String              @map("thread_id")
  /// @displayName 소속 문의 ID
  inquiryId         String              @map("inquiry_id")
  /// @displayName 발신자 ID
  senderId          String?             @map("sender_id")
  /// @displayName 발신자 유형
  senderType        SenderType          @default(USER)
  /// @displayName 클라이언트 메시지 ID
  clientMessageId   String?             @map("client_message_id")
  /// @displayName 내용
  content           String              @db.Text
  /// @displayName 콘텐츠 유형
  contentType       MessageContentType  @default(TEXT)
  /// @displayName 전달 완료 시간
  deliveredAt       DateTime?           @map("delivered_at") @db.Timestamptz(6)
  /// @displayName 읽음 확인 시간
  readAt            DateTime?           @map("read_at") @db.Timestamptz(6)
  /// @displayName 수정 일시
  editedAt          DateTime?           @map("edited_at") @db.Timestamptz(6)
  /// @displayName 수정 여부
  isEdited          Boolean             @default(false) @map("is_edited")
  /// @displayName 삭제 여부
  isDeleted         Boolean             @default(false) @map("is_deleted")
  /// @displayName 추가 메타데이터
  metadata          Json?
  thread            InquiryThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  inquiry           Inquiry             @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender            User?               @relation(fields: [senderId], references: [id])
  attachments       InquiryAttachment[]
  sentimentAnalysis SentimentAnalysis?  @relation("SentimentAnalysisMessage")
  aiAgentLog        AIAgentLog?

  @@unique([threadId, clientMessageId])
  @@index([threadId])
  @@index([inquiryId])
  @@index([senderId])
  @@map("inquiry_messages")
}

// @schema-type: CONCRETE ENTITY
// @description: 문의/스레드 참여자의 실시간 상태 관리
/// @displayName 문의 참여자
model InquiryParticipant {
  id          String                 @id @default(uuid())
  /// @displayName 참여 일시
  joinedAt    DateTime               @default(now()) @map("joined_at") @db.Timestamptz(6)
  /// @displayName 나간 일시
  leftAt      DateTime?              @map("left_at") @db.Timestamptz(6)
  /// @displayName 소속 문의 ID
  inquiryId   String                 @map("inquiry_id")
  /// @displayName 소속 스레드 ID
  threadId    String?                @map("thread_id")
  /// @displayName 참여자 ID
  userId      String                 @map("user_id")
  /// @displayName 역할
  role        InquiryParticipantRole @default(VIEWER)
  /// @displayName 온라인 여부
  isOnline    Boolean                @default(false) @map("is_online")
  /// @displayName 타이핑 중 여부
  isTyping    Boolean                @default(false) @map("is_typing")
  /// @displayName 마지막 접속 시간
  lastSeenAt  DateTime?              @map("last_seen_at") @db.Timestamptz(6)
  /// @displayName 마지막 읽은 시간
  lastReadAt  DateTime?              @map("last_read_at") @db.Timestamptz(6)
  /// @displayName 읽지 않은 메시지 수
  unreadCount Int                    @default(0) @map("unread_count")
  inquiry     Inquiry                @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  thread      InquiryThread?         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user        User                   @relation(fields: [userId], references: [id])

  @@unique([inquiryId, threadId, userId])
  @@index([inquiryId])
  @@index([threadId])
  @@index([userId])
  @@map("inquiry_participants")
}

// @schema-type: CONCRETE ENTITY
// @description: 메시지에 첨부된 파일 관리
/// @displayName 문의 첨부파일
model InquiryAttachment {
  id           String             @id @default(uuid())
  /// @displayName 생성 일시
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  /// @displayName 소속 메시지 ID
  messageId    String             @map("message_id")
  /// @displayName 원본 파일명
  fileName     String             @map("file_name")
  /// @displayName 파일 크기
  fileSize     BigInt             @map("file_size")
  /// @displayName MIME 타입
  mimeType     String             @map("mime_type")
  /// @displayName 파일 유형
  fileType     AttachmentFileType @map("file_type")
  /// @displayName 파일 URL
  url          String
  /// @displayName 썸네일 URL
  thumbnailUrl String?            @map("thumbnail_url")
  /// @displayName 너비
  width        Int?
  /// @displayName 높이
  height       Int?
  /// @displayName 재생 시간
  duration     Int?
  /// @displayName 삭제 여부
  isDeleted    Boolean            @default(false) @map("is_deleted")
  message      InquiryMessage     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("inquiry_attachments")
}
