// @data-type: TRANSACTION
// @aggregate-root: true
// @description: 사용자의 프로그램 발생 회차 예약 상태를 관리하는 예약 루트
/// @displayName 예약
model Reservation {
  id                String            @unique @default(ulid()) @db.VarChar(26)
  seq               Int               @id @default(autoincrement())
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime?         @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt         DateTime?         @map("removed_at") @db.Timestamptz(6)
  spaceSeq          Int               @map("space_seq")
  createdBySeq      Int?              @map("created_by_seq")
  userSeq           Int               @map("user_seq")
  timelineSeq       Int               @map("timeline_seq")
  sessionSeq        Int               @map("session_seq")
  programSeq        Int               @map("program_seq")
  occurrenceStartAt DateTime          @map("occurrence_start_at") @db.Timestamptz(6)
  status            ReservationStatus @default(CONFIRMED)
  memo              String?
  idempotencyKey    String            @map("idempotency_key")
  waitlistPosition  Int?              @map("waitlist_position")
  confirmedAt       DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  canceledAt        DateTime?         @map("canceled_at") @db.Timestamptz(6)
  cancelReason      String?           @map("cancel_reason")
  space             Space             @relation(fields: [spaceSeq], references: [seq], onDelete: Restrict)
  createdBy         User?             @relation("ReservationCreatedBy", fields: [createdBySeq], references: [seq], onDelete: SetNull)
  user              User              @relation("ReservationUser", fields: [userSeq], references: [seq])
  timeline          Timeline          @relation(fields: [timelineSeq], references: [seq])
  session           Session           @relation(fields: [sessionSeq], references: [seq])
  program           Program           @relation(fields: [programSeq], references: [seq])

  @@unique([userSeq, idempotencyKey])
  @@index([spaceSeq, occurrenceStartAt])
  @@index([userSeq, occurrenceStartAt])
  @@index([programSeq, occurrenceStartAt, status])
  @@map("reservations")
}
