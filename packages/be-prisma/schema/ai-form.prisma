// ============================================================================
// AI Form Domain - AI 폼 템플릿 도메인
// ============================================================================
//
// AI가 폼 필드를 자동으로 채우기 위한 템플릿 시스템입니다.
// 관리자가 특정 도메인(Member, Inquiry, Role 등)을 대상으로
// AI가 채울 필드와 각 필드별 프롬프트를 설정할 수 있습니다.
//
// 관계 구조:
//   AIFormTemplate (구체 엔티티)
//     │
//     ├─── AIFormField (1:N) - 폼 필드 설정
//     │       │
//     │       └─── AIFormField (자기참조: 그룹 필드)
//     │
//     └─── AITemplateExecution (1:N) - 실행 이력
//
// 외부 관계:
//   AIFormTemplate ─── Space (N:1)
//   AIFormTemplate ─── User (createdBy)
//   AITemplateExecution ─── User (executor)
//   AITemplateExecution ─── Space (N:1)
//
// 무결성 보장:
//   - Prisma 제약: FK onDelete: Cascade (Template -> Fields)
//   - Prisma 제약: FK onDelete: SetNull (Template -> Executions)
//   - Unique: [templateId, fieldName] (동일 템플릿 내 필드명 유니크)
//   - 트랜잭션: Template + Fields 생성/수정 시 단일 트랜잭션 처리
//
// ============================================================================

// ----------------------------------------------------------------------------
// Enums - AI 폼 도메인 열거형
// ----------------------------------------------------------------------------

/// @displayName AI 제공자
enum AIProvider {
  OPENAI     // OpenAI (GPT-4, GPT-3.5 등)
  ANTHROPIC  // Anthropic (Claude 시리즈)
}

/// @displayName AI 템플릿 상태
enum AITemplateStatus {
  DRAFT     // 초안
  ACTIVE    // 활성화
  INACTIVE  // 비활성화
  ARCHIVED  // 보관됨
}

/// @displayName 폼 필드 타입
enum FormFieldType {
  TEXT          // 단행 텍스트
  TEXTAREA      // 여러 줄 텍스트
  NUMBER        // 숫자
  SELECT        // 단일 선택
  MULTI_SELECT  // 다중 선택
  CHECKBOX      // 체크박스
  RADIO         // 라디오 버튼
  DATE          // 날짜
  DATETIME      // 날짜/시간
  EMAIL         // 이메일
  PHONE         // 전화번호
  URL           // URL
}

/// @displayName 실행 상태
enum ExecutionStatus {
  PENDING    // 대기 중
  RUNNING    // 실행 중
  SUCCESS    // 성공
  FAILED     // 실패
  TIMEOUT    // 타임아웃
  CANCELLED  // 취소됨
}

// ----------------------------------------------------------------------------
// Models - AI 폼 도메인 모델
// ----------------------------------------------------------------------------

// @schema-type: CONCRETE ENTITY
// @description: AI가 폼 필드를 자동으로 채우기 위한 템플릿 정의
// @extended-by: AIFormField, AITemplateExecution
/// @displayName AI 폼 템플릿
model AIFormTemplate {
  id                String              @id @default(uuid())
  /// @displayName 생성 일시
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  /// @displayName 수정 일시
  updatedAt         DateTime?           @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// @displayName 삭제 일시
  removedAt         DateTime?           @map("removed_at") @db.Timestamptz(6)

  // 소속
  /// @displayName 소속 공간 ID
  spaceId           String              @map("space_id")

  // 기본 정보
  /// @displayName 템플릿 이름
  name              String
  /// @displayName 템플릿 설명
  description       String?
  /// @displayName 대상 도메인
  targetDomain      String              @map("target_domain")
  /// @displayName 대상 Entity 클래스명
  targetEntity      String              @map("target_entity")

  // AI 설정
  /// @displayName AI 제공자
  aiProvider        AIProvider          @map("ai_provider")
  /// @displayName 사용할 모델
  model             String?
  /// @displayName 시스템 프롬프트
  systemPrompt      String?             @map("system_prompt") @db.Text

  // 상태 및 우선순위
  /// @displayName 템플릿 상태
  status            AITemplateStatus    @default(DRAFT)
  /// @displayName 정렬 우선순위
  priority          Int                 @default(0)

  // 사용자 프롬프트 설정
  /// @displayName 사용자 추가 프롬프트 허용 여부
  allowUserPrompt   Boolean             @default(true) @map("allow_user_prompt")

  // AI 파라미터
  /// @displayName 최대 토큰 수
  maxTokens         Int?                @map("max_tokens")
  /// @displayName 생성 온도
  temperature       Float?              @default(0.7)

  // 메타데이터
  /// @displayName 추가 메타데이터
  metadata          Json?

  // 생성자
  /// @displayName 생성자 ID
  createdById       String              @map("created_by_id")

  // 관계
  space             Space               @relation(fields: [spaceId], references: [id])
  createdBy         User                @relation("AIFormTemplateCreator", fields: [createdById], references: [id])
  fields            AIFormField[]
  executions        AITemplateExecution[]

  @@index([spaceId])
  @@index([targetDomain])
  @@index([status])
  @@index([spaceId, targetDomain])
  @@map("ai_form_templates")
}

// @schema-type: CONCRETE ENTITY
// @description: AI 폼 템플릿에서 AI가 채울 개별 필드의 설정
/// @displayName AI 폼 필드
model AIFormField {
  id                  String        @id @default(uuid())
  /// @displayName 생성 일시
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  /// @displayName 수정 일시
  updatedAt           DateTime?     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 소속
  /// @displayName 소속 템플릿 ID
  templateId          String        @map("template_id")

  // 필드 정보
  /// @displayName 대상 필드명
  fieldName           String        @map("field_name")
  /// @displayName 필드 표시명
  fieldLabel          String?       @map("field_label")
  /// @displayName 필드 타입
  fieldType           FormFieldType @map("field_type")

  // AI 프롬프트
  /// @displayName AI 프롬프트
  prompt              String        @db.Text

  // 필드 설정
  /// @displayName 필수 필드 여부
  isRequired          Boolean       @default(true) @map("is_required")
  /// @displayName 기본값
  defaultValue        String?       @map("default_value")

  // 유효성 검증
  /// @displayName 유효성 검증 정규식
  validationRegex     String?       @map("validation_regex")
  /// @displayName 유효성 검증 실패 메시지
  validationMessage   String?       @map("validation_message")

  // 길이 제한
  /// @displayName 최대 길이
  maxLength           Int?          @map("max_length")

  // 선택 옵션 (SELECT, MULTI_SELECT, RADIO용)
  /// @displayName 선택 옵션
  options             Json?

  // 정렬
  /// @displayName 필드 순서
  order               Int           @default(0)

  // 그룹 (계층 구조)
  /// @displayName 상위 필드 그룹 ID
  groupId             String?       @map("group_id")

  // 메타데이터
  /// @displayName 추가 메타데이터
  metadata            Json?

  // 관계
  template            AIFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  group               AIFormField?  @relation("AIFormFieldGroup", fields: [groupId], references: [id], onDelete: Cascade)
  children            AIFormField[] @relation("AIFormFieldGroup")

  @@unique([templateId, fieldName])
  @@index([templateId])
  @@index([groupId])
  @@map("ai_form_fields")
}

// @schema-type: CONCRETE ENTITY
// @description: AI 폼 템플릿 실행 이력
/// @displayName AI 템플릿 실행
model AITemplateExecution {
  id                String            @id @default(uuid())
  /// @displayName 생성 일시
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  // 소속
  /// @displayName 실행한 템플릿 ID
  templateId        String            @map("template_id")
  /// @displayName 실행한 사용자 ID
  userId            String            @map("user_id")
  /// @displayName 소속 공간 ID
  spaceId           String            @map("space_id")

  // 입력 데이터
  /// @displayName 사용자 입력
  userInput         Json?             @map("user_input")
  /// @displayName 컨텍스트 데이터
  inputContext      Json?             @map("input_context")

  // 결과
  /// @displayName AI 생성 결과
  result            Json
  /// @displayName 실행 상태
  status            ExecutionStatus   @default(PENDING)
  /// @displayName 에러 메시지
  errorMessage      String?           @map("error_message") @db.Text

  // 성능 지표
  /// @displayName 사용된 토큰 수
  tokensUsed        Int?              @map("tokens_used")
  /// @displayName 실행 시간 (ms)
  executionTimeMs   Int?              @map("execution_time_ms")

  // AI 정보
  /// @displayName 사용된 AI 제공자
  aiProvider        AIProvider        @map("ai_provider")
  /// @displayName 사용된 모델
  model             String

  // 결과 적용
  /// @displayName 결과 적용 여부
  isApplied         Boolean           @default(false) @map("is_applied")
  /// @displayName 결과 적용 일시
  appliedAt         DateTime?         @map("applied_at") @db.Timestamptz(6)
  /// @displayName 적용된 대상 Entity ID
  targetEntityId    String?           @map("target_entity_id")

  // 관계
  template          AIFormTemplate    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  user              User              @relation("AITemplateExecutionUser", fields: [userId], references: [id])
  space             Space             @relation(fields: [spaceId], references: [id])

  @@index([templateId])
  @@index([userId])
  @@index([spaceId])
  @@index([status])
  @@index([createdAt])
  @@map("ai_template_executions")
}
