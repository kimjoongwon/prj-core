// @data-type: REFERENCE
// @description: Role과 Category를 연결하는 분류 링크
/// @displayName 역할 분류
model RoleClassification {
  roleClassificationId String    @unique @default(ulid()) @map("role_classification_id") @db.Char(26)
  id                   BigInt    @id @default(autoincrement())
  categoryId           BigInt    @map("category_id")
  roleId               BigInt    @unique @map("role_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt            DateTime? @map("removed_at") @db.Timestamptz(6)
  category             Category  @relation(fields: [categoryId], references: [id])
  role                 Role      @relation(fields: [roleId], references: [id])

  @@unique([categoryId, roleId])
  @@map("role_classifications")
}
