// @data-type: REFERENCE
// @description: Role과 Category를 연결하는 분류 링크
/// @displayName 역할 분류
model RoleClassification {
  id          String    @unique @default(ulid()) @map("role_classification_id") @db.Char(26)
  seq         BigInt    @id @default(autoincrement()) @map("id")
  categorySeq BigInt    @map("category_id")
  roleSeq     BigInt    @unique @map("role_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  category    Category  @relation(fields: [categorySeq], references: [seq])
  role        Role      @relation(fields: [roleSeq], references: [seq])

  @@unique([categorySeq, roleSeq])
  @@map("role_classifications")
}
