// @data-type: REFERENCE
// @description: Role과 Category를 연결하는 분류 링크
/// @displayName 역할 분류
model RoleClassification {
  id          String    @unique @default(ulid()) @db.VarChar(26)
  seq         Int       @id @default(autoincrement())
  categorySeq Int       @map("category_seq")
  roleSeq     Int       @unique @map("role_seq")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  category    Category  @relation(fields: [categorySeq], references: [seq])
  role        Role      @relation(fields: [roleSeq], references: [seq])

  @@unique([categorySeq, roleSeq])
  @@map("role_classifications")
}
