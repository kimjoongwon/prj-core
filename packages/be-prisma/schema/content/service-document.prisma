// ============================================================================
// Service Document Domain - 서비스 약관/동의 문서 도메인
// ============================================================================
//
// 모바일과 web 서비스에서 노출하는 약관, 개인정보처리방침, 마케팅 동의 등의
// 버전별 문서를 관리합니다.
//
// 관계 구조:
//   ServiceDocument (ROOT)
//
// ============================================================================

/// @displayName 서비스 문서 종류
enum ServiceDocumentKind {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING_CONSENT
  LOCATION_CONSENT
  THIRD_PARTY_SHARING
}

/// @displayName 서비스 문서 노출 플랫폼
enum ServiceDocumentPlatform {
  ALL
  WEB
  MOBILE
}

/// @displayName 서비스 문서 상태
enum ServiceDocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// @displayName 서비스 문서 본문 형식
enum ServiceDocumentFormat {
  MARKDOWN
  HTML
  PLAIN_TEXT
}

// @schema-type: ROOT
// @schema-owner: true
// @aggregate-root: true
// @description: 서비스에서 사용자에게 노출하는 약관/동의 문서의 버전 단위 관리 객체
// @ownership: independent
// @scope: global
/// @displayName 서비스 문서
model ServiceDocument {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)

  /// @displayName 문서 종류
  kind         ServiceDocumentKind
  /// @displayName 노출 플랫폼
  platform     ServiceDocumentPlatform @default(ALL)
  /// @displayName 로케일
  locale       String                  @default("ko-KR")
  /// @displayName 제목
  title        String
  /// @displayName 요약
  summary      String?
  /// @displayName 본문
  content      String                  @db.Text
  /// @displayName 본문 형식
  format       ServiceDocumentFormat   @default(MARKDOWN)
  /// @displayName 버전
  version      String
  /// @displayName 상태
  status       ServiceDocumentStatus   @default(DRAFT)
  /// @displayName 필수 동의 여부
  isRequired   Boolean                 @default(true) @map("is_required")
  /// @displayName 정렬 순서
  displayOrder Int                     @default(0) @map("display_order")
  /// @displayName 효력 시작 시각
  effectiveAt  DateTime?               @map("effective_at") @db.Timestamptz(6)
  /// @displayName 게시 시각
  publishedAt  DateTime?               @map("published_at") @db.Timestamptz(6)

  @@unique([kind, platform, locale, version])
  @@index([kind, platform, locale, status])
  @@index([status])
  @@index([publishedAt])
  @@map("service_documents")
}
