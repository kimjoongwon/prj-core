// ============================================================================
// Group Domain - 그룹 도메인
// ============================================================================

/// @displayName 그룹 유형
enum GroupTypes {
  Role
  Space
  Asset
  User
}

// @schema-type: ROOT
// @schema-owner: true
// @aggregate-root: true
// @description: 사용자·공간·역할을 묶는 그룹 루트
// @ownership: independent
// @scope: space
/// @displayName 그룹
model Group {
  id                String             @id @default(uuid())
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime?          @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt         DateTime?          @map("removed_at") @db.Timestamptz(6)
  /// @displayName 이름
  name              String
  /// @displayName 유형
  type              GroupTypes         @default(User)
  /// @displayName 라벨
  label             String?
  spaceId           String             @map("space_id")
  creatorId         String?            @map("creator_id")
  space             Space              @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  creator           User?              @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  roleAssociations  RoleAssociation[]
  spaceAssociations SpaceAssociation[]
  userAssociations  UserAssociation[]

  @@index([spaceId])
  @@map("groups")
}
