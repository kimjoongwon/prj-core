// @data-type: CONFIGURATION
// @aggregate-root: true
// @description: 반복 수행되는 활동 묶음을 정의하는 루틴
/// @displayName 루틴
model Routine {
  id           String     @unique @default(ulid()) @map("routine_id") @db.Char(26)
  seq          BigInt     @id @default(autoincrement()) @map("id")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime?  @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt    DateTime?  @map("removed_at") @db.Timestamptz(6)
  spaceSeq     BigInt     @map("space_id")
  createdBySeq BigInt?    @map("created_by_id")
  name         String
  label        String
  space        Space      @relation(fields: [spaceSeq], references: [seq], onDelete: Restrict)
  createdBy    User?      @relation(fields: [createdBySeq], references: [seq], onDelete: SetNull)
  activities   Activity[]
  programs     Program[]

  @@index([spaceSeq])
  @@index([spaceSeq, name])
  @@map("routines")
}
