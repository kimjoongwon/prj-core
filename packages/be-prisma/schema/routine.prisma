// @data-type: CONFIGURATION
// @aggregate-root: true
// @description: 반복 수행되는 활동 묶음을 정의하는 루틴
/// @displayName 루틴
model Routine {
  routineId   String     @unique @default(ulid()) @map("routine_id") @db.Char(26)
  id          BigInt     @id @default(autoincrement())
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?  @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime?  @map("removed_at") @db.Timestamptz(6)
  spaceId     BigInt     @map("space_id")
  createdById BigInt?    @map("created_by_id")
  name        String
  label       String
  space       Space      @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  activities  Activity[]
  programs    Program[]

  @@index([spaceId])
  @@index([spaceId, name])
  @@map("routines")
}
