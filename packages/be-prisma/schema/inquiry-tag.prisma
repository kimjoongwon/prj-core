// @data-type: TRANSACTION
// @description: Inquiry에 종속되는 태그 컬렉션
/// @displayName 문의 태그
model InquiryTag {
  id         String    @unique @default(ulid()) @db.VarChar(26)
  seq        Int       @id @default(autoincrement())
  /// @displayName 생성 일시
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// @displayName 수정 일시
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// @displayName 삭제 일시
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 소속 문의 내부 순번
  inquirySeq Int       @map("inquiry_seq")
  /// @displayName 태그명
  name       String
  /// @displayName 색상
  color      String?
  inquiry    Inquiry   @relation(fields: [inquirySeq], references: [seq], onDelete: Cascade)

  @@unique([inquirySeq, name])
  @@index([inquirySeq])
  @@map("inquiry_tags")
}
