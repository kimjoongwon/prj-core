// @data-type: CONFIGURATION
// @description: Role에 Policy를 할당하고 활성 상태와 우선순위를 관리
/// @displayName 역할의 정책 할당
model RoleAssignment {
  id        String    @unique @default(ulid()) @map("role_assignment_id") @db.Char(26)
  seq       BigInt    @id @default(autoincrement()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)

  /// @displayName 역할 내부 순번
  roleSeq   BigInt  @map("role_id")
  /// @displayName 정책 내부 순번
  policySeq BigInt  @map("policy_id")
  /// @displayName 활성화 여부
  isActive  Boolean @default(true) @map("is_active")
  /// @displayName 우선순위
  priority  Int     @default(0)

  role   Role   @relation(fields: [roleSeq], references: [seq])
  policy Policy @relation(fields: [policySeq], references: [seq])

  @@unique([roleSeq, policySeq])
  @@index([roleSeq])
  @@index([policySeq])
  @@index([isActive])
  @@map("role_assignments")
}
