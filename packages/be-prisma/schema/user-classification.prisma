// @data-type: MASTER
// @description: User와 Category를 연결하는 분류 링크
/// @displayName 사용자 분류
model UserClassification {
  id          String    @unique @default(ulid()) @db.VarChar(26)
  seq         Int       @id @default(autoincrement())
  categorySeq Int       @map("category_seq")
  userSeq     Int       @unique @map("user_seq")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  category    Category  @relation(fields: [categorySeq], references: [seq])
  user        User      @relation(fields: [userSeq], references: [seq])

  @@unique([categorySeq, userSeq])
  @@map("user_classifications")
}
