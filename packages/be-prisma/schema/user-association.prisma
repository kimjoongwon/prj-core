// @data-type: MASTER
// @description: User와 Group을 연결하는 그룹 링크
/// @displayName 사용자 그룹
model UserAssociation {
  userAssociationId String    @unique @default(ulid()) @map("user_association_id") @db.Char(26)
  id                BigInt    @id @default(autoincrement())
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt         DateTime? @map("removed_at") @db.Timestamptz(6)
  userId            BigInt    @map("user_id")
  groupId           BigInt    @map("group_id")
  group             Group     @relation(fields: [groupId], references: [id])
  user              User      @relation(fields: [userId], references: [id])

  @@map("user_associations")
}
