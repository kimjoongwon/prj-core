// @data-type: MASTER
// @description: User와 Group을 연결하는 그룹 링크
/// @displayName 사용자 그룹
model UserAssociation {
  id        String    @unique @default(ulid()) @map("user_association_id") @db.Char(26)
  seq       BigInt    @id @default(autoincrement()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  userSeq   BigInt    @map("user_id")
  groupSeq  BigInt    @map("group_id")
  group     Group     @relation(fields: [groupSeq], references: [seq])
  user      User      @relation(fields: [userSeq], references: [seq])

  @@map("user_associations")
}
