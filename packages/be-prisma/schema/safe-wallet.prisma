// @data-type: MASTER
// @aggregate-root: true
// @description: Space 단위로 운영되는 Safe 멀티시그 지갑
/// @displayName Safe 지갑
model SafeWallet {
  id           String            @unique @default(ulid()) @db.VarChar(26)
  seq          Int               @id @default(autoincrement())
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime?         @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt    DateTime?         @map("removed_at") @db.Timestamptz(6)
  address      String            @unique
  chainId      Int               @map("chain_id")
  threshold    Int               @default(3)
  nonce        Int               @default(0)
  owners       String[] // 소유자 주소 배열
  spaceSeq     Int               @map("space_seq")
  createdBySeq Int?              @map("created_by_seq")
  space        Space             @relation(fields: [spaceSeq], references: [seq], onDelete: Restrict)
  createdBy    User?             @relation(fields: [createdBySeq], references: [seq], onDelete: SetNull)
  transactions SafeTransaction[]

  @@index([spaceSeq])
  @@map("safe_wallets")
}
