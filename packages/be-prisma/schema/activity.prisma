// @data-type: CONFIGURATION
// @description: Routine과 Task를 연결하고 실행 메타데이터를 보관하는 운영 조인 모델
/// @displayName 활동
model Activity {
  id          String    @unique @default(ulid()) @map("activity_id") @db.Char(26)
  seq         BigInt    @id @default(autoincrement()) @map("id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  routineSeq  BigInt    @map("routine_id")
  taskSeq     BigInt    @map("task_id")
  order       Int
  repetitions Int       @default(1)
  restTime    Int       @default(0) @map("rest_time")
  notes       String?
  routine     Routine   @relation(fields: [routineSeq], references: [seq])
  task        Task      @relation(fields: [taskSeq], references: [seq])

  @@unique([routineSeq, taskSeq])
  @@index([routineSeq, order])
  @@map("activities")
}
