// @data-type: CONFIGURATION
// @description: Session과 Routine을 연결하고 운영 속성을 보관하는 운영 조인 모델
/// @displayName 프로그램
model Program {
  id                   String            @unique @default(ulid()) @map("program_id") @db.Char(26)
  seq                  BigInt            @id @default(autoincrement()) @map("id")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?         @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt            DateTime?         @map("removed_at") @db.Timestamptz(6)
  routineSeq           BigInt            @map("routine_id")
  sessionSeq           BigInt            @map("session_id")
  instructorSeq        BigInt            @map("instructor_id")
  capacity             Int
  name                 String
  level                String?
  routineNameSnapshot  String?           @map("routine_name_snapshot")
  routineLabelSnapshot String?           @map("routine_label_snapshot")
  routine              Routine           @relation(fields: [routineSeq], references: [seq])
  session              Session           @relation(fields: [sessionSeq], references: [seq])
  instructor           User              @relation("ProgramInstructor", fields: [instructorSeq], references: [seq])
  programActivities    ProgramActivity[]
  reservations         Reservation[]

  @@unique([sessionSeq, routineSeq])
  @@index([sessionSeq])
  @@index([routineSeq])
  @@index([instructorSeq])
  @@map("programs")
}
