// @data-type: CONFIGURATION
// @description: Session과 Routine을 연결하고 운영 속성을 보관하는 운영 조인 모델
/// @displayName 프로그램
model Program {
  programId            String            @unique @default(ulid()) @map("program_id") @db.Char(26)
  id                   BigInt            @id @default(autoincrement())
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?         @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt            DateTime?         @map("removed_at") @db.Timestamptz(6)
  routineId            BigInt            @map("routine_id")
  sessionId            BigInt            @map("session_id")
  instructorId         BigInt            @map("instructor_id")
  capacity             Int
  name                 String
  level                String?
  routineNameSnapshot  String?           @map("routine_name_snapshot")
  routineLabelSnapshot String?           @map("routine_label_snapshot")
  routine              Routine           @relation(fields: [routineId], references: [id])
  session              Session           @relation(fields: [sessionId], references: [id])
  instructor           User              @relation("ProgramInstructor", fields: [instructorId], references: [id])
  programActivities    ProgramActivity[]
  reservations         Reservation[]

  @@unique([sessionId, routineId])
  @@index([sessionId])
  @@index([routineId])
  @@index([instructorId])
  @@map("programs")
}
