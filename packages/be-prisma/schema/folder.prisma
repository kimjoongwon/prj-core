// @data-type: MASTER
// @aggregate-root: true
// @description: 에셋 저장 구조를 독립 관리하는 Space 범위 폴더 루트
/// @displayName 폴더
model Folder {
  folderId       String    @unique @default(ulid()) @map("folder_id") @db.Char(26)
  id             BigInt    @id @default(autoincrement())
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt      DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 소속 Space
  spaceId        BigInt    @map("space_id")
  /// @displayName 상위 폴더 내부 순번
  parentFolderId BigInt?   @map("parent_folder_id")
  /// @displayName 폴더명
  name           String
  /// @displayName 전체 경로
  path           String    @unique
  /// @displayName 정렬 순서
  sortOrder      Int       @default(0) @map("sort_order")
  /// @displayName 생성자
  createdById    BigInt?   @map("created_by_id")
  space          Space     @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  parent         Folder?   @relation("FolderParent", fields: [parentFolderId], references: [id])
  children       Folder[]  @relation("FolderParent")
  createdBy      User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assets         Asset[]

  @@index([spaceId])
  @@index([parentFolderId])
  @@index([path])
  @@map("folders")
}
