// @data-type: MASTER
// @aggregate-root: true
// @description: 에셋 저장 구조를 독립 관리하는 Space 범위 폴더 루트
/// @displayName 폴더
model Folder {
  id              String    @unique @default(ulid()) @db.VarChar(26)
  seq             Int       @id @default(autoincrement())
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt       DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 소속 Space
  spaceSeq        Int       @map("space_seq")
  /// @displayName 상위 폴더 내부 순번
  parentFolderSeq Int?      @map("parent_folder_seq")
  /// @displayName 폴더명
  name            String
  /// @displayName 전체 경로
  path            String    @unique
  /// @displayName 정렬 순서
  sortOrder       Int       @default(0) @map("sort_order")
  /// @displayName 생성자
  createdBySeq    Int?      @map("created_by_seq")
  space           Space     @relation(fields: [spaceSeq], references: [seq], onDelete: Restrict)
  parent          Folder?   @relation("FolderParent", fields: [parentFolderSeq], references: [seq])
  children        Folder[]  @relation("FolderParent")
  createdBy       User?     @relation(fields: [createdBySeq], references: [seq], onDelete: SetNull)
  assets          Asset[]

  @@index([spaceSeq])
  @@index([parentFolderSeq])
  @@index([path])
  @@map("folders")
}
