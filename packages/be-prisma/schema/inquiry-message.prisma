// @data-type: TRANSACTION
// @description: InquiryThread에 종속되는 개별 메시지
/// @displayName 문의 메시지
model InquiryMessage {
  id                String              @unique @default(ulid()) @map("inquiry_message_id") @db.Char(26)
  seq               BigInt              @id @default(autoincrement()) @map("id")
  /// @displayName 생성 일시
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  /// @displayName 소속 스레드 내부 순번
  threadSeq         BigInt              @map("thread_id")
  /// @displayName 소속 문의 내부 순번
  inquirySeq        BigInt              @map("inquiry_id")
  /// @displayName 발신자 내부 순번
  senderSeq         BigInt?             @map("sender_id")
  /// @displayName 발신자 유형
  senderType        SenderType          @default(USER)
  /// @displayName 클라이언트 메시지 ID
  clientMessageId   String?             @map("client_message_id")
  /// @displayName 내용
  content           String              @db.Text
  /// @displayName 콘텐츠 유형
  contentType       MessageContentType  @default(TEXT)
  /// @displayName 전달 완료 시간
  deliveredAt       DateTime?           @map("delivered_at") @db.Timestamptz(6)
  /// @displayName 읽음 확인 시간
  readAt            DateTime?           @map("read_at") @db.Timestamptz(6)
  /// @displayName 수정 일시
  editedAt          DateTime?           @map("edited_at") @db.Timestamptz(6)
  /// @displayName 수정 여부
  isEdited          Boolean             @default(false) @map("is_edited")
  /// @displayName 삭제 여부
  isDeleted         Boolean             @default(false) @map("is_deleted")
  /// @displayName 추가 메타데이터
  metadata          Json?
  thread            InquiryThread       @relation(fields: [threadSeq], references: [seq], onDelete: Cascade)
  inquiry           Inquiry             @relation(fields: [inquirySeq], references: [seq], onDelete: Cascade)
  sender            User?               @relation(fields: [senderSeq], references: [seq])
  attachments       InquiryAttachment[]
  sentimentAnalysis SentimentAnalysis?  @relation("SentimentAnalysisMessage")
  aiAgentLog        AIAgentLog?

  @@unique([threadSeq, clientMessageId])
  @@index([threadSeq])
  @@index([inquirySeq])
  @@index([senderSeq])
  @@map("inquiry_messages")
}
