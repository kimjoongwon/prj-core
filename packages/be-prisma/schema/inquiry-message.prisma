// @data-type: TRANSACTION
// @description: InquiryThread에 종속되는 개별 메시지
/// @displayName 문의 메시지
model InquiryMessage {
  id                String              @id @default(uuid())
  /// @displayName 생성 일시
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  /// @displayName 소속 스레드 ID
  threadId          String              @map("thread_id")
  /// @displayName 소속 문의 ID
  inquiryId         String              @map("inquiry_id")
  /// @displayName 발신자 ID
  senderId          String?             @map("sender_id")
  /// @displayName 발신자 유형
  senderType        SenderType          @default(USER)
  /// @displayName 클라이언트 메시지 ID
  clientMessageId   String?             @map("client_message_id")
  /// @displayName 내용
  content           String              @db.Text
  /// @displayName 콘텐츠 유형
  contentType       MessageContentType  @default(TEXT)
  /// @displayName 전달 완료 시간
  deliveredAt       DateTime?           @map("delivered_at") @db.Timestamptz(6)
  /// @displayName 읽음 확인 시간
  readAt            DateTime?           @map("read_at") @db.Timestamptz(6)
  /// @displayName 수정 일시
  editedAt          DateTime?           @map("edited_at") @db.Timestamptz(6)
  /// @displayName 수정 여부
  isEdited          Boolean             @default(false) @map("is_edited")
  /// @displayName 삭제 여부
  isDeleted         Boolean             @default(false) @map("is_deleted")
  /// @displayName 추가 메타데이터
  metadata          Json?
  thread            InquiryThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  inquiry           Inquiry             @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender            User?               @relation(fields: [senderId], references: [id])
  attachments       InquiryAttachment[]
  sentimentAnalysis SentimentAnalysis?  @relation("SentimentAnalysisMessage")
  aiAgentLog        AIAgentLog?

  @@unique([threadId, clientMessageId])
  @@index([threadId])
  @@index([inquiryId])
  @@index([senderId])
  @@map("inquiry_messages")
}
