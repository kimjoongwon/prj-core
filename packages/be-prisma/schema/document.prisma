// @data-type: MASTER
// @description: Asset(kind=DOCUMENT)에 종속되는 문서 1:1 상세 정보
/// @displayName 문서 상세
model Document {
  documentId String    @unique @default(ulid()) @map("document_id") @db.Char(26)
  id         BigInt    @id @default(autoincrement())
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 페이지 수
  pageCount  Int?      @map("page_count")
  /// @displayName 단어 수
  wordCount  Int?      @map("word_count")
  /// @displayName 작성자
  author     String?
  /// @displayName 제목
  title      String?
  /// @displayName 주제
  subject    String?
  /// @displayName 키워드
  keywords   String?
  /// @displayName 원본 Asset 내부 순번
  assetId    BigInt    @unique @map("asset_id")
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("documents")
}
