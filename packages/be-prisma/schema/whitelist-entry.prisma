// ============================================================================
// Whitelist Entry Domain - 화이트리스트 도메인
// ============================================================================

/// @displayName 화이트리스트 유형
enum WhitelistType {
  IP
  EMAIL_DOMAIN
  CORS_ORIGIN
}

// @schema-type: REFERENCE
// @description: 화이트리스트 항목
/// @displayName 화이트리스트 항목
model WhitelistEntry {
  id          String        @id @default(uuid())
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?     @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// @displayName 유형
  type        WhitelistType
  /// @displayName 값
  value       String
  /// @displayName 설명
  description String?
  /// @displayName 활성 여부
  isActive    Boolean       @default(true) @map("is_active")

  @@unique([type, value])
  @@index([type])
  @@map("whitelist_entries")
}
