// ============================================================================
// Inquiry AI Domain - 문의 AI 도메인
// ============================================================================

/// @displayName 감정 유형
enum SentimentType {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

/// @displayName AI 작업 유형
enum AIAgentAction {
  DRAFT_GENERATION
  AUTO_CLASSIFICATION
  SENTIMENT_ANALYSIS
  AUTO_RESPONSE
  KNOWLEDGE_SEARCH
  SUMMARIZATION
  TRANSLATION
}

// @schema-type: MATERIALIZATION
// @description: 문의 감정 분석 결과 (AI 기반)
// @materializes: Inquiry (1:1)
/// @displayName 감정 분석
model SentimentAnalysis {
  id          String          @id @default(uuid())
  /// @displayName 생성 일시
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  /// @displayName 수정 일시
  updatedAt   DateTime?       @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// @displayName 소속 문의 ID
  inquiryId   String          @unique @map("inquiry_id")
  /// @displayName 분석 대상 메시지 ID
  messageId   String?         @unique @map("message_id")
  /// @displayName 감정 유형
  sentiment   SentimentType
  /// @displayName 감정 점수
  score       Float
  /// @displayName 분석 신뢰도
  confidence  Float
  /// @displayName 세부 감정
  emotions    Json?
  /// @displayName 주요 키워드
  keywords    Json?
  /// @displayName 긴급도 점수
  urgency     Float?
  /// @displayName 분석 일시
  analyzedAt  DateTime        @default(now()) @map("analyzed_at") @db.Timestamptz(6)
  inquiry     Inquiry         @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  message     InquiryMessage? @relation("SentimentAnalysisMessage", fields: [messageId], references: [id], onDelete: SetNull)

  @@index([inquiryId])
  @@map("sentiment_analyses")
}

// @schema-type: CONCRETE ENTITY
// @description: AI 에이전트 활동 로그 (감사용)
/// @displayName AI 에이전트 로그
model AIAgentLog {
  id             String          @id @default(uuid())
  /// @displayName 생성 일시
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  /// @displayName 소속 문의 ID
  inquiryId      String          @map("inquiry_id")
  /// @displayName 관련 메시지 ID
  messageId      String?         @unique @map("message_id")
  /// @displayName AI 작업 유형
  action         AIAgentAction
  /// @displayName 입력 데이터
  input          Json?
  /// @displayName 출력 결과
  output         Json?
  /// @displayName AI 신뢰도
  confidence     Float?
  /// @displayName 사용자 수락 여부
  wasAccepted    Boolean?
  /// @displayName 사용자 수정 여부
  wasModified    Boolean?
  /// @displayName 응답 시간 (ms)
  responseTimeMs Int?            @map("response_time_ms")
  /// @displayName 사용된 AI 모델
  model          String?
  /// @displayName 사용된 토큰 수
  tokenCount     Int?            @map("token_count")
  /// @displayName 에러 메시지
  errorMessage   String?         @map("error_message")
  inquiry        Inquiry         @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  message        InquiryMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([inquiryId])
  @@index([action])
  @@map("ai_agent_logs")
}
