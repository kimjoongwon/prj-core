// ============================================================================
// Subject Domain - 권한 대상 도메인
// ============================================================================

// @schema-type: REFERENCE
// @description: CASL Subject 정의 (Prisma 모델 기반 + 커스텀 Subject)
// @note: DMMF에서 자동 동기화되며, 커스텀 Subject도 추가 가능
/// @displayName Subject
model Subject {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)

  /// @displayName 이름
  name        String  @unique
  /// @displayName 표시명
  displayName String? @map("display_name")
  /// @displayName 아이콘
  icon        String?
  /// @displayName 정렬 순서
  order       Int     @default(0)
  /// @displayName 시스템 여부
  isSystem    Boolean @default(true) @map("is_system")
  /// @displayName 그룹
  group       String?

  abilities Ability[]

  @@index([group])
  @@index([isSystem])
  @@map("subjects")
}
