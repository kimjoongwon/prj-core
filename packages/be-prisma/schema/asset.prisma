// @data-type: MASTER
// @aggregate-root: true
// @description: 미디어 리소스의 공통 identity와 메타데이터를 제공하는 CTI 부모 테이블
/// @displayName 에셋
model Asset {
  id            String       @unique @default(ulid()) @db.VarChar(26)
  seq           Int          @id @default(autoincrement())
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime?    @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt     DateTime?    @map("removed_at") @db.Timestamptz(6)
  /// @displayName 소속 Space
  spaceSeq      Int          @map("space_seq")
  /// @displayName 소속 폴더
  folderSeq     Int          @map("folder_seq")
  /// @displayName 에셋 타입
  kind          AssetKind
  /// @displayName 업로드 상태
  status        AssetStatus  @default(UPLOADING)
  /// @displayName 원본 파일명
  originalName  String       @map("original_name")
  /// @displayName 스토리지 키
  storageKey    String       @unique @map("storage_key")
  /// @displayName MIME 타입
  mimeType      String       @map("mime_type")
  /// @displayName 파일 확장자
  extension     String?
  /// @displayName 파일 크기
  sizeBytes     BigInt       @map("size_bytes")
  /// @displayName 파일 체크섬
  checksum      String?
  /// @displayName 추가 메타데이터
  metadata      Json?
  /// @displayName 생성자
  createdBySeq  Int?         @map("created_by_seq")
  space         Space        @relation(fields: [spaceSeq], references: [seq], onDelete: Restrict)
  folder        Folder       @relation(fields: [folderSeq], references: [seq])
  createdBy     User?        @relation(fields: [createdBySeq], references: [seq], onDelete: SetNull)
  image         Image?
  video         Video?
  document      Document?
  derivatives   Derivative[]
  albumEntries  AlbumEntry[]
  coverOfAlbums Album[]      @relation("AlbumCover")

  @@index([spaceSeq])
  @@index([folderSeq])
  @@index([kind])
  @@index([status])
  @@map("assets")
}
