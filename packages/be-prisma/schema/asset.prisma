// @data-type: MASTER
// @aggregate-root: true
// @description: 미디어 리소스의 공통 identity와 메타데이터를 제공하는 CTI 부모 테이블
/// @displayName 에셋
model Asset {
  assetId       String       @unique @default(ulid()) @map("asset_id") @db.Char(26)
  id            BigInt       @id @default(autoincrement())
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime?    @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt     DateTime?    @map("removed_at") @db.Timestamptz(6)
  /// @displayName 소속 Space
  spaceId       BigInt       @map("space_id")
  /// @displayName 소속 폴더
  folderId      BigInt       @map("folder_id")
  /// @displayName 에셋 타입
  kind          AssetKind
  /// @displayName 업로드 상태
  status        AssetStatus  @default(UPLOADING)
  /// @displayName 원본 파일명
  originalName  String       @map("original_name")
  /// @displayName 스토리지 키
  storageKey    String       @unique @map("storage_key")
  /// @displayName MIME 타입
  mimeType      String       @map("mime_type")
  /// @displayName 파일 확장자
  extension     String?
  /// @displayName 파일 크기
  sizeBytes     BigInt       @map("size_bytes")
  /// @displayName 파일 체크섬
  checksum      String?
  /// @displayName 추가 메타데이터
  metadata      Json?
  /// @displayName 생성자
  createdById   BigInt?      @map("created_by_id")
  space         Space        @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  folder        Folder       @relation(fields: [folderId], references: [id])
  createdBy     User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  image         Image?
  video         Video?
  document      Document?
  derivatives   Derivative[]
  albumEntries  AlbumEntry[]
  coverOfAlbums Album[]      @relation("AlbumCover")

  @@index([spaceId])
  @@index([folderId])
  @@index([kind])
  @@index([status])
  @@map("assets")
}
