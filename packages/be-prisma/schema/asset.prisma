// ============================================================================
// Asset Domain - 에셋 코어 도메인
// ============================================================================

/// @displayName 에셋 타입
enum AssetKind {
  IMAGE
  VIDEO
  DOCUMENT
}

/// @displayName 에셋 상태
enum AssetStatus {
  UPLOADING
  READY
  FAILED
}

/// @displayName 파생 리소스 타입
enum DerivativeKind {
  THUMBNAIL
  PREVIEW
  TRANSCODE
  TEXT
}

// @schema-type: CONCRETE ENTITY
// @description: 미디어 리소스의 공통 메타데이터를 관리하는 CTI 부모 테이블
// @extended-by: Image, Video, Document (1:0..1 CTI 상세)
/// @displayName 에셋
model Asset {
  id            String       @id @default(uuid())
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime?    @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt     DateTime?    @map("removed_at") @db.Timestamptz(6)
  /// @displayName 소속 Space
  spaceId       String       @map("space_id")
  /// @displayName 소속 폴더
  folderId      String       @map("folder_id")
  /// @displayName 에셋 타입
  kind          AssetKind
  /// @displayName 업로드 상태
  status        AssetStatus  @default(UPLOADING)
  /// @displayName 원본 파일명
  originalName  String       @map("original_name")
  /// @displayName 스토리지 키
  storageKey    String       @unique @map("storage_key")
  /// @displayName MIME 타입
  mimeType      String       @map("mime_type")
  /// @displayName 파일 확장자
  extension     String?
  /// @displayName 파일 크기
  sizeBytes     BigInt       @map("size_bytes")
  /// @displayName 파일 체크섬
  checksum      String?
  /// @displayName 추가 메타데이터
  metadata      Json?
  /// @displayName 생성자
  creatorId     String?      @map("creator_id")
  space         Space        @relation(fields: [spaceId], references: [id])
  folder        Folder       @relation(fields: [folderId], references: [id])
  creator       User?        @relation(fields: [creatorId], references: [id])
  image         Image?
  video         Video?
  document      Document?
  derivatives   Derivative[]
  albumEntries  AlbumEntry[]
  coverOfAlbums Album[]      @relation("AlbumCover")

  @@index([spaceId])
  @@index([folderId])
  @@index([kind])
  @@index([status])
  @@map("assets")
}

// @schema-type: MATERIALIZATION
// @description: Asset(kind=IMAGE)의 이미지 전용 상세 정보 (CTI 1:1)
// @materializes: Asset (IMAGE 타입)
/// @displayName 이미지 상세
model Image {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 너비 (px)
  width       Int
  /// @displayName 높이 (px)
  height      Int
  /// @displayName 방향 (EXIF Orientation)
  orientation Int?
  /// @displayName 색상 공간
  colorSpace  String?   @map("color_space")
  /// @displayName 알파 채널 여부
  hasAlpha    Boolean   @default(false) @map("has_alpha")
  /// @displayName 원본 Asset ID
  assetId     String    @unique @map("asset_id")
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("images")
}

// @schema-type: MATERIALIZATION
// @description: Asset(kind=VIDEO)의 비디오 전용 상세 정보 (CTI 1:1)
// @materializes: Asset (VIDEO 타입)
/// @displayName 비디오 상세
model Video {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 너비 (px)
  width      Int
  /// @displayName 높이 (px)
  height     Int
  /// @displayName 재생 시간 (ms)
  durationMs Int       @map("duration_ms")
  /// @displayName 프레임 레이트 (fps)
  frameRate  Float?    @map("frame_rate")
  /// @displayName 비디오 코덱
  codec      String?
  /// @displayName 비트레이트 (bps)
  bitrate    Int?
  /// @displayName 오디오 포함 여부
  hasAudio   Boolean   @default(false) @map("has_audio")
  /// @displayName 원본 Asset ID
  assetId    String    @unique @map("asset_id")
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("videos")
}

// @schema-type: MATERIALIZATION
// @description: Asset(kind=DOCUMENT)의 문서 전용 상세 정보 (CTI 1:1)
// @materializes: Asset (DOCUMENT 타입)
/// @displayName 문서 상세
model Document {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 페이지 수
  pageCount Int?      @map("page_count")
  /// @displayName 단어 수
  wordCount Int?      @map("word_count")
  /// @displayName 작성자
  author    String?
  /// @displayName 제목
  title     String?
  /// @displayName 주제
  subject   String?
  /// @displayName 키워드
  keywords  String?
  /// @displayName 원본 Asset ID
  assetId   String    @unique @map("asset_id")
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("documents")
}

// @schema-type: EXTENSION
// @description: Asset의 파생 리소스(썸네일, 프리뷰, 트랜스코딩 등) 관리
// @extends: Asset (1:N)
/// @displayName 파생 리소스
model Derivative {
  id         String         @id @default(uuid())
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime?      @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt  DateTime?      @map("removed_at") @db.Timestamptz(6)
  /// @displayName 소속 Space
  spaceId    String         @map("space_id")
  /// @displayName 원본 Asset ID
  assetId    String         @map("asset_id")
  /// @displayName 파생 리소스 종류
  kind       DerivativeKind
  /// @displayName 변환 프로필명
  profile    String         @default("default")
  /// @displayName 스토리지 키
  storageKey String         @unique @map("storage_key")
  /// @displayName MIME 타입
  mimeType   String         @map("mime_type")
  /// @displayName 파일 크기
  sizeBytes  BigInt         @map("size_bytes")
  /// @displayName 너비 (이미지/비디오)
  width      Int?
  /// @displayName 높이 (이미지/비디오)
  height     Int?
  /// @displayName 재생 시간 (비디오 트랜스코딩)
  durationMs Int?           @map("duration_ms")
  space      Space          @relation(fields: [spaceId], references: [id])
  asset      Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, kind, profile])
  @@index([spaceId])
  @@index([assetId])
  @@index([kind])
  @@map("derivatives")
}
