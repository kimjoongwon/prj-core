// @data-type: CONFIGURATION
// @aggregate-root: true
// @description: 여러 Ability를 묶어 Role에 할당되는 공간별 권한 정책 묶음
/// @displayName 정책
model Policy {
  policyId  String    @unique @default(ulid()) @map("policy_id") @db.Char(26)
  id        BigInt    @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)

  /// @displayName 공간 내부 순번
  spaceId     BigInt  @map("space_id")
  /// @displayName 생성자 내부 순번
  createdById BigInt? @map("created_by_id")
  /// @displayName 정책 식별자
  name        String
  /// @displayName 표시명
  displayName String? @map("display_name")
  /// @displayName 설명
  description String?

  space           Space            @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  entries         PolicyEntry[]
  roleAssignments RoleAssignment[]

  @@unique([spaceId, name])
  @@index([spaceId])
  @@map("policies")
}
