// @data-type: CONFIGURATION
// @description: Policy에 포함되는 Ability 항목과 그 연결 생명주기를 관리
/// @displayName 정책의 권한 항목
model PolicyEntry {
  id        String    @unique @default(ulid()) @map("policy_entry_id") @db.Char(26)
  seq       BigInt    @id @default(autoincrement()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)

  /// @displayName 정책 내부 순번
  policySeq  BigInt @map("policy_id")
  /// @displayName 권한 내부 순번
  abilitySeq BigInt @map("ability_id")

  policy  Policy  @relation(fields: [policySeq], references: [seq])
  ability Ability @relation(fields: [abilitySeq], references: [seq])

  @@unique([policySeq, abilitySeq])
  @@index([policySeq])
  @@index([abilitySeq])
  @@map("policy_entries")
}
