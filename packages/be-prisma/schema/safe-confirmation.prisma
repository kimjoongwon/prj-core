// @data-type: EVENT
// @description: SafeTransaction에 종속되는 소유자 서명 데이터
/// @displayName Safe 트랜잭션 서명
model SafeConfirmation {
  id                 String          @unique @default(ulid()) @map("safe_confirmation_id") @db.Char(26)
  seq                BigInt          @id @default(autoincrement()) @map("id")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  safeTransactionSeq BigInt          @map("safe_transaction_id")
  safeTransaction    SafeTransaction @relation(fields: [safeTransactionSeq], references: [seq])
  owner              String // 서명자 주소
  signature          String // 서명 데이터

  @@unique([safeTransactionSeq, owner])
  @@map("safe_confirmations")
}
