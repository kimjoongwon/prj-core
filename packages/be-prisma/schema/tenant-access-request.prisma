// @data-type: TRANSACTION
// @aggregate-root: true
// @description: 사용자의 Space/Role 접근 신청과 승인/반려 이력을 관리하는 aggregate
/// @displayName 테넌트 접근 신청
model TenantAccessRequest {
  tenantAccessRequestId String                    @unique @default(ulid()) @map("tenant_access_request_id") @db.Char(26)
  id                    BigInt                    @id @default(autoincrement())
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime?                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt             DateTime?                 @map("removed_at") @db.Timestamptz(6)
  requesterId           BigInt                    @map("requester_id")
  spaceId               BigInt                    @map("space_id")
  requestedRoleId       BigInt                    @map("requested_role_id")
  previousRoleId        BigInt?                   @map("previous_role_id")
  reason                String?
  status                TenantAccessRequestStatus @default(PENDING)
  reviewerId            BigInt?                   @map("reviewer_id")
  reviewComment         String?                   @map("review_comment")
  reviewedAt            DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  appliedTenantId       BigInt?                   @map("applied_tenant_id")
  requester             User                      @relation("TenantAccessRequestRequester", fields: [requesterId], references: [id])
  reviewer              User?                     @relation("TenantAccessRequestReviewer", fields: [reviewerId], references: [id])
  space                 Space                     @relation(fields: [spaceId], references: [id])
  requestedRole         Role                      @relation("TenantAccessRequestRequestedRole", fields: [requestedRoleId], references: [id])
  previousRole          Role?                     @relation("TenantAccessRequestPreviousRole", fields: [previousRoleId], references: [id])
  appliedTenant         Tenant?                   @relation(fields: [appliedTenantId], references: [id])

  @@index([requesterId])
  @@index([spaceId])
  @@index([status])
  @@index([requesterId, spaceId, status])
  @@map("tenant_access_requests")
}
