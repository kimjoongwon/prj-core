// @data-type: TRANSACTION
// @aggregate-root: true
// @description: 사용자의 Space/Role 접근 신청과 승인/반려 이력을 관리하는 aggregate
/// @displayName 테넌트 접근 신청
model TenantAccessRequest {
  id               String                    @unique @default(ulid()) @map("tenant_access_request_id") @db.Char(26)
  seq              BigInt                    @id @default(autoincrement()) @map("id")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime?                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt        DateTime?                 @map("removed_at") @db.Timestamptz(6)
  requesterSeq     BigInt                    @map("requester_id")
  spaceSeq         BigInt                    @map("space_id")
  requestedRoleSeq BigInt                    @map("requested_role_id")
  previousRoleSeq  BigInt?                   @map("previous_role_id")
  reason           String?
  status           TenantAccessRequestStatus @default(PENDING)
  reviewerSeq      BigInt?                   @map("reviewer_id")
  reviewComment    String?                   @map("review_comment")
  reviewedAt       DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  appliedTenantSeq BigInt?                   @map("applied_tenant_id")
  requester        User                      @relation("TenantAccessRequestRequester", fields: [requesterSeq], references: [seq])
  reviewer         User?                     @relation("TenantAccessRequestReviewer", fields: [reviewerSeq], references: [seq])
  space            Space                     @relation(fields: [spaceSeq], references: [seq])
  requestedRole    Role                      @relation("TenantAccessRequestRequestedRole", fields: [requestedRoleSeq], references: [seq])
  previousRole     Role?                     @relation("TenantAccessRequestPreviousRole", fields: [previousRoleSeq], references: [seq])
  appliedTenant    Tenant?                   @relation(fields: [appliedTenantSeq], references: [seq])

  @@index([requesterSeq])
  @@index([spaceSeq])
  @@index([status])
  @@index([requesterSeq, spaceSeq, status])
  @@map("tenant_access_requests")
}
