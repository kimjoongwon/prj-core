// @data-type: MASTER
// @description: Asset(kind=VIDEO)에 종속되는 비디오 1:1 상세 정보
/// @displayName 비디오 상세
model Video {
  id         String    @unique @default(ulid()) @db.VarChar(26)
  seq        Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 너비 (px)
  width      Int
  /// @displayName 높이 (px)
  height     Int
  /// @displayName 재생 시간 (ms)
  durationMs Int       @map("duration_ms")
  /// @displayName 프레임 레이트 (fps)
  frameRate  Float?    @map("frame_rate")
  /// @displayName 비디오 코덱
  codec      String?
  /// @displayName 비트레이트 (bps)
  bitrate    Int?
  /// @displayName 오디오 포함 여부
  hasAudio   Boolean   @default(false) @map("has_audio")
  /// @displayName 원본 Asset 내부 순번
  assetSeq   Int       @unique @map("asset_seq")
  asset      Asset     @relation(fields: [assetSeq], references: [seq], onDelete: Cascade)

  @@map("videos")
}
