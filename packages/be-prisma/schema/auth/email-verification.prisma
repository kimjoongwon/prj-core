// ============================================================================
// Email Verification Domain - 이메일 인증 도메인
// ============================================================================

// @schema-type: LOG
// @schema-owner: true
// @aggregate-root: true
// @usecase-anchor: true
// @description: 회원가입 전 이메일 인증 요청과 발송/완료 상태를 기록하는 전역 인증 로그
// @ownership: independent
// @scope: global
/// @displayName 이메일 인증
model EmailVerification {
  id             String                  @id @default(uuid())
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?               @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt      DateTime?               @map("removed_at") @db.Timestamptz(6)
  /// @displayName 이메일
  email          String
  /// @displayName 이름
  name           String
  /// @displayName 닉네임
  nickname       String
  /// @displayName 전화번호
  phone          String
  /// @displayName 주소
  address        String
  /// @displayName 가입 Space ID
  spaceId        String                  @map("space_id")
  space          Space                   @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  /// @displayName 비밀번호 해시
  passwordHash   String                  @map("password_hash")
  /// @displayName 토큰 해시
  tokenHash      String                  @unique @map("token_hash")
  /// @displayName 상태
  status         EmailVerificationStatus @default(PENDING)
  /// @displayName 만료 시각
  expiresAt      DateTime                @map("expires_at") @db.Timestamptz(6)
  /// @displayName 인증 시각
  verifiedAt     DateTime?               @map("verified_at") @db.Timestamptz(6)
  /// @displayName 마지막 발송 시각
  lastSentAt     DateTime?               @map("last_sent_at") @db.Timestamptz(6)
  /// @displayName 발송 횟수
  sendCount      Int                     @default(0) @map("send_count")
  /// @displayName 마지막 발송 상태
  lastSendStatus String?                 @map("last_send_status")
  /// @displayName 마지막 발송 오류
  lastSendError  String?                 @map("last_send_error")
  /// @displayName 인증 완료 사용자 ID
  verifiedUserId String?                 @map("verified_user_id")
  verifiedUser   User?                   @relation(fields: [verifiedUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([spaceId])
  @@index([verifiedUserId])
  @@map("email_verifications")
}

/// @displayName 이메일 인증 상태
enum EmailVerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
}
