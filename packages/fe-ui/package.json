{
  "name": "@cocrepo/ui",
  "version": "1.5.17",
  "description": "ui library",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./layout": {
      "types": "./src/layout/index.ts",
      "import": "./src/layout/index.ts",
      "default": "./src/layout/index.ts"
    },
    "./widget": {
      "types": "./src/widget/index.ts",
      "import": "./src/widget/index.ts",
      "default": "./src/widget/index.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./index.ts",
  "module": "./index.ts",
  "types": "./index.ts",
  "files": [
    "src",
    "index.ts",
    "README.md"
  ],
  "scripts": {
    "build": "echo 'Build not needed - using source files directly'",
    "start:dev": "echo 'Development mode - no build needed'",
    "lint": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs",
    "lint:fix": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --fix",
    "format": "biome check --write .",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "type-check:prod": "tsc --noEmit -p tsconfig.prod.json",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "clean": "rm -rf .turbo && rm -rf node_modules",
    "clean:dist": "echo 'No dist folder to clean'",
    "lint:prod": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --prod"
  },
  "author": "kimjoongwon",
  "license": "ISC",
  "devDependencies": {
    "@cocrepo/api": "workspace:*",
    "@cocrepo/enum": "workspace:*",
    "@cocrepo/hook": "workspace:*",
    "@cocrepo/store": "workspace:*",
    "@cocrepo/toolkit": "workspace:*",
    "@cocrepo/type": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroui/react": "catalog:",
    "@heroui/styles": "catalog:",
    "@internationalized/date": "3.12.0",
    "@storybook/react": "^9.0.18",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "^1.130.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-cli": "^1.130.2",
    "@tanstack/router-devtools": "^1.130.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/pluralize": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/uuid": "catalog:",
    "@vitejs/plugin-react-swc": "catalog:",
    "@vitest/ui": "catalog:",
    "autoprefixer": "catalog:",
    "axios": "catalog:",
    "class-variance-authority": "catalog:",
    "dayjs": "catalog:",
    "framer-motion": "catalog:",
    "jsdom": "catalog:",
    "jwt-decode": "^4.0.0",
    "lucide-react": "catalog:",
    "mobx": "catalog:",
    "mobx-react-lite": "catalog:",
    "msw": "^2.10.4",
    "path-parser": "6.1.0",
    "pluralize": "catalog:",
    "postcss": "catalog:",
    "react": "catalog:",
    "react-cookie": "catalog:",
    "react-dom": "catalog:",
    "react-dropzone": "catalog:",
    "react-test-renderer": "^19.2.5",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "uuid": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-react": "^11.1.2",
    "@cocrepo/constant": "workspace:*",
    "@cocrepo/toolkit": "workspace:*",
    "@react-aria/ssr": "^3.9.10",
    "ckeditor5": "^48.0.1",
    "frappe-gantt": "^1.2.2",
    "mermaid": "^11.12.3",
    "next-themes": "catalog:"
  }
}
