// ============================================================================
// Space Domain - 공간 도메인
// ============================================================================
//
// Space는 추상적인 공간 컨테이너입니다.
// 자체로는 구체적인 의미(name 등)가 없으며, Ground를 통해 구체화됩니다.
//
// 관계 구조:
//   Space (추상) ◄─── Ground (구체화: name, address, phone, email, businessNo)
//     │
//     ├─── SpaceClassification ─── Category (분류)
//     ├─── SpaceAssociation ─── Group (그룹핑)
//     └─── Tenant (Bridge: User + Space + Role)
//
// ============================================================================

// @schema-type: ABSTRACT ENTITY
// @description: 구체적인 구현 없이 Ground에게 확장 기반을 제공하는 추상 컨테이너
// @materialized-by: Ground
/// @displayName 공간
model Space {
  id             String               @id @default(uuid())
  seq            Int                  @unique @default(autoincrement())
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?            @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt      DateTime?            @map("removed_at") @db.Timestamptz(6)
  ground         Ground?
  associations   SpaceAssociation[]
  classification SpaceClassification?
  tenants        Tenant[]
  // Space소속 리소스
  categories     Category[]
  groups         Group[]
  contents       Content[]
  files          File[]
  timelines      Timeline[]
  tasks          Task[]
  safeWallets    SafeWallet[]

  @@map("spaces")
}

// @schema-type: CLASSIFICATION
// @description: Space에 Category를 연결하여 분류 체계 부여
// @connects: Space ─── Category
/// @displayName 공간 분류
model SpaceClassification {
  id         String    @id @default(uuid())
  seq        Int       @unique @default(autoincrement())
  categoryId String    @map("category_id")
  spaceId    String    @unique @map("space_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(6)
  category   Category  @relation(fields: [categoryId], references: [id])
  space      Space     @relation(fields: [spaceId], references: [id])

  @@unique([categoryId, spaceId])
  @@map("space_classifications")
}

// @schema-type: ASSOCIATION
// @description: Space와 Group을 연결하여 그룹핑
// @connects: Space ─── Group
/// @displayName 공간 그룹
model SpaceAssociation {
  id        String    @id @default(uuid())
  seq       Int       @unique @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  spaceId   String    @map("space_id")
  groupId   String    @map("group_id")
  group     Group     @relation(fields: [groupId], references: [id])
  space     Space     @relation(fields: [spaceId], references: [id])

  @@unique([spaceId, groupId])
  @@map("space_associations")
}

// @schema-type: MATERIALIZATION
// @description: Space를 구체화하여 실제 비즈니스 의미(name, address 등)를 부여
// @materializes: Space (1:1)
// @business-fields: name, label, address, phone, email, businessNo
/// @displayName 시설
model Ground {
  id              String    @id @default(uuid())
  seq             Int       @unique @default(autoincrement())
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt       DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 이름
  name            String
  /// @displayName 라벨
  label           String?
  /// @displayName 주소
  address         String
  /// @displayName 전화번호
  phone           String
  /// @displayName 이메일
  email           String
  /// @displayName 사업자등록번호
  businessNo      String    @unique @map("business_no")
  spaceId         String    @unique @map("space_id")
  logoImageFileId String?   @map("logo_image_file_id")
  imageFileId     String?   @map("image_file_id")
  space           Space     @relation(fields: [spaceId], references: [id])

  @@map("grounds")
}
