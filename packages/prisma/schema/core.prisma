// ============================================================================
// Core Domain - 핵심 공통 도메인
// ============================================================================
//
// 시스템 전반에서 사용되는 핵심 공통 모델들입니다.
// Category, Group: 분류/그룹핑 체계
// Tenant: User + Space + Role을 연결하는 핵심 Bridge
// Action, Subject, Ability: 권한 체계
// Content, Post: 콘텐츠 관리
//
// ============================================================================

// @schema-type: CONCRETE ENTITY
// @description: 분류 체계를 정의하는 카테고리 (트리 구조)
// @self-reference: parent/children
// @connected-by: XxxClassification 모델들
model Category {
  id                   String                @id @default(uuid())
  seq                  Int                   @unique @default(autoincrement())
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?             @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt            DateTime?             @map("removed_at") @db.Timestamptz(6)
  name                 String                @unique
  type                 CategoryTypes         @default(User)
  parentId             String?               @map("parent_id")
  tenantId             String                @map("tenant_id")
  parent               Category?             @relation("CategoryToCategory", fields: [parentId], references: [id])
  children             Category[]            @relation("CategoryToCategory")
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  fileClassifications  FileClassification[]
  roleClassifications  RoleClassification[]
  spaceClassifications SpaceClassification[]
  userClassifications  UserClassification[]

  @@map("categories")
}

// @schema-type: CONCRETE ENTITY
// @description: 그룹핑 체계를 정의하는 그룹
// @connected-by: XxxAssociation 모델들
model Group {
  id                String             @id @default(uuid())
  seq               Int                @unique @default(autoincrement())
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime?          @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt         DateTime?          @map("removed_at") @db.Timestamptz(6)
  name              String
  type              GroupTypes         @default(User)
  label             String?
  tenantId          String             @map("tenant_id")
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  fileAssociations  FileAssociation[]
  roleAssociations  RoleAssociation[]
  spaceAssociations SpaceAssociation[]
  userAssociations  UserAssociation[]

  @@map("groups")
}

// @schema-type: BRIDGE
// @description: User + Space + Role을 연결하는 핵심 다대다 관계 테이블
// @connects: User ─── Space ─── Role
// @note: 사용자가 특정 공간에서 어떤 역할을 가지는지를 정의
model Tenant {
  id          String       @id @default(uuid())
  seq         Int          @unique @default(autoincrement())
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?    @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime?    @map("removed_at") @db.Timestamptz(6)
  userId      String       @map("user_id")
  spaceId     String       @map("space_id")
  roleId      String       @map("role_id")
  main        Boolean      @default(false)
  assignments Assignment[]
  categories  Category[]
  contents    Content[]
  files       File[]
  groups      Group[]
  safeWallets SafeWallet[]
  role        Role         @relation(fields: [roleId], references: [id])
  space       Space        @relation(fields: [spaceId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@map("tenants")
}

// @schema-type: BRIDGE
// @description: Tenant에 추가 Role을 할당하는 다대다 관계 테이블
// @connects: Tenant ─── Role
model Assignment {
  id        String    @id @default(uuid())
  seq       Int       @unique @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  roleId    String    @map("role_id")
  tenantId  String    @map("tenant_id")
  role      Role      @relation(fields: [roleId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@map("assignments")
}

// @schema-type: REFERENCE
// @description: 권한 체계에서 사용되는 액션 정의 (CREATE, READ, UPDATE, DELETE 등)
model Action {
  id         String         @id @default(uuid())
  seq        Int            @unique @default(autoincrement())
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime?      @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt  DateTime?      @map("removed_at") @db.Timestamptz(6)
  name       AbilityActions @default(CREATE)
  conditions Json?
  tenantId   String         @map("tenant_id")

  @@map("actions")
}

// @schema-type: REFERENCE
// @description: 권한 체계에서 사용되는 대상 정의 (권한이 적용되는 리소스)
model Subject {
  id        String    @id @default(uuid())
  seq       Int       @unique @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  name      String    @unique
  tenantId  String    @map("tenant_id")

  @@map("subjects")
}

// @schema-type: REFERENCE
// @description: Role에 부여되는 구체적인 권한 정의 (CASL 기반)
// @connects: Role ─── Subject (특정 대상에 대한 권한)
model Ability {
  id          String       @id @default(uuid())
  seq         Int          @unique @default(autoincrement())
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?    @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime?    @map("removed_at") @db.Timestamptz(6)
  type        AbilityTypes
  roleId      String       @map("role_id")
  description String?
  conditions  Json?
  subjectId   String       @map("subject_id")
  tenantId    String       @map("tenant_id")
  role        Role         @relation(fields: [roleId], references: [id])

  @@map("abilities")
}

// @schema-type: CONTENT
// @description: 게시물 - Content를 감싸는 발행 단위
// @wraps: Content
model Post {
  id        String    @id @default(uuid())
  seq       Int       @unique @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  contentId String    @map("content_id")
  content   Content   @relation(fields: [contentId], references: [id])

  @@map("posts")
}

// @schema-type: CONTENT
// @description: 사용자 생성 콘텐츠 (텍스트, 에디터 내용 등)
model Content {
  id          String    @id @default(uuid())
  seq         Int       @unique @default(autoincrement())
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  title       String?
  description String?
  type        TextTypes @default(Editor)
  text        String?   @db.VarChar(1000)
  fileId      String?   @map("file_id")
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  posts       Post[]

  @@map("contents")
}

enum SMSStatus {
  PROGRESS
  PENDING
  SENT
  FAILED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum SessionTypes {
  ONE_TIME
  ONE_TIME_RANGE
  RECURRING
}

enum RepeatCycleTypes {
  WEEKLY
  MONTHLY
}

enum SessionEndTypes {
  NEVER
  ON_DATE
  AFTER_OCCURRENCES
}

enum RecurringDayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AbilityActions {
  CREATE
  READ
  UPDATE
  DELETE
  ACCESS
}

enum AbilityTypes {
  CAN
  CAN_NOT
}

enum Roles {
  USER
  SUPER_ADMIN
  ADMIN
}

enum TemplateNames {
  WELCOME
  EMAIL_VERIFICATION
  RESET_PASSWORD
}

enum QnaStatus {
  OPEN
  CLOSED
}

enum TextTypes {
  Editor
  Input
  Textarea
}

enum CategoryTypes {
  Role
  Space
  File
  User
}

enum GroupTypes {
  Role
  Space
  File
  User
}
