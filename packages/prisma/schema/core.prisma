// ============================================================================
// Core Domain - 핵심 공통 도메인
// ============================================================================
//
// 시스템 전반에서 사용되는 핵심 공통 모델들입니다.
// Category, Group: 분류/그룹핑 체계
// Tenant: User + Space + Role을 연결하는 핵심 Bridge
// Subject, Action, Ability: CASL 기반 권한 체계 (RBAC + ABAC)
// Content, Post: 콘텐츠 관리
//
// 관계 구조:
//   Ability (REFERENCE)
//     │
//     ├─── Role (역할 기반 기본 권한)
//     ├─── User (사용자별 예외 권한)
//     ├─── Subject (권한 대상)
//     └─── Action (행위 정의 - 마스킹 설정 포함)
//
// ============================================================================

// @schema-type: CONCRETE ENTITY
// @description: 분류 체계를 정의하는 카테고리 (트리 구조)
// @self-reference: parent/children
// @connected-by: XxxClassification 모델들
/// @displayName 카테고리
model Category {
  id                   String                @id @default(uuid())
  seq                  Int                   @unique @default(autoincrement())
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?             @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt            DateTime?             @map("removed_at") @db.Timestamptz(6)
  /// @displayName 이름
  name                 String                @unique
  /// @displayName 유형
  type                 CategoryTypes         @default(User)
  parentId             String?               @map("parent_id")
  spaceId              String                @map("space_id")
  creatorId            String?               @map("creator_id")
  parent               Category?             @relation("CategoryToCategory", fields: [parentId], references: [id])
  children             Category[]            @relation("CategoryToCategory")
  space                Space                 @relation(fields: [spaceId], references: [id])
  creator              User?                 @relation("CategoryCreator", fields: [creatorId], references: [id])
  fileClassifications  FileClassification[]
  roleClassifications  RoleClassification[]
  spaceClassifications SpaceClassification[]
  userClassifications  UserClassification[]

  @@index([spaceId])
  @@map("categories")
}

// @schema-type: CONCRETE ENTITY
// @description: 그룹핑 체계를 정의하는 그룹
// @connected-by: XxxAssociation 모델들
/// @displayName 그룹
model Group {
  id                String             @id @default(uuid())
  seq               Int                @unique @default(autoincrement())
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime?          @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt         DateTime?          @map("removed_at") @db.Timestamptz(6)
  /// @displayName 이름
  name              String
  /// @displayName 유형
  type              GroupTypes         @default(User)
  /// @displayName 라벨
  label             String?
  spaceId           String             @map("space_id")
  creatorId         String?            @map("creator_id")
  space             Space              @relation(fields: [spaceId], references: [id])
  creator           User?              @relation("GroupCreator", fields: [creatorId], references: [id])
  fileAssociations  FileAssociation[]
  roleAssociations  RoleAssociation[]
  spaceAssociations SpaceAssociation[]
  userAssociations  UserAssociation[]

  @@index([spaceId])
  @@map("groups")
}

// @schema-type: BRIDGE
// @description: User + Space + Role을 연결하는 핵심 다대다 관계 테이블
// @connects: User ─── Space ─── Role
// @note: 사용자가 특정 공간에서 어떤 역할을 가지는지를 정의
/// @displayName 테넌트
model Tenant {
  id          String       @id @default(uuid())
  seq         Int          @unique @default(autoincrement())
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?    @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime?    @map("removed_at") @db.Timestamptz(6)
  userId      String       @map("user_id")
  spaceId     String       @map("space_id")
  roleId      String       @map("role_id")
  assignments Assignment[]
  role        Role         @relation(fields: [roleId], references: [id])
  space       Space        @relation(fields: [spaceId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@map("tenants")
}

// @schema-type: BRIDGE
// @description: Tenant에 추가 Role을 할당하는 다대다 관계 테이블
// @connects: Tenant ─── Role
/// @displayName 역할 할당
model Assignment {
  id        String    @id @default(uuid())
  seq       Int       @unique @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  roleId    String    @map("role_id")
  tenantId  String    @map("tenant_id")
  role      Role      @relation(fields: [roleId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@map("assignments")
}

// @schema-type: REFERENCE
// @description: CASL Subject 정의 (Prisma 모델 기반 + 커스텀 Subject)
// @note: DMMF에서 자동 동기화되며, 커스텀 Subject도 추가 가능
/// @displayName Subject
model Subject {
  id          String    @id @default(uuid())
  seq         Int       @unique @default(autoincrement())
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)

  /// @displayName 이름
  name        String    @unique  // Prisma 모델명, 'all', 'menu:xxx', 'entity:xxx', 'feature:xxx' 등
  /// @displayName 표시명
  displayName String?   @map("display_name")  // 한글 표시명
  /// @displayName 아이콘
  icon        String?   // 아이콘 (선택)
  /// @displayName 정렬 순서
  order       Int       @default(0)  // UI 정렬 순서
  /// @displayName 시스템 여부
  isSystem    Boolean   @default(true) @map("is_system")  // Prisma 모델 기반 여부
  /// @displayName 그룹
  group       String?   // 그룹핑 (entity, menu, feature 등)

  // 관계
  abilities         Ability[]

  @@index([group])
  @@index([isSystem])
  @@map("subjects")
}

// @schema-type: REFERENCE
// @description: CASL Action 정의 - 행위의 완전한 정의 (마스킹 설정 포함)
// @note: DDD 원칙에 따라 Action이 마스킹, 포맷팅 등 설정을 config에 포함
/// @displayName 액션
model Action {
  id          String    @id @default(uuid())
  seq         Int       @unique @default(autoincrement())
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)

  /// @displayName 이름
  name        String    @unique  // 'create', 'read', 'read:masked:email', 'read:masked:phone' 등
  /// @displayName 표시명
  displayName String?   @map("display_name")
  /// @displayName 설명
  description String?
  /// @displayName 그룹
  group       String?   // 'crud', 'visibility', 'bulk', 'workflow'
  /// @displayName 정렬 순서
  order       Int       @default(0)
  /// @displayName 시스템 여부
  isSystem    Boolean   @default(true) @map("is_system")

  // Action 설정 (DDD: Action이 완전한 정의를 가짐)
  // 마스킹, 포맷팅, 변환 등 다양한 유형 대응
  /// @displayName 설정
  config      Json?  // { type: 'masking', preset: 'PRESET_EMAIL' } 등

  // 관계
  abilities   Ability[]

  @@index([group])
  @@map("actions")
}

// @schema-type: REFERENCE
// @description: Role 또는 User에 부여되는 구체적인 권한 정의 (CASL ABAC 기반)
// @connects: Role (역할 기반 기본 권한)
// @connects: User (사용자별 예외 권한)
// @connects: Subject (권한 대상)
// @connects: Action (행위 정의)
// @note: roleId와 userId 중 하나만 설정 (Role 기반 + User 예외)
/// @displayName 권한
model Ability {
  id          String    @id @default(uuid())
  seq         Int       @unique @default(autoincrement())
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)

  // CASL 필수 필드
  /// @displayName 대상 필드
  fields      String[]  @default([])
  /// @displayName 조건
  conditions  Json?     // { "departmentId": "${user.departmentId}" }
  /// @displayName 거부 여부
  inverted    Boolean   @default(false) // can(false) vs cannot(true)
  /// @displayName 거부 사유
  reason      String?   // 거부 시 사용자에게 보여줄 메시지

  // 연결 대상
  subjectId   String    @map("subject_id") // Subject FK
  actionId    String    @map("action_id")  // Action FK
  roleId      String?   @map("role_id") // Role 기반 (기본 권한)
  userId      String?   @map("user_id") // User 기반 (예외 권한)

  // 관계
  subject     Subject   @relation(fields: [subjectId], references: [id])
  action      Action    @relation(fields: [actionId], references: [id])
  role        Role?     @relation(fields: [roleId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])

  // 메타데이터
  /// @displayName 이름
  name        String?   // "본인 예약만 조회"
  /// @displayName 설명
  description String?
  /// @displayName 활성화 여부
  isActive    Boolean   @default(true) @map("is_active")
  /// @displayName 우선순위
  priority    Int       @default(0) // 높을수록 우선

  @@index([subjectId])
  @@index([actionId])
  @@index([roleId])
  @@index([userId])
  @@index([isActive])
  @@map("abilities")
}

// @schema-type: CONTENT
// @description: 게시물 - Content를 감싸는 발행 단위
// @wraps: Content
/// @displayName 게시물
model Post {
  id        String    @id @default(uuid())
  seq       Int       @unique @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  contentId String    @map("content_id")
  content   Content   @relation(fields: [contentId], references: [id])

  @@map("posts")
}

// @schema-type: CONTENT
// @description: 사용자 생성 콘텐츠 (텍스트, 에디터 내용 등)
/// @displayName 콘텐츠
model Content {
  id          String    @id @default(uuid())
  seq         Int       @unique @default(autoincrement())
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 제목
  title       String?
  /// @displayName 설명
  description String?
  /// @displayName 유형
  type        TextTypes @default(Editor)
  /// @displayName 본문
  text        String?   @db.VarChar(1000)
  fileId      String?   @map("file_id")
  spaceId     String    @map("space_id")
  creatorId   String?   @map("creator_id")
  space       Space     @relation(fields: [spaceId], references: [id])
  creator     User?     @relation("ContentCreator", fields: [creatorId], references: [id])
  posts       Post[]

  @@index([spaceId])
  @@map("contents")
}

enum SMSStatus {
  PROGRESS
  PENDING
  SENT
  FAILED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum SessionTypes {
  ONE_TIME
  ONE_TIME_RANGE
  RECURRING
}

enum RepeatCycleTypes {
  WEEKLY
  MONTHLY
}

enum SessionEndTypes {
  NEVER
  ON_DATE
  AFTER_OCCURRENCES
}

enum RecurringDayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}


enum Roles {
  USER
  SUPER_ADMIN
  ADMIN
}

enum TemplateNames {
  WELCOME
  EMAIL_VERIFICATION
  RESET_PASSWORD
}

enum QnaStatus {
  OPEN
  CLOSED
}

enum TextTypes {
  Editor
  Input
  Textarea
}

enum CategoryTypes {
  Role
  Space
  File
  User
}

enum GroupTypes {
  Role
  Space
  File
  User
}
