// ============================================================================
// Core Domain - 핵심 공통 도메인
// ============================================================================
//
// 시스템 전반에서 사용되는 핵심 공통 모델들입니다.
// Category, Group: 분류/그룹핑 체계
// Tenant: User + Space + Role을 연결하는 핵심 Bridge
// Subject, Ability: CASL 기반 권한 체계
// Content, Post: 콘텐츠 관리
//
// 관계 구조:
//   Subject (REFERENCE)
//     │
//     ├─── self-reference (parent/children) - 계층 구조
//     └─── Ability (권한 정의)
//
//   Ability (REFERENCE)
//     │
//     ├─── Role (역할)
//     └─── Subject (대상)
//
// ============================================================================

// @schema-type: CONCRETE ENTITY
// @description: 분류 체계를 정의하는 카테고리 (트리 구조)
// @self-reference: parent/children
// @connected-by: XxxClassification 모델들
/// @displayName 카테고리
model Category {
  id                   String                @id @default(uuid())
  seq                  Int                   @unique @default(autoincrement())
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?             @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt            DateTime?             @map("removed_at") @db.Timestamptz(6)
  /// @displayName 이름
  name                 String                @unique
  /// @displayName 유형
  type                 CategoryTypes         @default(User)
  parentId             String?               @map("parent_id")
  spaceId              String                @map("space_id")
  creatorId            String?               @map("creator_id")
  parent               Category?             @relation("CategoryToCategory", fields: [parentId], references: [id])
  children             Category[]            @relation("CategoryToCategory")
  space                Space                 @relation(fields: [spaceId], references: [id])
  creator              User?                 @relation("CategoryCreator", fields: [creatorId], references: [id])
  fileClassifications  FileClassification[]
  roleClassifications  RoleClassification[]
  spaceClassifications SpaceClassification[]
  userClassifications  UserClassification[]

  @@index([spaceId])
  @@map("categories")
}

// @schema-type: CONCRETE ENTITY
// @description: 그룹핑 체계를 정의하는 그룹
// @connected-by: XxxAssociation 모델들
/// @displayName 그룹
model Group {
  id                String             @id @default(uuid())
  seq               Int                @unique @default(autoincrement())
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime?          @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt         DateTime?          @map("removed_at") @db.Timestamptz(6)
  /// @displayName 이름
  name              String
  /// @displayName 유형
  type              GroupTypes         @default(User)
  /// @displayName 라벨
  label             String?
  spaceId           String             @map("space_id")
  creatorId         String?            @map("creator_id")
  space             Space              @relation(fields: [spaceId], references: [id])
  creator           User?              @relation("GroupCreator", fields: [creatorId], references: [id])
  fileAssociations  FileAssociation[]
  roleAssociations  RoleAssociation[]
  spaceAssociations SpaceAssociation[]
  userAssociations  UserAssociation[]

  @@index([spaceId])
  @@map("groups")
}

// @schema-type: BRIDGE
// @description: User + Space + Role을 연결하는 핵심 다대다 관계 테이블
// @connects: User ─── Space ─── Role
// @note: 사용자가 특정 공간에서 어떤 역할을 가지는지를 정의
/// @displayName 테넌트
model Tenant {
  id          String       @id @default(uuid())
  seq         Int          @unique @default(autoincrement())
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?    @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime?    @map("removed_at") @db.Timestamptz(6)
  userId      String       @map("user_id")
  spaceId     String       @map("space_id")
  roleId      String       @map("role_id")
  assignments Assignment[]
  role        Role         @relation(fields: [roleId], references: [id])
  space       Space        @relation(fields: [spaceId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@map("tenants")
}

// @schema-type: BRIDGE
// @description: Tenant에 추가 Role을 할당하는 다대다 관계 테이블
// @connects: Tenant ─── Role
/// @displayName 역할 할당
model Assignment {
  id        String    @id @default(uuid())
  seq       Int       @unique @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  roleId    String    @map("role_id")
  tenantId  String    @map("tenant_id")
  role      Role      @relation(fields: [roleId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@map("assignments")
}

// @schema-type: REFERENCE
// @description: 권한 체계에서 사용되는 대상 정의 (권한이 적용되는 리소스)
// @self-reference: parent/children (계층 구조)
// @connected-by: Ability
// @note: Menu, Feature, Entity, API, Column 5가지 타입으로 세밀한 권한 관리
/// @displayName 대상
model Subject {
  id          String       @id @default(uuid())
  seq         Int          @unique @default(autoincrement())
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?    @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime?    @map("removed_at") @db.Timestamptz(6)
  /// @displayName 식별자
  name        String       @unique
  /// @displayName 유형
  type        SubjectTypes @default(Entity)
  /// @displayName 라벨
  label       String?
  /// @displayName 표시명
  displayName String?      @map("display_name")
  /// @displayName 설명
  description String?
  parentId    String?      @map("parent_id")
  tenantId    String       @map("tenant_id")
  sortOrder   Int          @default(0) @map("sort_order")
  parent      Subject?     @relation("SubjectHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Subject[]    @relation("SubjectHierarchy")
  abilities   Ability[]

  @@index([tenantId])
  @@index([type])
  @@index([parentId])
  @@map("subjects")
}

// @schema-type: REFERENCE
// @description: Role에 부여되는 구체적인 권한 정의 (CASL 기반)
// @connects: Role ─── Subject (특정 대상에 대한 권한)
// @note: action을 enum으로 직접 관리하여 단순화, 중복 방지를 위한 unique 제약조건 추가
/// @displayName 권한
model Ability {
  id          String         @id @default(uuid())
  seq         Int            @unique @default(autoincrement())
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?      @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime?      @map("removed_at") @db.Timestamptz(6)
  /// @displayName 권한 유형
  type        AbilityTypes
  /// @displayName 액션
  action      AbilityActions
  roleId      String         @map("role_id")
  description String?
  conditions  Json?
  subjectId   String         @map("subject_id")
  tenantId    String         @map("tenant_id")
  isActive    Boolean        @default(true) @map("is_active")
  role        Role           @relation(fields: [roleId], references: [id])
  subject     Subject        @relation(fields: [subjectId], references: [id])

  @@unique([roleId, subjectId, action])
  @@index([tenantId])
  @@index([roleId])
  @@index([subjectId])
  @@index([isActive])
  @@map("abilities")
}

// @schema-type: CONTENT
// @description: 게시물 - Content를 감싸는 발행 단위
// @wraps: Content
/// @displayName 게시물
model Post {
  id        String    @id @default(uuid())
  seq       Int       @unique @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  contentId String    @map("content_id")
  content   Content   @relation(fields: [contentId], references: [id])

  @@map("posts")
}

// @schema-type: CONTENT
// @description: 사용자 생성 콘텐츠 (텍스트, 에디터 내용 등)
/// @displayName 콘텐츠
model Content {
  id          String    @id @default(uuid())
  seq         Int       @unique @default(autoincrement())
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  /// @displayName 제목
  title       String?
  /// @displayName 설명
  description String?
  /// @displayName 유형
  type        TextTypes @default(Editor)
  /// @displayName 본문
  text        String?   @db.VarChar(1000)
  fileId      String?   @map("file_id")
  spaceId     String    @map("space_id")
  creatorId   String?   @map("creator_id")
  space       Space     @relation(fields: [spaceId], references: [id])
  creator     User?     @relation("ContentCreator", fields: [creatorId], references: [id])
  posts       Post[]

  @@index([spaceId])
  @@map("contents")
}

enum SMSStatus {
  PROGRESS
  PENDING
  SENT
  FAILED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum SessionTypes {
  ONE_TIME
  ONE_TIME_RANGE
  RECURRING
}

enum RepeatCycleTypes {
  WEEKLY
  MONTHLY
}

enum SessionEndTypes {
  NEVER
  ON_DATE
  AFTER_OCCURRENCES
}

enum RecurringDayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AbilityActions {
  CREATE
  READ
  UPDATE
  DELETE
  ACCESS
  MANAGE
  EXPORT
  IMPORT
  APPROVE
  REJECT
}

enum AbilityTypes {
  CAN
  CAN_NOT
}

enum SubjectTypes {
  Menu
  Feature
  Entity
  API
  Column
}

enum Roles {
  USER
  SUPER_ADMIN
  ADMIN
}

enum TemplateNames {
  WELCOME
  EMAIL_VERIFICATION
  RESET_PASSWORD
}

enum QnaStatus {
  OPEN
  CLOSED
}

enum TextTypes {
  Editor
  Input
  Textarea
}

enum CategoryTypes {
  Role
  Space
  File
  User
}

enum GroupTypes {
  Role
  Space
  File
  User
}
