// ============================================================================
// Base configuration for Prisma multi-file schema
// This file contains generator and datasource configuration
// Models are organized in separate domain files
// ============================================================================
//
// ## Schema Type 분류 체계
//
// 각 모델은 다음 유형 중 하나로 분류됩니다:
//
// ┌─────────────────────────────────────────────────────────────────────────┐
// │ 1. ABSTRACT ENTITY (추상 엔티티)                                        │
// │    - 구체적인 구현(name 등)이 없는 컨테이너                              │
// │    - 다른 모델이 확장(Materialization)하여 의미를 부여                   │
// │    - 예: Space                                                          │
// ├─────────────────────────────────────────────────────────────────────────┤
// │ 2. CONCRETE ENTITY (구체 엔티티)                                        │
// │    - 독립적으로 존재하며 구체적인 비즈니스 정보를 가진 핵심 도메인 객체  │
// │    - 예: User, Role, File, Category, Group                              │
// ├─────────────────────────────────────────────────────────────────────────┤
// │ 3. MATERIALIZATION (구체화)                                             │
// │    - 추상 엔티티를 확장하여 실제 비즈니스 의미를 부여 (1:1 관계)         │
// │    - 예: Ground → Space를 구체화                                        │
// ├─────────────────────────────────────────────────────────────────────────┤
// │ 4. EXTENSION (확장)                                                     │
// │    - 핵심 엔티티에 추가 정보/컨텍스트를 부여 (1:N 관계)                  │
// │    - 예: Profile → User 확장                                            │
// ├─────────────────────────────────────────────────────────────────────────┤
// │ 5. CLASSIFICATION (분류)                                                │
// │    - 엔티티에 Category를 연결하여 분류 체계 부여 (1:1)                   │
// │    - 예: SpaceClassification, UserClassification                        │
// ├─────────────────────────────────────────────────────────────────────────┤
// │ 6. ASSOCIATION (연관)                                                   │
// │    - 엔티티와 Group을 연결하여 그룹핑 (N:M)                              │
// │    - 예: SpaceAssociation, UserAssociation                              │
// ├─────────────────────────────────────────────────────────────────────────┤
// │ 7. BRIDGE (연결)                                                        │
// │    - 여러 엔티티를 연결하는 다대다 관계 중간 테이블                      │
// │    - 예: Tenant (User + Space + Role), Assignment (Tenant + Role)       │
// ├─────────────────────────────────────────────────────────────────────────┤
// │ 8. REFERENCE (참조 데이터)                                              │
// │    - 시스템 전역에서 참조되는 정적/설정 데이터                           │
// │    - 예: Action, Subject, Ability                                       │
// ├─────────────────────────────────────────────────────────────────────────┤
// │ 9. CONTENT (콘텐츠)                                                     │
// │    - 사용자 생성 콘텐츠                                                  │
// │    - 예: Content, Post                                                  │
// └─────────────────────────────────────────────────────────────────────────┘
//
// ## 관계 다이어그램 (Space → Ground 예시)
//
//   ┌─────────────────┐      ┌─────────────────────────┐
//   │ [ABSTRACT]      │      │ [MATERIALIZATION]       │
//   │ Space           │◄─────│ Ground                  │
//   │ - id            │ 1:1  │ - name, address, phone  │
//   │ - (no name!)    │      │ - email, businessNo     │
//   └────────┬────────┘      └─────────────────────────┘
//            │
//   ┌────────┼────────┐
//   │        │        │
//   ▼        ▼        ▼
// [CLASSIF] [ASSOC] [BRIDGE]
// SpaceClassification  SpaceAssociation  Tenant
//     ↓                    ↓
// Category              Group
//
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}
