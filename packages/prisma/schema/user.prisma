// ============================================================================
// User Domain - 사용자 도메인
// ============================================================================
//
// User는 시스템의 핵심 사용자 엔티티입니다.
// Profile을 통해 추가 정보가 확장되고, Tenant를 통해 Space와 Role에 연결됩니다.
//
// 관계 구조:
//   User (구체 엔티티)
//     │
//     ├─── Profile (확장: nickname, avatar 등)
//     ├─── UserClassification ─── Category (분류)
//     ├─── UserAssociation ─── Group (그룹핑)
//     ├─── Tenant (Bridge: User + Space + Role)
//     └─── selectedSpace ─── Space (현재 선택한 Space)
//
// 데이터 관계 개념:
//   - Tenant: User가 접근 가능한 Space + Role 목록 (권한/자격)
//   - selectedSpaceId: 현재 작업 중인 Space (상태)
//
// ============================================================================

// @schema-type: CONCRETE ENTITY
// @description: 독립적으로 존재하는 핵심 사용자 도메인 객체
// @extended-by: Profile
model User {
  id                 String              @id @default(uuid())
  seq                Int                 @unique @default(autoincrement())
  updatedAt          DateTime?           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  removedAt          DateTime?           @map("removed_at") @db.Timestamptz(6)
  phone              String              @unique
  name               String              @unique
  email              String              @unique
  password           String
  selectedSpaceId    String?             @map("selected_space_id")
  selectedSpace      Space?              @relation("UserSelectedSpace", fields: [selectedSpaceId], references: [id])
  profiles           Profile[]
  tenants            Tenant[]
  classification     UserClassification?
  associations       UserAssociation[]
  // Creator 관계
  createdCategories  Category[]          @relation("CategoryCreator")
  createdGroups      Group[]             @relation("GroupCreator")
  createdContents    Content[]           @relation("ContentCreator")
  createdFiles       File[]              @relation("FileCreator")
  createdTimelines   Timeline[]          @relation("TimelineCreator")
  createdTasks       Task[]              @relation("TaskCreator")
  createdSafeWallets SafeWallet[]        @relation("SafeWalletCreator")

  @@map("users")
}

// @schema-type: CLASSIFICATION
// @description: User에 Category를 연결하여 분류 체계 부여
// @connects: User ─── Category
model UserClassification {
  id         String    @id @default(uuid())
  seq        Int       @unique @default(autoincrement())
  categoryId String    @map("category_id")
  userId     String    @unique @map("user_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(6)
  category   Category  @relation(fields: [categoryId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@unique([categoryId, userId])
  @@map("user_classifications")
}

// @schema-type: ASSOCIATION
// @description: User와 Group을 연결하여 그룹핑
// @connects: User ─── Group
model UserAssociation {
  id        String    @id @default(uuid())
  seq       Int       @unique @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  userId    String    @map("user_id")
  groupId   String    @map("group_id")
  group     Group     @relation(fields: [groupId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@map("user_associations")
}

// @schema-type: EXTENSION
// @description: User에 추가 정보(nickname, avatar)를 부여하는 확장 모델 (1:N)
// @extends: User
// @extension-fields: name, nickname, avatarFileId
model Profile {
  id           String    @id @default(uuid())
  seq          Int       @unique @default(autoincrement())
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(6)
  name         String
  nickname     String    @unique
  userId       String    @map("user_id")
  avatarFileId String?   @map("avatar_file_id")
  user         User      @relation(fields: [userId], references: [id])

  @@map("profiles")
}
