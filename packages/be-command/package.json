{
  "name": "@cocrepo/command",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "CQRS command and query message contracts for cocrepo",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "type-check": "tsc --noEmit --incremental false --composite false",
    "type-check:prod": "tsc --noEmit --incremental false --composite false",
    "build": "rm -rf dist && tsc --build",
    "start:dev": "tsc --build --watch",
    "lint": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs",
    "lint:fix": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --fix",
    "format": "biome check --write .",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist && rm -rf node_modules",
    "lint:prod": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --prod"
  },
  "dependencies": {
    "@cocrepo/input": "workspace:*",
    "@cocrepo/type": "workspace:*"
  },
  "devDependencies": {
    "@cocrepo/tsconfig": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "private": true
}
