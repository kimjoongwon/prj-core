{
  "name": "@cocrepo/enum",
  "version": "0.1.11",
  "description": "Shared Enum",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "start:dev": "tsc --build --watch",
    "build": "tsc --build",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "type-check:prod": "tsc --noEmit",
    "format": "biome check --write .",
    "lint": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs",
    "lint:fix": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --fix",
    "lint:prod": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --prod",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [],
  "author": "kimjoongwon",
  "license": "ISC",
  "dependencies": {
    "@cocrepo/prisma": "workspace:*",
    "@cocrepo/constant": "workspace:*"
  },
  "devDependencies": {
    "tsx": "catalog:"
  }
}
