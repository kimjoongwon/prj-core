{
	"name": "@cocrepo/decorator",
	"version": "0.1.11",
	"private": true,
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"description": "NestJS decorators for DTOs, entities, and API documentation",
	"files": [
		"dist",
		"README.md"
	],
	"main": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./field": {
			"types": "./dist/field/index.d.ts",
			"require": "./dist/field/index.js",
			"default": "./dist/field/index.js"
		},
		"./field/password": {
			"types": "./dist/field/specialized/password.field.d.ts",
			"require": "./dist/field/specialized/password.field.js",
			"default": "./dist/field/specialized/password.field.js"
		},
		"./transform": {
			"types": "./dist/transform.decorators.d.ts",
			"require": "./dist/transform.decorators.js",
			"default": "./dist/transform.decorators.js"
		}
	},
	"scripts": {
		"start:dev": "tsc --build --watch",
		"build": "tsc --build",
		"format": "biome check --write .",
		"type-check": "tsc --noEmit",
		"type-check:prod": "tsc --noEmit",
		"clean": "rm -rf dist && rm -rf node_modules",
		"lint": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs",
		"lint:fix": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --fix",
		"lint:prod": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --prod",
		"test": "vitest run"
	},
	"dependencies": {
		"@cocrepo/constant": "workspace:*",
		"@cocrepo/enum": "workspace:*",
		"@cocrepo/schema": "workspace:*",
		"@cocrepo/type": "workspace:*",
		"es-toolkit": "^1.52.0",
		"libphonenumber-js": "^1.13.15"
	},
	"peerDependencies": {
		"@nestjs/common": "^12.0.0",
		"@nestjs/swagger": "^12.0.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1"
	},
	"devDependencies": {
		"@cocrepo/tsconfig": "workspace:*",
		"@nestjs/common": "^12.0.0",
		"@nestjs/platform-express": "^12.0.0",
		"@nestjs/swagger": "^12.0.0",
		"@types/node": "catalog:",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"@types/jest": "^30.0.0"
	}
}
