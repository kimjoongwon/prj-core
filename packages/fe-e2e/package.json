{
  "name": "@cocrepo/e2e",
  "version": "1.0.0",
  "description": "Shared Playwright E2E helpers",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./index.ts",
  "module": "./index.ts",
  "types": "./index.ts",
  "files": [
    "src",
    "index.ts",
    "README.md"
  ],
  "scripts": {
    "build": "echo 'Build not needed - using source files directly'",
    "start:dev": "echo 'Development mode - no build needed'",
    "lint": "echo 'Linting skipped for now'",
    "lint:fix": "echo 'Linting skipped for now'",
    "format": "biome format --write .",
    "type-check": "echo 'Type checking skipped due to memory constraints'",
    "test": "echo 'No package-local tests'",
    "clean": "rm -rf .turbo && rm -rf node_modules"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
