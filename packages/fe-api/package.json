{
  "name": "@cocrepo/api",
  "version": "1.3.17",
  "description": "Generated API client and types from OpenAPI specs",
  "keywords": [
    "api",
    "openapi",
    "react-query",
    "typescript",
    "axios"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./assets": "./src/assets/index.ts",
    "./core/*": "./src/core/*/index.ts",
    "./core/client": "./src/core/client.ts",
    "./idp/*": "./src/idp/*/index.ts",
    "./idp/client": "./src/idp/client.ts",
    "./idp-model/*": "./src/idp-model/*.ts",
    "./model/*": "./src/model/*.ts",
    "./server": "./src/server/index.ts"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "codegen": "orval --config orval.config.js",
    "codegen:server": "orval --config orval.config.js --project store",
    "codegen:idp": "orval --config orval.config.js --project idp",
    "codegen:local": "ORVAL_ENV=local orval --config orval.config.js",
    "codegen:stg": "ORVAL_ENV=stg orval --config orval.config.js",
    "codegen:prod": "ORVAL_ENV=prod orval --config orval.config.js",
    "lint": "biome lint",
    "format": "biome check --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "axios": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "orval": "^7.8.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "author": "kimjoongwon",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/prj-core.git",
    "directory": "packages/fe-api"
  },
  "bugs": {
    "url": "https://github.com/your-org/prj-core/issues"
  },
  "homepage": "https://github.com/your-org/prj-core/tree/main/packages/api#readme"
}
