{
  "name": "@cocrepo/service",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Business logic and service layer for cocrepo",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "type-check:prod": "tsc --noEmit",
    "build": "rm -rf dist && tsc --build",
    "start:dev": "tsc --build --watch",
    "format": "biome check --write .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "clean": "rm -rf dist && rm -rf node_modules",
    "lint": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs",
    "lint:fix": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --fix",
    "lint:prod": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --prod"
  },
  "dependencies": {
    "@cocrepo/constant": "workspace:*",
    "@cocrepo/context": "workspace:*",
    "@cocrepo/decorator": "workspace:*",
    "@cocrepo/dto": "workspace:*",
    "@cocrepo/entity": "workspace:*",
    "@cocrepo/enum": "workspace:*",
    "@cocrepo/prisma": "workspace:*",
    "@cocrepo/repository": "workspace:*",
    "@cocrepo/toolkit": "workspace:*",
    "@cocrepo/type": "workspace:*",
    "@cocrepo/vo": "workspace:*",
    "libphonenumber-js": "^1.11.17",
    "nestjs-i18n": "^10.4.14"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/adapter-pg": "^7.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "ioredis": "^5.8.2",
    "libphonenumber-js": "^1.11.17",
    "nestjs-cls": "^6.1.0",
    "nodemailer": "^7.0.6",
    "oidc-provider": "^8.5.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@cocrepo/tsconfig": "workspace:*",
    "@aws-sdk/client-s3": "^3.883.0",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/testing": "^11.1.6",
    "@prisma/adapter-pg": "^7.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/oidc-provider": "^8.5.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "ioredis": "^5.8.2",
    "jest": "^30.1.3",
    "jest-mock-extended": "^4.0.0",
    "libphonenumber-js": "^1.11.17",
    "@types/nodemailer": "^7.0.1",
    "nestjs-cls": "^6.1.0",
    "nestjs-i18n": "^10.4.14",
    "nodemailer": "^7.0.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.0",
    "ts-jest": "^29.4.1",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
