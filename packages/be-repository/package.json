{
  "name": "@cocrepo/repository",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Repository 패턴 구현 패키지",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "type-check:prod": "tsc --noEmit",
    "build": "tsc --build",
    "start:dev": "tsc --build --watch",
    "format": "biome check --write .",
    "clean": "rm -rf dist && rm -rf node_modules",
    "test": "jest --passWithNoTests",
    "lint": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs",
    "lint:fix": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --fix",
    "lint:prod": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --prod"
  },
	"dependencies": {
		"@cocrepo/constant": "workspace:*",
		"@cocrepo/entity": "workspace:*",
		"@cocrepo/enum": "workspace:*",
		"@cocrepo/input": "workspace:*",
		"@cocrepo/prisma": "workspace:*",
		"@cocrepo/type": "workspace:*",
    "@cocrepo/vo": "workspace:*",
    "@prisma/adapter-pg": "^7.0.0",
    "class-transformer": "^0.5.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs-cls/transactional": "^3.1.1",
    "@nestjs-cls/transactional-adapter-prisma": "^1.3.2",
    "nestjs-cls": "^6.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@cocrepo/tsconfig": "workspace:*",
    "@nestjs-cls/transactional": "^3.1.1",
    "@nestjs-cls/transactional-adapter-prisma": "^1.3.2",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/testing": "^11.1.3",
    "@types/jest": "^29.5.14",
    "@types/node": "catalog:",
    "@types/pg": "^8.11.10",
    "jest": "^30.2.0",
    "nestjs-cls": "^6.1.0",
    "pg": "^8.16.0",
    "ts-jest": "^29.4.0",
    "typescript": "catalog:"
  }
}
