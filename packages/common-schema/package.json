{
  "name": "@cocrepo/schema",
  "version": "0.1.0",
  "description": "공유 검증 스키마 (프론트엔드/백엔드)",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build && tsc -p tsconfig.esm.json && node scripts/write-esm-package-json.mjs",
    "start:dev": "tsc --build --watch",
    "type-check": "tsc --noEmit",
    "type-check:prod": "tsc --noEmit",
    "format": "biome check --write .",
    "clean": "rm -rf dist && rm -rf node_modules",
    "lint": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs",
    "lint:fix": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --fix",
    "lint:prod": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --prod"
  },
  "dependencies": {
    "@cocrepo/constant": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "keywords": [
    "validation",
    "schema",
    "class-validator",
    "dto"
  ],
  "author": "cocrepo",
  "license": "ISC"
}
