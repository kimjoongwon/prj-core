{
	"extends": "@cocrepo/tsconfig/nestjs-package.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"tsBuildInfoFile": "./dist/.tsbuildinfo",
		"types": [
			"node"
		]
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"**/__tests__/**",
		"**/*.spec.ts"
	]
}
