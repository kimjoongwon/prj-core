{
  "extends": "@cocrepo/tsconfig/nestjs-package.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "useDefineForClassFields": false,
    "strictPropertyInitialization": false,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "references": [
    { "path": "../common-constant" },
    { "path": "../be-prisma" },
    { "path": "../be-decorator" },
    { "path": "../be-entity" },
    { "path": "../common-enum" },
    { "path": "../common-schema" },
    { "path": "../common-toolkit" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
