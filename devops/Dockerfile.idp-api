FROM node:24-alpine AS base

ARG PNPM_VERSION=10.16.0
ARG TURBO_VERSION=2.8.14
ENV PNPM_HOME=/usr/local/bin
ENV PNPM_STORE_DIR=/pnpm/store

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
RUN apk add --update --no-cache libc6-compat && rm -rf /var/cache/apk/*
RUN pnpm add -g turbo@${TURBO_VERSION}

WORKDIR /app

FROM base AS setup

COPY . .
RUN turbo prune --scope=idp-api --docker

FROM base AS builder

COPY .gitignore .gitignore
WORKDIR /app
COPY --from=setup /app/out/json/ ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --store-dir /pnpm/store --frozen-lockfile --prefer-offline
COPY --from=setup /app/out/full/ ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    --mount=type=cache,id=turbo,target=/app/.turbo \
    pnpm exec turbo build

FROM node:24-alpine AS runner

WORKDIR /app
COPY --from=builder /app/ ./

ENV NODE_ENV=production
ENV APP_PORT=3007

EXPOSE 3007

CMD ["node", "apps/idp/api/dist/main.js"]
