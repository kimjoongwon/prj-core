FROM node:24-alpine AS base

ARG PNPM_VERSION=10.16.0
ENV PNPM_HOME=/usr/local/bin

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
RUN apk add --update --no-cache libc6-compat && rm -rf /var/cache/apk/*
RUN pnpm add -g turbo

WORKDIR /app

FROM base AS setup

COPY . .
RUN turbo prune --scope=idp-api --docker

FROM base AS builder

COPY .gitignore .gitignore
WORKDIR /app
COPY --from=setup /app/out/full/ ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install
COPY turbo.json turbo.json
# idp-api는 nest webpack 설정에 RunScriptWebpackPlugin이 있어 build 단계에서 프로세스가 유지될 수 있음
# 의존 워크스페이스만 turbo로 빌드하고, 앱 자체는 webpack 비활성 빌드로 종료 가능하게 처리
RUN turbo build --filter=idp-api^...
RUN pnpm --filter idp-api exec tsc -p tsconfig.build.json

FROM node:24-alpine AS runner

WORKDIR /app
COPY --from=builder /app/ ./

ENV NODE_ENV=production
ENV APP_PORT=3007

EXPOSE 3007

CMD ["node", "apps/idp/api/dist/main.js"]
