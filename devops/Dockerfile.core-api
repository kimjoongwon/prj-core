# ============================================================================
# 🏗️ BASE STAGE: 기본 환경 설정
# ============================================================================
# Node.js 24 Alpine Linux 기반 이미지 사용 (경량화된 리눅스 배포판)
FROM node:24.21.0-alpine3.24 AS base

# 📦 검증된 PNPM과 Turbo 버전을 인자로 받아서 설정
ARG PNPM_VERSION=10.34.5
ARG TURBO_VERSION=2.9.14

# 🔧 PNPM 홈 디렉토리를 전역 bin 경로로 설정
ENV PNPM_HOME=/usr/local/bin

# 📋 Node.js Corepack을 활성화하여 PNPM 패키지 매니저 설정
# - corepack enable: Node.js 패키지 매니저 관리 도구 활성화
# - corepack prepare: 특정 버전의 PNPM 준비 및 활성화
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# 🛠️ Alpine Linux 시스템 종속성 설치
# - libc6-compat: GNU libc 호환성 라이브러리 (Node.js 네이티브 모듈 호환성)
# - apk 캐시 정리로 이미지 크기 최적화
RUN apk add --update --no-cache libc6-compat && rm -rf /var/cache/apk/*

# 🎯 빌드에 필요한 Turbo만 설치
RUN pnpm add -g turbo@${TURBO_VERSION}

# 📂 작업 디렉토리 설정
WORKDIR /app

# ============================================================================
# 🔍 SETUP STAGE: 종속성 분석 및 프로젝트 구조 최적화
# ============================================================================
FROM base AS setup

# 📋 전체 프로젝트 파일 복사
COPY . .

# 🎯 Turbo를 사용해 서버 앱만을 위한 최소한의 종속성 트리 생성
# - core-api: 서버 앱과 관련된 패키지만 추출
# - --docker: Docker 최적화된 출력 구조 생성
RUN turbo prune core-api --docker

# @cocrepo/constant의 route catalog 생성 계약에 필요한 원본만 prune 결과에 보존
RUN mkdir -p "/app/out/full/apps/admin/web/src/app/(authenticated)/(admin)" && \
    cp -R "/app/apps/admin/web/src/app/(authenticated)/(admin)/." \
    "/app/out/full/apps/admin/web/src/app/(authenticated)/(admin)/"

# ============================================================================
# 🏭 BUILDER STAGE: 애플리케이션 빌드
# ============================================================================
FROM base AS builder

# 📋 Git 무시 파일 복사 (빌드 과정에서 필요)
COPY .gitignore .gitignore

# 📂 작업 디렉토리 재설정
WORKDIR /app

# 📦 Setup 단계에서 최적화된 파일 구조 복사
# - /app/out/full/: Turbo prune으로 생성된 최적화된 프로젝트 구조
COPY --from=setup /app/out/json/ ./

# 🚀 종속성 설치 (캐시 마운트로 성능 최적화)
# - mount=type=cache: PNPM 스토어를 캐시로 마운트하여 재빌드 시 속도 향상
# - id=pnpm: 캐시 식별자
# - target=/pnpm/store: PNPM 캐시 저장소 경로
# - --store-dir /pnpm/store: pnpm 스토어를 캐시 마운트 경로와 일치시켜 캐시 적중률 유지
# - --prefer-offline: 캐시된 패키지를 우선 사용해 네트워크 조회 축소
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --store-dir /pnpm/store --prefer-offline

COPY --from=setup /app/out/full/ ./

# 📋 Turbo 설정 파일 복사
COPY turbo.json turbo.json

# 📂 루트 디렉토리로 다시 이동
WORKDIR /app

# 🏗️ Turbo를 사용한 프로젝트 빌드
# - 모든 관련 패키지와 종속성을 최적화된 순서로 빌드
# - nest build가 TypeScript 컴파일을 포함하므로 별도 type-check 단계 생략
# - /app/.turbo 캐시 마운트로 Turbo 작업 캐시를 재사용해 재빌드 시간 단축
# - --concurrency=2: 병렬 빌드로 빌드 시간 단축
RUN --mount=type=cache,id=turbo,target=/app/.turbo pnpm exec turbo build --concurrency=2 --filter=core-api...

# 운영 앱과 production 의존성만 독립 실행 가능한 산출물로 구성
# (--legacy: inject-workspace-packages=true 미설정 워크스페이스에서는 유일한 방식.
#  legacy는 dev 의존성(prisma/typescript) 일부까지 끌어들일 수 있어 아래 검증은
#  런타임 공격 표면 요소로 한정한다.)
RUN pnpm --filter core-api deploy --prod --legacy /app/deploy

# 운영 산출물의 필수 native/runtime 의존성과 공격 표면 축소 계약 검증
# (prisma/typescript는 마이그레이션 계약상 이미지가 워크스페이스 도구를 포함하므로
#  배제 대상에서 제외하고, 런타임에 없어야 하는 패키지만 검사한다.)
RUN cd /app/deploy && \
    node --check dist/main.js && \
    NODE_ENV=production node -e "require('bcrypt'); require('@cocrepo/constant'); require('@cocrepo/prisma'); require('@cocrepo/type'); require('@cocrepo/toolkit'); require('./dist/module/app.module.js')" && \
    NODE_ENV=production ENABLE_NEST_DEVTOOLS=true node -e "const devtools=require('./dist/module/devtools.module.js'); if(devtools.isNestDevtoolsEnabled()) throw new Error('Nest Devtools must stay disabled in production');" && \
    node -e "const fs=require('node:fs'); const forbidden=['@nestjs+devtools-integration@','@nestjs+websockets@','@nestjs+platform-socket.io@','socket.io@']; const packages=fs.readdirSync('node_modules/.pnpm'); const found=packages.filter((name)=>forbidden.some((prefix)=>name.startsWith(prefix))); if(found.length) throw new Error('Forbidden production packages: '+found.join(', '));"

# ============================================================================
# 🚀 PRODUCTION STAGE: 운영 환경 컨테이너
# ============================================================================
FROM node:24.21.0-alpine3.24 AS runner

# 📂 작업 디렉토리 설정
WORKDIR /app

# PreSync 마이그레이션 Job 계약: /app/packages/be-prisma에서
# node_modules/.bin/prisma, tsx를 실행하므로 워크스페이스 의존성 구조를 보존한다.
COPY --from=builder --chown=node:node /app/node_modules/ ./node_modules/
COPY --from=builder --chown=node:node /app/packages/ ./packages/
COPY --from=builder --chown=node:node /app/package.json /app/pnpm-workspace.yaml ./

# 앱 자체는 독립 deploy 산출물에서 실행한다 (마이그레이션용 루트 node_modules와
# 경로 충돌하지 않도록 /app/runtime 하위에 둔다).
COPY --from=builder --chown=node:node /app/deploy/ /app/runtime/

WORKDIR /app/runtime

# 🌐 운영 환경 변수 설정
ENV NODE_ENV=production
ENV APP_PORT=3006

# 🌐 애플리케이션 포트 노출
EXPOSE 3006

USER node

# 🎯 Node 애플리케이션 단일 프로세스 실행
CMD ["node", "dist/main.js"]
