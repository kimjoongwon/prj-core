# ============================================================================
# 🏗️ BASE STAGE: 기본 환경 설정
# ============================================================================
# Node.js 24 Alpine Linux 기반 이미지 사용 (경량화된 리눅스 배포판)
FROM node:24.21.0-alpine3.24@sha256:be80f76cf40ec8e42b9bec49f60a55e0660f30af58d3e5a25530785b30ea67e2 AS base

# 📦 검증된 PNPM과 Turbo 버전을 인자로 받아서 설정
ARG PNPM_VERSION=10.34.5
ARG TURBO_VERSION=2.9.14

# 🔧 PNPM 홈 디렉토리를 전역 bin 경로로 설정
ENV PNPM_HOME=/usr/local/bin

# 📋 Node.js Corepack을 활성화하여 PNPM 패키지 매니저 설정
# - corepack enable: Node.js 패키지 매니저 관리 도구 활성화
# - corepack prepare: 특정 버전의 PNPM 준비 및 활성화
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# 🛠️ Alpine Linux 시스템 종속성 설치
# - libc6-compat: GNU libc 호환성 라이브러리 (Node.js 네이티브 모듈 호환성)
# - apk 캐시 정리로 이미지 크기 최적화
RUN apk add --update --no-cache libc6-compat && rm -rf /var/cache/apk/*

# 🎯 빌드에 필요한 Turbo만 설치
RUN pnpm add -g turbo@${TURBO_VERSION}

# 📂 작업 디렉토리 설정
WORKDIR /app

# ============================================================================
# 🔍 SETUP STAGE: 종속성 분석 및 프로젝트 구조 최적화
# ============================================================================
FROM base AS setup

# 📋 전체 프로젝트 파일 복사
COPY . .

# 🎯 Turbo를 사용해 서버 앱만을 위한 최소한의 종속성 트리 생성
# - core-api: 서버 앱과 관련된 패키지만 추출
# - --docker: Docker 최적화된 출력 구조 생성
RUN turbo prune core-api --docker

# @cocrepo/constant의 route catalog 생성 계약에 필요한 원본만 prune 결과에 보존
RUN mkdir -p "/app/out/full/apps/admin/web/src/app/(authenticated)/(admin)" && \
    cp -R "/app/apps/admin/web/src/app/(authenticated)/(admin)/." \
    "/app/out/full/apps/admin/web/src/app/(authenticated)/(admin)/"

# ============================================================================
# 🏭 BUILDER STAGE: 애플리케이션 빌드
# ============================================================================
FROM base AS builder

# 📋 Git 무시 파일 복사 (빌드 과정에서 필요)
COPY .gitignore .gitignore

# 📂 작업 디렉토리 재설정
WORKDIR /app

# 📦 Setup 단계에서 최적화된 파일 구조 복사
# - /app/out/full/: Turbo prune으로 생성된 최적화된 프로젝트 구조
COPY --from=setup /app/out/json/ ./

# 🚀 종속성 설치 (영속 캐시)
# - /cache: 빌드 잡이 podman build -v로 PVC의 영속 캐시를 마운트 (buildah의 --mount=type=cache는 빌드 간 유지되지 않음)
# - --prefer-offline: 캐시된 패키지를 우선 사용해 네트워크 조회 축소
RUN pnpm install --frozen-lockfile --store-dir /cache/pnpm-store --prefer-offline

COPY --from=setup /app/out/full/ ./

# 📋 Turbo 설정 파일 복사
COPY turbo.json turbo.json

# 📂 루트 디렉토리로 다시 이동
WORKDIR /app

# 🏗️ Turbo를 사용한 프로젝트 빌드
# - 모든 관련 패키지와 의존성을 최적화된 순서로 빌드
# - nest build가 TypeScript 컴파일을 포함하므로 별도 type-check 단계 생략
# - --cache-dir=/cache/turbo: 영속 캐시로 변경 없는 워크스페이스 패키지 재빌드 회피
# - --concurrency=2: 병렬 빌드로 빌드 시간 단축
RUN pnpm exec turbo build --concurrency=2 --cache-dir=/cache/turbo --filter=core-api...

# ============================================================================
# 🚀 PRODUCTION STAGE: 운영 환경 컨테이너
# ============================================================================
FROM node:24.21.0-alpine3.24@sha256:be80f76cf40ec8e42b9bec49f60a55e0660f30af58d3e5a25530785b30ea67e2 AS runner

# 📂 작업 디렉토리 설정
WORKDIR /app

# PreSync 마이그레이션 Job과 앱 실행 모두 워크스페이스 구조를 사용한다.
# (마이그레이션: /app/packages/be-prisma의 prisma/tsx.
#  앱: deploy 산출물 단독 실행은 중복 @nestjs 패키지 해석으로 DI가 깨질 수 있어
#  워크스페이스 node_modules에서 실행하는 기존 운영 형태를 유지한다.)
COPY --from=builder --chown=node:node /app/node_modules/ ./node_modules/
COPY --from=builder --chown=node:node /app/packages/ ./packages/
COPY --from=builder --chown=node:node /app/apps/ ./apps/
COPY --from=builder --chown=node:node /app/package.json /app/pnpm-workspace.yaml ./

# 배포되는 워크스페이스 트리 그대로에서 런타임 계약을 검증한다.
# - 검증은 실제 실행 디렉토리(/app/apps/core/api) 기준으로 수행한다.
# - 금지 패키지는 "이미지에 존재하는가"가 아니라 "앱이 require로 해석할 수 있는가"로
#   검사한다. 워크스페이스 node_modules는 마이그레이션 계약상 dev 도구를 포함하므로
#   디렉터리 이름 스캔은 배포 트리에 적용할 수 없다.
# - @nestjs/devtools-integration은 앱 devDependency로 존재하므로 런타임
#   가드(isNestDevtoolsEnabled)로 비활성을 검증한다.
RUN cd /app/apps/core/api && \
    node --check dist/main.js && \
    NODE_ENV=production node -e "require('bcrypt'); require('@cocrepo/constant'); require('@cocrepo/prisma'); require('@cocrepo/type'); require('@cocrepo/toolkit'); require('./dist/module/app.module.js')" && \
    NODE_ENV=production ENABLE_NEST_DEVTOOLS=true node -e "const devtools=require('./dist/module/devtools.module.js'); if(devtools.isNestDevtoolsEnabled()) throw new Error('Nest Devtools must stay disabled in production');" && \
    node -e "const forbidden=['socket.io','@nestjs/websockets','@nestjs/platform-socket.io']; for (const packageName of forbidden) { let resolvedPath=null; try { resolvedPath=require.resolve(packageName); } catch {} if (resolvedPath) throw new Error('Forbidden runtime package resolvable from app: '+packageName+' -> '+resolvedPath); }"

WORKDIR /app

# 🌐 운영 환경 변수 설정
ENV NODE_ENV=production
ENV APP_PORT=3006

# 🌐 애플리케이션 포트 노출
EXPOSE 3006

USER node

# 🎯 Node 애플리케이션 단일 프로세스 실행 (워크스페이스 내 앱 경로)
CMD ["node", "apps/core/api/dist/main.js"]
