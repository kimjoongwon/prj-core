FROM docker.io/library/node:24.22.2-alpine3.24@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85 AS base

ARG PNPM_VERSION=10.34.5
ARG TURBO_VERSION=2.9.14
ENV PNPM_HOME=/usr/local/bin
ENV PNPM_STORE_DIR=/pnpm/store

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
RUN apk add --update --no-cache libc6-compat && rm -rf /var/cache/apk/*
RUN pnpm add -g turbo@${TURBO_VERSION}

WORKDIR /app

FROM base AS setup

COPY . .
RUN turbo prune --scope=cover-letter-web --docker

FROM base AS builder

WORKDIR /app
COPY --from=setup /app/out/json/ ./
# 부모가 갱신한 lockfile과 pruned workspace 설치 결과를 동일하게 유지한다.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --store-dir /pnpm/store --frozen-lockfile --prefer-offline
COPY --from=setup /app/out/full/ ./
RUN --mount=type=cache,id=turbo,target=/app/.turbo \
    pnpm exec turbo build --cache-dir=/app/.turbo --filter=cover-letter-web...

FROM docker.io/library/nginx:1.31.8-alpine3.24@sha256:785835ea65db4bba6f021acc0f3be91b0fef76a53fe41f8588c6698d2aed0606 AS runner

COPY devops/nginx.cover-letter-web.conf /etc/nginx/nginx.conf
COPY --from=builder /app/apps/cover-letter/web/dist /usr/share/nginx/html

USER 101:101

EXPOSE 8080

ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
