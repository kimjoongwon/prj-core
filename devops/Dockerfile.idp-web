FROM node:24.22.0-alpine3.24@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS base

ARG PNPM_VERSION=10.34.5
ARG TURBO_VERSION=2.9.14
ENV PNPM_HOME=/usr/local/bin
ENV PNPM_STORE_DIR=/pnpm/store

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
RUN apk add --update --no-cache libc6-compat && rm -rf /var/cache/apk/*
RUN pnpm add -g turbo@${TURBO_VERSION}

WORKDIR /app

FROM base AS setup

COPY . .
RUN turbo prune --scope=idp-web --docker

FROM base AS builder
ENV NODE_OPTIONS="--max-old-space-size=2048"

WORKDIR /app
COPY --from=setup /app/out/json/ ./
# lockfile이 정합하므로 frozen-lockfile 사용 (전체 재해석 방지로 메모리 절약)
# /cache: 빌드 잡이 podman build -v로 PVC의 영속 캐시를 마운트
RUN pnpm install --store-dir /cache/pnpm-store --frozen-lockfile --prefer-offline
COPY --from=setup /app/out/full/ ./
RUN pnpm exec turbo build --concurrency=1 --cache-dir=/cache/turbo --filter=idp-web...

FROM node:24.22.0-alpine3.24@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS runner

WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/idp/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/idp/web/.next/static ./apps/idp/web/.next/static
# standalone 출력은 public/을 포함하지 않으므로 런타임 이미지에 별도 복사가 필요하다.
# 없으면 인증 화면의 /brand/plate-mark.svg 등 정적 자산이 404로 깨진다.
COPY --from=builder --chown=nextjs:nodejs /app/apps/idp/web/public ./apps/idp/web/public

ENV NODE_ENV=production
ENV PORT=3008
ENV HOSTNAME=0.0.0.0

USER nextjs

EXPOSE 3008

CMD ["node", "apps/idp/web/server.js"]
