def DEPLOYMENT_BRANCHES = ['main', 'stg']
if (env.CHANGE_ID || !DEPLOYMENT_BRANCHES.contains(env.BRANCH_NAME) || env.TRUSTED_DEPLOYMENT != 'true') {
    error('배포는 보호 브랜치의 승인된 내부 job에서만 실행할 수 있습니다.')
}
def HARBOR_REGISTRY = env.HARBOR_REGISTRY
def HARBOR_CREDENTIAL_ID = env.HARBOR_CREDENTIAL_ID
def CONFIGURED_GITOPS_UPDATE_JOB = env.GITOPS_UPDATE_JOB
if (!HARBOR_REGISTRY || !HARBOR_CREDENTIAL_ID || !CONFIGURED_GITOPS_UPDATE_JOB) {
    error('내부 배포 설정(HARBOR_REGISTRY, HARBOR_CREDENTIAL_ID, GITOPS_UPDATE_JOB)이 필요합니다.')
}

// Buzz #cicd 채널 알림 (게이트웨이: prj-devops docs/buzz-ci-integration.md)
// - 메시지 줄 배열을 받아 JSON으로 게이트웨이에 POST한다(마지막에 Jenkins 빌드 링크 추가).
// - BUZZ_NOTIFY_URL이 잡에 주입되지 않으면 조용히 건너뛴다.
// - 알림은 best-effort: 게이트웨이 장애가 빌드 결과에 영향을 주지 않는다.
def buzzNotify(List messageLines) {
    if (!env.BUZZ_NOTIFY_URL) {
        echo '[buzz] BUZZ_NOTIFY_URL 미설정 — 알림 생략'
        return
    }
    def credId = env.BUZZ_NOTIFY_CREDENTIAL_ID ?: 'buzz-notify-token'
    def lines = messageLines + ["Jenkins: ${env.BUILD_URL}"]
    writeFile file: '.buzz-notify.json', text: groovy.json.JsonOutput.toJson([content: lines.join('\n')])
    try {
        withCredentials([string(credentialsId: credId, variable: 'BUZZ_TOKEN')]) {
            sh '''#!/usr/bin/env bash
                set -uo pipefail
                # set +x: 토큰 평문 노출 차단
                set +x
                if command -v curl >/dev/null 2>&1; then
                    curl -fsS -m 10 -X POST "${BUZZ_NOTIFY_URL}/send" \\
                        -H "Authorization: Bearer ${BUZZ_TOKEN}" \\
                        -H 'Content-Type: application/json' \\
                        --data-binary @.buzz-notify.json \\
                        || echo '[buzz] 알림 전송 실패 (curl, 무시됨)'
                elif command -v wget >/dev/null 2>&1; then
                    wget -q -O /dev/null \\
                        --header="Authorization: Bearer ${BUZZ_TOKEN}" \\
                        --header='Content-Type: application/json' \\
                        --post-file=.buzz-notify.json \\
                        "${BUZZ_NOTIFY_URL}/send" \\
                        || echo '[buzz] 알림 전송 실패 (wget, 무시됨)'
                else
                    echo '[buzz] curl/wget 없음 — 알림 생략'
                fi
            '''
        }
    } finally {
        sh 'rm -f .buzz-notify.json || true'
    }
}

podTemplate(
    volumes: [
        persistentVolumeClaim(
            claimName: 'container-builder-pvc',
            mountPath: '/var/lib/containers'
        )
    ],
    containers: [
        containerTemplate(
            name: 'podman',
            image: 'quay.io/podman/stable:v5.8.4@sha256:3c99be9108dacd2b25d2f343c91386abd14a5ceaca68aa3e8d7f6ee2ebd50a16',
            alwaysPullImage: false,
            privileged: true,
            ttyEnabled: true,
            command: 'cat',
            resourceLimitMemory: '3Gi',
            resourceRequestMemory: '2Gi',
            resourceLimitCpu: '1500m',
            // CPU request는 미지정 시 limit과 같게 잡혀 PVC 고정 노드(node-02)에서 스케줄링이 막히므로 명시적으로 낮춤
            resourceRequestCpu: '300m',
        )
    ]
) {
    node(POD_LABEL) {
        // 브랜치에 따른 환경 설정
        def ENV_NAME = env.BRANCH_NAME == 'main' ? 'prod' : 'stg'
        // SHA-12 immutable tag: 이미지-빌드커밋 1:1 추적. 실제 값은 checkout 후에 확정한다.
        def IMAGE_TAG = ''
        def PUSH_LATEST = ENV_NAME != 'prod'
        def IMAGE_PATH = "${HARBOR_REGISTRY}/${ENV_NAME}/admin-web"
        def IMAGE_TAG_ARGS = []
        def CLEANUP_IMAGES = []
        def GITOPS_APP = 'admin-web'
        def GITOPS_UPDATE_JOB = CONFIGURED_GITOPS_UPDATE_JOB

        try {
            stage('Checkout') {
                def scmVars = checkout scm
                def commitSha = scmVars.GIT_COMMIT ?: env.GIT_COMMIT ?: ''
                if (commitSha.length() < 12) {
                    error("GIT_COMMIT을 확인할 수 없어 SHA 이미지 태그를 만들 수 없습니다: '${commitSha}'")
                }
                IMAGE_TAG = commitSha.substring(0, 12)
                IMAGE_TAG_ARGS = ["-t ${IMAGE_PATH}:${IMAGE_TAG}"]
                CLEANUP_IMAGES = ["${IMAGE_PATH}:${IMAGE_TAG}"]
                if (PUSH_LATEST) {
                    IMAGE_TAG_ARGS << "-t ${IMAGE_PATH}:latest"
                    CLEANUP_IMAGES << "${IMAGE_PATH}:latest"
                }
            }

            stage('Build and Push Image') {
                container('podman') {
                    // Podman 상태 확인 및 초기화
                    sh 'podman info || echo "Podman initializing..."'

                    withCredentials([
                        usernamePassword(
                            credentialsId: HARBOR_CREDENTIAL_ID,
                            usernameVariable: 'HARBOR_USERNAME',
                            passwordVariable: 'HARBOR_PASSWORD'
                        )
                    ]) {
                        // Harbor Registry 로그인 (TLS 검증 포함)
                        sh """
                            # set +x: xtrace로 인한 비밀번호 평문 노출 차단
                            set +x; echo \$HARBOR_PASSWORD | podman login \\
                                -u \$HARBOR_USERNAME \\
                                --password-stdin \\
                                --tls-verify=true \\
                                ${HARBOR_REGISTRY}
                        """

                        // Podman 이미지 빌드 (멀티스테이지 최적화)
                        sh """
                            podman build \\
                                --format=docker \\
                                --layers \\
                                --pull=newer \\
                                -v /var/lib/containers/build-cache:/cache \\
                                -f ./devops/Dockerfile.admin-web \\
                                ${IMAGE_TAG_ARGS.join(' \\\n                                ')} \\
                                .
                        """

                        // 이미지 푸시 (gzip 레벨 6으로 푸시 시간 단축)
                        sh """
                            podman push \\
                                --compression-format=gzip \\
                                --compression-level=3 \\
                                ${IMAGE_PATH}:${IMAGE_TAG}
                        """

                        if (PUSH_LATEST) {
                            sh """
                                podman push \\
                                    --compression-format=gzip \\
                                    --compression-level=3 \\
                                    ${IMAGE_PATH}:latest
                            """
                        }

                        // 로컬 이미지 정리 (디스크 공간 절약)
                        sh """
                            podman rmi \\
                                ${CLEANUP_IMAGES.join(' \\\n                                ')} || true
                        """
                    }
                }
            }

            stage('Trigger GitOps Update Job') {
                if (ENV_NAME == 'prod') {
                    catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                        def gitCommit = env.GIT_COMMIT ?: ''
                        build(
                            job: GITOPS_UPDATE_JOB,
                            wait: false,
                            parameters: [
                                string(name: 'APP_NAME', value: GITOPS_APP),
                                string(name: 'IMAGE_TAG', value: IMAGE_TAG),
                                string(name: 'DEPLOY_ENV', value: 'prod'),
                                string(name: 'SOURCE_BUILD_URL', value: env.BUILD_URL ?: ''),
                                string(name: 'SOURCE_COMMIT', value: gitCommit),
                            ]
                        )
                        echo "Triggered ${GITOPS_UPDATE_JOB} with APP_NAME=${GITOPS_APP}, IMAGE_TAG=${IMAGE_TAG}"
                    }
                } else {
                    echo "Skip GitOps update trigger for ENV=${ENV_NAME}"
                }
            }

        } catch (Exception e) {
            currentBuild.result = 'FAILURE'
            throw e
        } finally {
            // Buzz #cicd 빌드 알림 — best-effort, 알림 오류가 빌드 결과를 덮지 않게 try/catch로 감싼다
            try {
                container('podman') {
                    def status = currentBuild.currentResult
                    def emoji = status == 'SUCCESS' ? '✅' : (status == 'FAILURE' ? '❌' : '⚠️')
                    def resultText = status == 'SUCCESS' ? '빌드 성공' : (status == 'FAILURE' ? '빌드 실패' : status)
                    buzzNotify([
                        "${emoji} **${GITOPS_APP}** ${resultText}",
                        "이미지: \`${IMAGE_PATH}:${IMAGE_TAG ?: 'n/a'}\`",
                        "커밋: \`${env.GIT_COMMIT ?: 'n/a'}\`",
                    ])
                }
            } catch (Exception notifyErr) {
                echo "[buzz] 알림 단계 오류 (무시됨): ${notifyErr.message}"
            }
        }
    }
}
