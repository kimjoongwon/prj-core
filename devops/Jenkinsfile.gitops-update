// Buzz #cicd 채널 알림 (게이트웨이: prj-devops docs/buzz-ci-integration.md)
// - 메시지 줄 배열을 받아 JSON으로 게이트웨이에 POST한다(마지막에 Jenkins 빌드 링크 추가).
// - BUZZ_NOTIFY_URL이 잡에 주입되지 않으면 조용히 건너뛴다.
// - 알림은 best-effort: 게이트웨이 장애가 빌드 결과에 영향을 주지 않는다.
def buzzNotify(List messageLines, Map opts = [:]) {
    if (!env.BUZZ_NOTIFY_URL) {
        echo '[buzz] BUZZ_NOTIFY_URL 미설정 — 알림 생략'
        return ''
    }
    def credId = env.BUZZ_NOTIFY_CREDENTIAL_ID ?: 'buzz-notify-token'
    def lines = messageLines + ["Jenkins: ${env.BUILD_URL}"]
    def payload = [content: lines.join('\n')]
    if (opts.replyTo) { payload.replyTo = opts.replyTo }
    if (opts.linkKey) { payload.linkKey = opts.linkKey }
    if (opts.mentions) { payload.mentions = opts.mentions }
    writeFile file: '.buzz-notify.json', text: groovy.json.JsonOutput.toJson(payload)
    try {
        withCredentials([string(credentialsId: credId, variable: 'BUZZ_TOKEN')]) {
            sh '''#!/usr/bin/env bash
                set -uo pipefail
                # set +x: 토큰 평문 노출 차단
                set +x
                if command -v curl >/dev/null 2>&1; then
                    curl -fsS -m 10 -X POST "${BUZZ_NOTIFY_URL}/send" \\
                        -H "Authorization: Bearer ${BUZZ_TOKEN}" \\
                        -H 'Content-Type: application/json' \\
                        --data-binary @.buzz-notify.json \\
                        -o .buzz-notify-resp.json \\
                        || echo '[buzz] 알림 전송 실패 (curl, 무시됨)'
                elif command -v wget >/dev/null 2>&1; then
                    wget -q -O /dev/null \\
                        --header="Authorization: Bearer ${BUZZ_TOKEN}" \\
                        --header='Content-Type: application/json' \\
                        --post-file=.buzz-notify.json \\
                        -O .buzz-notify-resp.json \\
                        "${BUZZ_NOTIFY_URL}/send" \\
                        || echo '[buzz] 알림 전송 실패 (wget, 무시됨)'
                else
                    echo '[buzz] curl/wget 없음 — 알림 생략'
                fi
            '''
        }
    } finally {
        sh 'rm -f .buzz-notify.json || true'
    }
    def eventId = ''
    try {
        if (fileExists('.buzz-notify-resp.json')) {
            def resp = new groovy.json.JsonSlurperClassic().parseText(readFile('.buzz-notify-resp.json'))
            eventId = (resp?.event?.event_id) ?: (resp?.event?.id) ?: ''
        }
    } catch (Exception e) {
        echo "[buzz] 알림 응답 파싱 실패 (무시됨): ${e.message}"
    }
    sh 'rm -f .buzz-notify-resp.json || true'
    return eventId
}

// 빌드 실패 알림에 멘션할 ZCode 공개키 (buzz #cicd 멤버 — hex, 게이트웨이 --mention)
def ZCODE_HEX = '15d01a6721298f5fe8f6b4180cb6db42230a9e04127795650eecb7531152e991'

// 알림용 소요시간 포맷 (ms → "1시간 2분" / "3분 4초" / "45초")
def fmtDur(long ms) {
    long s = Math.max(ms, 0L).intdiv(1000L)
    if (s < 60L) { return "${s}초" }
    long m = s.intdiv(60L)
    s %= 60L
    if (m < 60L) { return "${m}분 ${s}초" }
    return "${m.intdiv(60L)}시간 ${m % 60L}분"
}

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    parameters {
        choice(
            name: 'APP_NAME',
            choices: ['core-api', 'admin-web', 'proposal-web', 'spring-api', 'tool-storybook', 'idp-api', 'idp-web'],
            description: 'GitOps values-prod.yaml image.tag update target app'
        )
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Target image tag (빌드 커밋 SHA 앞 12자 기준)'
        )
        choice(
            name: 'DEPLOY_ENV',
            choices: ['prod'],
            description: 'Deploy environment'
        )
        string(
            name: 'SOURCE_BUILD_URL',
            defaultValue: '',
            description: 'Optional upstream build URL'
        )
        string(
            name: 'SOURCE_COMMIT',
            defaultValue: '',
            description: 'Optional upstream source commit SHA'
        )
        string(
            name: 'TRUSTED_DEPLOYMENT',
            defaultValue: 'true',
            description: '내부 배포 job 승인 플래그 (이 job이 신뢰 경로 자체)'
        )
        string(
            name: 'GITOPS_REPOSITORY_URL',
            defaultValue: 'https://github.com/kimjoongwon/prj-devops.git',
            description: '범프 스크립트가 있는 저장소 (prj-devops)'
        )
        string(
            name: 'DEPLOY_REPOSITORY_URL',
            defaultValue: 'https://github.com/kimjoongwon/prj-deploy.git',
            description: '배포 상태(이미지 태그) 저장소 — 범프 커밋 대상 (prj-deploy)'
        )
        string(
            name: 'GITOPS_DEPLOY_CREDENTIAL_ID',
            defaultValue: 'prj-deploy-deploy-key',
            description: 'prj-deploy push 전용 deploy key (Secret text, PEM)'
        )
        string(
            name: 'BUZZ_NOTIFY_URL',
            defaultValue: 'http://buzz-gateway.devops-tools.svc.cluster.local',
            description: 'Buzz #cicd 알림 게이트웨이 URL (값을 비우면 알림 끔 - prj-devops docs/buzz-ci-integration.md)'
        )
        string(
            name: 'SOURCE_BUZZ_EVENT_ID',
            defaultValue: '',
            description: '업스트림 빌드 알림의 buzz 이벤트 ID — 범프 알림을 같은 스레드로 묶는다'
        )
    }

    environment {
        GITOPS_REPO = "${env.GITOPS_REPOSITORY_URL}"
        DEPLOY_REPO = "${env.DEPLOY_REPOSITORY_URL}"
        GITOPS_BRANCH = 'main'
        GITOPS_DIR = 'prj-devops-gitops'
        DEPLOY_DIR = 'prj-deploy-gitops'
    }

    stages {
        stage('Update GitOps Tag') {
            steps {
                script {
                    if (env.CHANGE_ID || env.TRUSTED_DEPLOYMENT != 'true') {
                        error('GitOps 변경은 승인된 내부 배포 job에서만 실행할 수 있습니다.')
                    }
                    if (!env.GITOPS_REPOSITORY_URL?.trim() || !env.DEPLOY_REPOSITORY_URL?.trim() || !env.GITOPS_DEPLOY_CREDENTIAL_ID?.trim()) {
                        error('GITOPS_REPOSITORY_URL / DEPLOY_REPOSITORY_URL / GITOPS_DEPLOY_CREDENTIAL_ID 내부 설정이 필요합니다.')
                    }
                    if (!params.IMAGE_TAG?.trim()) {
                        error('IMAGE_TAG parameter is required.')
                    }
                }

                withCredentials([
                    string(
                        credentialsId: env.GITOPS_DEPLOY_CREDENTIAL_ID,
                        variable: 'DEPLOY_SSH_KEY'
                    )
                ]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        set +x

                        KEYFILE="${PWD}/.prj-deploy-deploy-key"
                        trap 'rm -f "${KEYFILE}"' EXIT

                        rm -rf "${GITOPS_DIR}" "${DEPLOY_DIR}"
                        # 두 저장소 모두 공개라 익명으로 클론. push만 prj-deploy 전용 deploy key로
                        # (2026-09-27 CI 권한 축소 — github-app-credential은 잡 정의의 prj-core 체크아웃에만 사용)
                        git clone --depth 5 --branch "${GITOPS_BRANCH}" "${GITOPS_REPO}" "${GITOPS_DIR}"
                        git clone --depth 5 --branch "${GITOPS_BRANCH}" "${DEPLOY_REPO}" "${DEPLOY_DIR}"

                        printf '%s\\n' "${DEPLOY_SSH_KEY}" > "${KEYFILE}"
                        chmod 600 "${KEYFILE}"
                        # push URL은 DEPLOY_REPOSITORY_URL에서 유도한다 — 하드코딩하면
                        # 파라미터와 실제 push 대상이 어긋난다. https GitHub URL이
                        # 아니면 유도 실패로 즉시 중단한다.
                        normalized_deploy_repo="$(printf %s "${DEPLOY_REPO}" | sed -e 's:/*$::' -e 's:\\.git$::')"
                        deploy_repo_slug="$(printf %s "${normalized_deploy_repo}" | sed -nE 's#^https://github\\.com/([^/]+)/([^/]+)$#\\1/\\2#p')"
                        if [ -z "${deploy_repo_slug}" ]; then
                            echo "DEPLOY_REPOSITORY_URL에서 push URL을 유도할 수 없습니다: ${DEPLOY_REPO}" >&2
                            exit 1
                        fi
                        git -C "${DEPLOY_DIR}" remote set-url --push origin "git@github.com:${deploy_repo_slug}.git"
                        export GIT_SSH_COMMAND="ssh -i ${KEYFILE} -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"

                        # yq 부트스트랩: prj-devops에 install-yq.sh가 있을 때만 수행
                        # (양쪽 저장소 반영 순서와 무관하게 동작하도록 조건부)
                        if [ -f "${GITOPS_DIR}/scripts/jenkins/install-yq.sh" ]; then
                            bash "${GITOPS_DIR}/scripts/jenkins/install-yq.sh" --prefix "${PWD}/.tools"
                            export PATH="${PWD}/.tools/bin:${PATH}"
                        fi

                        bash "${GITOPS_DIR}/scripts/jenkins/update-gitops-image-tag.sh" \
                          --app "${APP_NAME}" \
                          --tag "${IMAGE_TAG}" \
                          --env "${DEPLOY_ENV}" \
                          --workdir "${PWD}/${DEPLOY_DIR}" \
                          --branch "${GITOPS_BRANCH}" \
                          --git-user-name "jenkins-bot" \
                          --git-user-email "jenkins-bot@onjitda.com" \
                          --push-retries 3
                    '''
                }
                // 범프 후 prj-deploy HEAD를 기록 — 배포완료 알림을 이 범프의 스레드로 묶는 키(linkKey)로 쓴다
                script {
                    env.DEPLOY_COMMIT_SHA = sh(
                        returnStdout: true,
                        script: 'git -C "${DEPLOY_DIR}" rev-parse HEAD 2>/dev/null || echo ""'
                    ).trim()
                }
            }
        }
    }

    post {
        always {
            script {
                def status = currentBuild.currentResult
                def emoji = status == 'SUCCESS' ? '✅' : (status == 'FAILURE' ? '❌' : '⚠️')
                def resultText = status == 'SUCCESS' ? '성공' : (status == 'FAILURE' ? '실패' : status)
                def lines = [
                    "${emoji} **${params.APP_NAME}** GitOps 범프 ${resultText}",
                    "이미지 태그: `${params.IMAGE_TAG ?: 'n/a'}` (env: ${params.DEPLOY_ENV})",
                    "소요: ${fmtDur((long) currentBuild.duration)}",
                ]
                if (params.SOURCE_BUILD_URL?.trim()) {
                    lines << "업스트림 빌드: ${params.SOURCE_BUILD_URL}"
                }
                // 스레드 묶기: 업스트림 빌드 알림에 reply-to, prj-deploy 커밋을 linkKey로 등록.
                // 실패 시 @ZCode 멘션으로 자동 진단 트리거.
                def opts = [:]
                if (params.SOURCE_BUZZ_EVENT_ID?.trim()) {
                    opts.replyTo = params.SOURCE_BUZZ_EVENT_ID
                }
                if (env.DEPLOY_COMMIT_SHA) {
                    opts.linkKey = env.DEPLOY_COMMIT_SHA
                }
                if (status != 'SUCCESS') {
                    opts.mentions = [ZCODE_HEX]
                }
                buzzNotify(lines, opts)
            }
            echo "GitOps update summary: APP=${params.APP_NAME}, TAG=${params.IMAGE_TAG}, ENV=${params.DEPLOY_ENV}"
            echo "Source build: ${params.SOURCE_BUILD_URL}"
            echo "Source commit: ${params.SOURCE_COMMIT}"
        }
    }
}
