FROM docker.io/library/node:24.22.1-alpine3.24@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS base

ARG PNPM_VERSION=10.34.5
ARG TURBO_VERSION=2.9.14
ENV PNPM_HOME=/usr/local/bin
ENV PNPM_STORE_DIR=/pnpm/store

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
RUN apk add --update --no-cache libc6-compat && rm -rf /var/cache/apk/*
RUN pnpm add -g turbo@${TURBO_VERSION}

WORKDIR /app

FROM base AS setup

COPY . .
RUN turbo prune --scope=dolmen-web --docker

FROM base AS builder

WORKDIR /app
COPY --from=setup /app/out/json/ ./
# turbo prune output can retain stale importer metadata for excluded workspaces,
# so Docker installs in the pruned tree must allow lockfile re-resolution.
RUN pnpm install --store-dir /cache/pnpm-store --no-frozen-lockfile --prefer-offline
COPY --from=setup /app/out/full/ ./
# Mirror runtime assets into the standalone tree so the minimal server can serve
# them without relying on extra runner-stage copies.
RUN sh -c 'pnpm exec turbo build --cache-dir=/cache/turbo --filter=dolmen-web... && \
      if [ -d apps/dolmen/web/.next/static ]; then \
        mkdir -p apps/dolmen/web/.next/standalone/apps/dolmen/web/.next && \
        cp -R apps/dolmen/web/.next/static apps/dolmen/web/.next/standalone/apps/dolmen/web/.next/static; \
      fi && \
      if [ -d apps/dolmen/web/public ]; then \
        mkdir -p apps/dolmen/web/.next/standalone/apps/dolmen/web && \
        cp -R apps/dolmen/web/public apps/dolmen/web/.next/standalone/apps/dolmen/web/public; \
      fi'

FROM docker.io/library/node:24.22.1-alpine3.24@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS runner

WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/dolmen/web/.next/standalone ./

ENV NODE_ENV=production
ENV PORT=3013
ENV HOSTNAME=0.0.0.0

USER nextjs

EXPOSE 3013

CMD ["node", "apps/dolmen/web/server.js"]
