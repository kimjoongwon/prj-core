podTemplate(
    volumes: [
        persistentVolumeClaim(
            claimName: 'container-builder-pvc',
            mountPath: '/var/lib/containers'
        )
    ],
    containers: [
        containerTemplate(
            name: 'podman',
            image: 'quay.io/podman/stable:v5.8.4@sha256:3c99be9108dacd2b25d2f343c91386abd14a5ceaca68aa3e8d7f6ee2ebd50a16',
            privileged: true,
            ttyEnabled: true,
            command: 'cat',
            resourceLimitMemory: '3Gi',
            resourceRequestMemory: '2Gi',
            resourceLimitCpu: '1500m',
            // CPU request는 미지정 시 limit과 같게 잡혀 PVC 고정 노드(node-02)에서 스케줄링이 막히므로 명시적으로 낮춤
            resourceRequestCpu: '300m',
        )
    ]
) {
    node(POD_LABEL) {
        def ENV_NAME = env.BRANCH_NAME == 'main' ? 'prod' : 'stg'
        // SHA-12 immutable tag: 이미지-빌드커밋 1:1 추적. 실제 값은 checkout 후에 확정한다.
        def IMAGE_TAG = ''
        def PUSH_LATEST = ENV_NAME != 'prod'
        def IMAGE_PATH = "harbor.onjitda.com/${ENV_NAME}/idp-web"
        def IMAGE_TAG_ARGS = []
        def CLEANUP_IMAGES = []
        def GITOPS_APP = 'idp-web'
        def GITOPS_UPDATE_JOB = env.GITOPS_UPDATE_JOB ?: '/gitops-prod-image-bump'

        try {
            stage('Checkout') {
                def scmVars = checkout scm
                def commitSha = scmVars.GIT_COMMIT ?: env.GIT_COMMIT ?: ''
                if (commitSha.length() < 12) {
                    error("GIT_COMMIT을 확인할 수 없어 SHA 이미지 태그를 만들 수 없습니다: '${commitSha}'")
                }
                IMAGE_TAG = commitSha.substring(0, 12)
                IMAGE_TAG_ARGS = ["-t ${IMAGE_PATH}:${IMAGE_TAG}"]
                CLEANUP_IMAGES = ["${IMAGE_PATH}:${IMAGE_TAG}"]
                if (PUSH_LATEST) {
                    IMAGE_TAG_ARGS << "-t ${IMAGE_PATH}:latest"
                    CLEANUP_IMAGES << "${IMAGE_PATH}:latest"
                }
            }

            stage('Build and Push Image') {
                container('podman') {
                    sh 'podman info || echo "Podman initializing..."'

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'harbor',
                            usernameVariable: 'HARBOR_USERNAME',
                            passwordVariable: 'HARBOR_PASSWORD'
                        )
                    ]) {
                        sh """
                            # set +x: xtrace로 인한 비밀번호 평문 노출 차단
                            set +x; echo \$HARBOR_PASSWORD | podman login \\
                                -u \$HARBOR_USERNAME \\
                                --password-stdin \\
                                --tls-verify=true \\
                                harbor.onjitda.com
                        """

                        sh """
                            podman build \\
                                --format=docker \\
                                --layers \\
                                --pull=newer \\
                                -v /var/lib/containers/build-cache:/cache \\
                                -f ./devops/Dockerfile.idp-web \\
                                ${IMAGE_TAG_ARGS.join(' \\\n                                ')} \\
                                .
                        """

                        sh """
                            podman push \\
                                --compression-format=gzip \\
                                --compression-level=3 \\
                                ${IMAGE_PATH}:${IMAGE_TAG}
                        """

                        if (PUSH_LATEST) {
                            sh """
                                podman push \\
                                    --compression-format=gzip \\
                                    --compression-level=3 \\
                                    ${IMAGE_PATH}:latest
                            """
                        }

                        sh """
                            podman rmi \\
                                ${CLEANUP_IMAGES.join(' \\\n                                ')} || true
                        """
                    }
                }
            }

            stage('Trigger GitOps Update Job') {
                if (ENV_NAME == 'prod') {
                    catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                        def gitCommit = env.GIT_COMMIT ?: ''
                        build(
                            job: GITOPS_UPDATE_JOB,
                            wait: false,
                            parameters: [
                                string(name: 'APP_NAME', value: GITOPS_APP),
                                string(name: 'IMAGE_TAG', value: IMAGE_TAG),
                                string(name: 'DEPLOY_ENV', value: 'prod'),
                                string(name: 'SOURCE_BUILD_URL', value: env.BUILD_URL ?: ''),
                                string(name: 'SOURCE_COMMIT', value: gitCommit),
                            ]
                        )
                        echo "Triggered ${GITOPS_UPDATE_JOB} with APP_NAME=${GITOPS_APP}, IMAGE_TAG=${IMAGE_TAG}"
                    }
                } else {
                    echo "Skip GitOps update trigger for ENV=${ENV_NAME}"
                }
            }

        } catch (Exception e) {
            throw e
        }
    }
}
