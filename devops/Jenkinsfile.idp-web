podTemplate(
    volumes: [
        persistentVolumeClaim(
            claimName: 'container-builder-pvc',
            mountPath: '/var/lib/containers'
        )
    ],
    containers: [
        containerTemplate(
            name: 'podman',
            image: 'quay.io/podman/stable:v4.8.2',
            privileged: true,
            ttyEnabled: true,
            command: 'cat',
        )
    ]
) {
    node(POD_LABEL) {
        def ENV_NAME = env.BRANCH_NAME == 'main' ? 'prod' : 'stg'
        def IMAGE_PATH = "harbor.cocdev.co.kr/${ENV_NAME}/idp-web"
        def GITOPS_APP = 'idp-web'
        def GITOPS_UPDATE_JOB = env.GITOPS_UPDATE_JOB ?: 'gitops-prod-image-bump'

        try {
            stage('Checkout') {
                checkout scm
            }

            stage('Build and Push Image') {
                container('podman') {
                    sh 'podman info || echo "Podman initializing..."'

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'harbor',
                            usernameVariable: 'HARBOR_USERNAME',
                            passwordVariable: 'HARBOR_PASSWORD'
                        )
                    ]) {
                        sh """
                            echo \$HARBOR_PASSWORD | podman login \\
                                -u \$HARBOR_USERNAME \\
                                --password-stdin \\
                                --tls-verify=true \\
                                harbor.cocdev.co.kr
                        """

                        sh """
                            podman build \\
                                --format=docker \\
                                --layers \\
                                -f ./devops/Dockerfile.idp-web \\
                                -t ${IMAGE_PATH}:${env.BUILD_NUMBER} \\
                                -t ${IMAGE_PATH}:latest \\
                                .
                        """

                        sh """
                            podman push \\
                                --compression-format=gzip \\
                                --compression-level=9 \\
                                ${IMAGE_PATH}:${env.BUILD_NUMBER}
                        """

                        sh """
                            podman push \\
                                --compression-format=gzip \\
                                --compression-level=9 \\
                                ${IMAGE_PATH}:latest
                        """

                        sh """
                            podman rmi \\
                                ${IMAGE_PATH}:${env.BUILD_NUMBER} \\
                                ${IMAGE_PATH}:latest || true
                        """
                    }
                }
            }

            stage('Trigger GitOps Update Job') {
                if (ENV_NAME == 'prod') {
                    catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                        def gitCommit = env.GIT_COMMIT ?: ''
                        build(
                            job: GITOPS_UPDATE_JOB,
                            wait: false,
                            parameters: [
                                string(name: 'APP_NAME', value: GITOPS_APP),
                                string(name: 'IMAGE_TAG', value: env.BUILD_NUMBER),
                                string(name: 'DEPLOY_ENV', value: 'prod'),
                                string(name: 'SOURCE_BUILD_URL', value: env.BUILD_URL ?: ''),
                                string(name: 'SOURCE_COMMIT', value: gitCommit),
                            ]
                        )
                        echo "Triggered ${GITOPS_UPDATE_JOB} with APP_NAME=${GITOPS_APP}, IMAGE_TAG=${env.BUILD_NUMBER}"
                    }
                } else {
                    echo "Skip GitOps update trigger for ENV=${ENV_NAME}"
                }
            }

        } catch (Exception e) {
            throw e
        }
    }
}
