FROM docker.io/library/node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS base

ARG PNPM_VERSION=10.34.5
ARG TURBO_VERSION=2.9.14
ENV PNPM_HOME=/usr/local/bin
ENV PNPM_STORE_DIR=/pnpm/store

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
RUN apk add --update --no-cache libc6-compat && rm -rf /var/cache/apk/*
RUN pnpm add -g turbo@${TURBO_VERSION}

WORKDIR /app

FROM base AS setup

COPY . .
RUN turbo prune --scope=tool-storybook --docker

FROM base AS builder

ARG STORYBOOK_DISABLE_CHROMATIC=true
ARG STORYBOOK_BUILD_NOFILE=65536

WORKDIR /app
COPY --from=setup /app/out/json/ ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --store-dir /pnpm/store --no-frozen-lockfile --prefer-offline
COPY --from=setup /app/out/full/ ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    --mount=type=cache,id=turbo,target=/app/.turbo \
    { ulimit -n "${STORYBOOK_BUILD_NOFILE}" 2>/dev/null || ulimit -n 16384 2>/dev/null || true; } && \
    pnpm exec turbo type-check:prod --filter=tool-storybook... && \
    STORYBOOK_DISABLE_CHROMATIC="${STORYBOOK_DISABLE_CHROMATIC}" pnpm exec turbo build --filter=tool-storybook...

FROM docker.io/library/nginx:1.30.4-alpine3.24@sha256:dc5069ad14f19660b141b21236140b91656bf89bbc3e2417c70ae650cd66104c AS runner

COPY devops/nginx.tool-storybook.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/tool/storybook/storybook-static /usr/share/nginx/html

EXPOSE 3009

CMD ["nginx", "-g", "daemon off;"]
