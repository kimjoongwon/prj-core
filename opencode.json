{
  "$schema": "https://open-code.ai/schema.json",
  "permission": {
    "*": "ask",
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "pnpm *": "allow",
      "npm *": "allow",
      "bun *": "allow",
      "turbo *": "allow",
      "npx prisma *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "rm *": "deny",
      "rm -rf *": "deny"
    }
  }
}
