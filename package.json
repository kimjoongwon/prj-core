{
	"name": "core",
	"private": true,
	"version": "0.0.0",
	"packageManager": "pnpm@10.16.0",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"build": "turbo build",
		"build:core-api": "turbo build --filter=core-api",
		"build:admin-web": "turbo build --filter=admin-web",
		"build:proposal-web": "turbo build --filter=proposal-web",
		"build:tool-storybook": "turbo build --filter=tool-storybook",
		"build:packages": "turbo build --filter='./packages/**'",
		"build:pkg": "turbo build --filter",
		"clean": "rm -rf node_modules/.cache .turbo && find packages apps -name 'dist' -type d -exec rm -rf {} + 2>/dev/null; find packages apps -name '.turbo' -type d -exec rm -rf {} + 2>/dev/null; echo 'Cleaned dist and turbo cache'",
		"clean:all": "node scripts/clean-all.js",
		"type-check": "turbo type-check",
		"type-check:prod": "turbo type-check:prod",
		"start": "bash scripts/start.sh",
		"start:core-api": "turbo start:dev --filter=core-api --concurrency=20",
		"start:admin-web": "turbo start:dev --filter=admin-web --concurrency=20",
		"start:proposal-web": "turbo start:dev --filter=proposal-web --concurrency=20",
		"start:mobile": "pnpm --filter=mobile-app run start:dev",
		"start:mobile-storybook": "pnpm --filter=tool-mobile-storybook run start:dev",
		"web:mobile-storybook": "pnpm --filter=tool-mobile-storybook run web",
		"ios:mobile-storybook": "pnpm --filter=tool-mobile-storybook run ios",
		"android:mobile-storybook": "pnpm --filter=tool-mobile-storybook run android",
		"start:tool-storybook": "turbo start:dev --filter=tool-storybook --concurrency=20",
		"android:mobile": "pnpm --filter=mobile-app run android",
		"type-check:mobile": "pnpm --filter=mobile-app run type-check",
		"lint:mobile": "pnpm --filter=mobile-app run lint",
		"doctor:mobile": "pnpm --filter=mobile-app run doctor",
		"agents:contracts:check": "node scripts/check-agent-contracts.mjs",
		"agents:flow:test": "node scripts/test-subagent-log-hook.mjs",
		"rancher:build": "bash scripts/rancher-build.sh",
		"rancher:core-api": "pnpm rancher:build -- core-api",
		"rancher:admin-web": "pnpm rancher:build -- admin-web",
		"rancher:proposal-web": "pnpm rancher:build -- proposal-web",
		"wt": "pnpm exec tsx scripts/wt.ts",
		"wt:init": "pnpm exec tsx scripts/wt.ts init",
		"wt:new": "pnpm exec tsx scripts/wt.ts new",
		"wt:new-run": "pnpm exec tsx scripts/wt.ts new-run",
		"wt:go": "pnpm exec tsx scripts/wt.ts go",
		"wt:list": "pnpm exec tsx scripts/wt.ts list",
		"wt:plan-merge": "pnpm exec tsx scripts/wt.ts plan-merge",
		"wt:pr": "pnpm exec tsx scripts/wt.ts pr",
		"wt:merge": "pnpm exec tsx scripts/wt.ts merge",
		"wt:finish": "pnpm exec tsx scripts/wt.ts finish",
		"wt:rm": "pnpm exec tsx scripts/wt.ts rm",
		"lint": "pnpm run lint:repo && turbo lint",
		"lint:fix": "pnpm run lint:repo:fix && turbo lint:fix",
		"format": "turbo format",
		"test": "turbo test",
		"test:e2e": "node scripts/run-e2e-with-diagnostics.mjs all",
		"test:admin": "node scripts/run-e2e-with-diagnostics.mjs admin",
		"test:admin:run": "pnpm --filter=test-e2e test:admin:run",
		"test:api:e2e": "node scripts/run-e2e-with-diagnostics.mjs api",
		"test:e2e:ui": "node scripts/run-e2e-with-diagnostics.mjs admin-ui",
		"test:e2e:headed": "node scripts/run-e2e-with-diagnostics.mjs admin-headed",
		"test:e2e:debug": "node scripts/run-e2e-with-diagnostics.mjs admin-debug",
		"test:e2e:codegen:admin": "pnpm --filter=test-e2e codegen:admin",
		"codegen:api": "pnpm --filter=@cocrepo/api codegen",
		"version:patch": "pnpm -r --filter './packages/**' exec npm version patch --no-git-tag-version",
		"version:minor": "pnpm -r --filter './packages/**' exec npm version minor --no-git-tag-version",
		"version:major": "pnpm -r --filter './packages/**' exec npm version major --no-git-tag-version",
		"version:pkg": "node scripts/version-pkg.js",
		"publish:packages": "pnpm -r --filter './packages/**' publish --access public --no-git-checks",
		"publish:dry": "pnpm -r --filter './packages/**' publish --access public --no-git-checks --dry-run",
		"update:app-deps": "node scripts/update-app-deps.js",
		"bundle:size": "node scripts/analyze-bundle-size.js",
		"bundle:sizes": "node scripts/show-bundle-sizes.js",
		"release:patch": "pnpm version:patch && pnpm build:packages && pnpm publish:packages && pnpm update:app-deps",
		"release:minor": "pnpm version:minor && pnpm build:packages && pnpm publish:packages && pnpm update:app-deps",
		"release:major": "pnpm version:major && pnpm build:packages && pnpm publish:packages && pnpm update:app-deps",
		"release:pkg": "node scripts/release-pkg.js",
		"db:check:auth-templates": "node scripts/check-auth-email-templates.js",
		"db:check:auth-templates:prod": "node scripts/check-auth-email-templates.js --target=prod",
		"db:check:auth-templates:stg": "node scripts/check-auth-email-templates.js --target=stg",
		"lint:repo": "biome lint scripts --no-errors-on-unmatched --files-ignore-unknown=true",
		"lint:repo:fix": "biome lint scripts --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true",
		"lint:repo:prod": "echo 'No production root lint targets'",
		"lint:prod": "pnpm run lint:repo:prod && turbo lint:prod"
	},
	"devDependencies": {
		"@babel/core": "^7.28.5",
		"@babel/helper-plugin-utils": "^7.28.6",
		"@babel/traverse": "^7.29.0",
		"@biomejs/biome": "catalog:",
		"@types/node": "catalog:",
		"@vitejs/plugin-react-swc": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"@vitest/ui": "catalog:",
		"semver": "^7.7.3",
		"tsx": "catalog:",
		"turbo": "2.8.14",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"pnpm": {
		"packageExtensions": {
			"react-native-worklets@0.7.4": {
				"dependencies": {
					"@babel/types": "^7.29.0"
				}
			}
		},
		"peerDependencyRules": {
			"allowedVersions": {
				"expo-modules-core>react-native-worklets": "0.7.2"
			}
		},
		"overrides": {
			"thread-stream": "^4.0.0",
			"pino": "^9.11.0",
			"sonic-boom": "^4.2.0",
			"@nyariv/sandboxjs": ">=0.9.6"
		}
	},
	"dependencies": {
		"postgres": "^3.4.7"
	}
}
