{
	"name": "mobile-app",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"scripts": {
		"start": "expo start",
		"start:dev": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"lint": "expo lint && pnpm run lint:e2e",
		"lint:e2e": "eslint \"e2e/**/*.js\" --no-warn-ignored",
		"test": "node ./node_modules/jest/bin/jest.js --config ./jest.config.js --runInBand",
		"test:watch": "node ./node_modules/jest/bin/jest.js --config ./jest.config.js --watch",
		"test:e2e": "detox test --configuration ios.sim.debug",
		"test:e2e:ios": "detox test --configuration ios.sim.debug",
		"test:e2e:android": "detox test --configuration android.emu.debug",
		"test:e2e:build:ios": "detox build --configuration ios.sim.debug",
		"test:e2e:build:android": "detox build --configuration android.emu.debug",
		"doctor": "expo-doctor",
		"type-check": "tsc --noEmit -p tsconfig.typecheck.json && pnpm run type-check:e2e",
		"type-check:e2e": "tsc --noEmit -p tsconfig.e2e.json",
		"type-check:prod": "tsc --noEmit",
		"lint:fix": "expo lint --fix && pnpm run lint:e2e -- --fix",
		"lint:prod": "eslint \"src/**/*.{ts,tsx}\" --no-warn-ignored"
	},
	"dependencies": {
		"@cocrepo/api": "workspace:*",
		"@cocrepo/mo-ui": "workspace:*",
		"@cocrepo/type": "workspace:*",
		"@expo/dom-webview": "~58.0.2",
		"@expo/metro-runtime": "~58.0.15",
		"@gorhom/bottom-sheet": "catalog:",
		"@tanstack/react-query": "catalog:",
		"expo": "~58.0.19",
		"expo-constants": "~58.0.13",
		"expo-crypto": "~58.0.7",
		"expo-dev-client": "~58.0.15",
		"expo-linking": "~58.0.14",
		"expo-router": "~58.0.26",
		"expo-secure-store": "~58.0.2",
		"expo-splash-screen": "~58.0.11",
		"expo-web-browser": "~58.0.6",
		"heroui-native": "catalog:",
		"lottie-react-native": "~7.5.0",
		"mobx": "catalog:",
		"mobx-react-lite": "catalog:",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.0",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.0",
		"react-native-svg": "15.16.0",
		"react-native-worklets": "0.13.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "catalog:",
		"uniwind": "^1.13.0"
	},
	"devDependencies": {
		"@jest/reporters": "29.7.0",
		"@react-native/jest-preset": "0.88.0",
		"@testing-library/react-native": "^13.3.3",
		"@types/jest": "^30.0.0",
		"@types/react": "~19.3.0",
		"@types/react-dom": "~19.3.0",
		"detox": "^20.51.4",
		"eslint": "^9.39.5",
		"eslint-config-expo": "~58.0.4",
		"expect": "^29.7.0",
		"expo-doctor": "^1.21.5",
		"jest": "^30.5.2",
		"jest-expo": "~58.0.12",
		"react-test-renderer": "19.3.0",
		"typescript": "~6.0.3"
	},
	"expo": {
		"autolinking": {
			"legacy_shallowReactNativeLinking": true
		}
	},
	"private": true
}
