{
  "name": "mobile-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "test": "node ./node_modules/jest/bin/jest.js --config ./jest.config.js --runInBand",
    "test:watch": "node ./node_modules/jest/bin/jest.js --config ./jest.config.js --watch",
    "test:e2e": "detox test --configuration ios.sim.debug",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "test:e2e:build:ios": "detox build --configuration ios.sim.debug",
    "test:e2e:build:android": "detox build --configuration android.emu.debug",
    "doctor": "expo-doctor",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cocrepo/api": "workspace:*",
    "@cocrepo/mo-ui": "workspace:*",
    "@expo/metro-runtime": "~55.0.10",
    "@gorhom/bottom-sheet": "catalog:",
    "@react-navigation/native": "^7.1.33",
    "@tanstack/react-query": "catalog:",
    "expo": "~55.0.19",
    "expo-constants": "~55.0.15",
    "expo-dev-client": "~55.0.30",
    "expo-linking": "~55.0.14",
    "expo-router": "~55.0.13",
    "expo-secure-store": "^55.0.13",
    "expo-splash-screen": "~55.0.19",
    "heroui-native": "catalog:",
    "lottie-react-native": "~7.3.8",
    "mobx": "catalog:",
    "mobx-react-lite": "catalog:",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.4",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "catalog:",
    "uniwind": "^1.6.3"
  },
  "devDependencies": {
    "@jest/reporters": "29.7.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "detox": "^20.50.1",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.0",
    "expect": "^29.7.0",
    "expo-doctor": "^1.18.15",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.16",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "autolinking": {
      "legacy_shallowReactNativeLinking": true
    }
  },
  "private": true
}
