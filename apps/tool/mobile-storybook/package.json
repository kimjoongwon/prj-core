{
	"name": "tool-mobile-storybook",
	"version": "1.0.0",
	"private": true,
	"main": "index.ts",
	"scripts": {
		"prestart": "pnpm run storybook:generate",
		"start": "expo start --port 8083",
		"prestart:dev": "pnpm run storybook:generate",
		"start:dev": "expo start --port 8083",
		"start:clear": "expo start --clear --port 8083",
		"preweb": "pnpm run storybook:generate",
		"web": "expo start --web --port 8083",
		"preios": "pnpm run storybook:generate",
		"ios": "expo start --ios --port 8083",
		"preandroid": "pnpm run storybook:generate",
		"android": "expo start --android --port 8083",
		"storybook:generate": "pnpm run storybook:generate:stories && pnpm run storybook:generate:sources",
		"storybook:generate:stories": "sb-rn-get-stories --config-path ./.rnstorybook",
		"storybook:generate:sources": "node ./scripts/generate-story-sources.mjs",
		"storybook:check:sources": "node ./scripts/generate-story-sources.mjs --check",
		"test:story-sources": "node --test ./scripts/check-story-sources.test.mjs",
		"type-check": "pnpm run storybook:generate && tsc --noEmit",
		"type-check:prod": "pnpm run storybook:generate && tsc --noEmit",
		"lint": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs",
		"lint:fix": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --fix",
		"lint:prod": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --prod"
	},
	"dependencies": {
		"@cocrepo/api": "workspace:*",
		"@cocrepo/mo-ui": "workspace:*",
		"@expo/dom-webview": "~57.0.1",
		"@expo/metro-runtime": "~57.0.17",
		"@gorhom/bottom-sheet": "catalog:",
		"@react-native-async-storage/async-storage": "3.1.1",
		"@react-native-community/datetimepicker": "9.2.2",
		"@react-native-community/slider": "5.2.2",
		"@storybook/addon-ondevice-actions": "10.7.0",
		"@storybook/addon-ondevice-backgrounds": "10.7.0",
		"@storybook/addon-ondevice-controls": "10.7.0",
		"@storybook/react-native": "10.7.0",
		"@tanstack/react-query": "catalog:",
		"expo": "~58.0.19",
		"expo-constants": "~58.0.13",
		"expo-linking": "~58.0.14",
		"expo-router": "~58.0.26",
		"heroui-native": "catalog:",
		"lottie-react-native": "~7.3.8",
		"mobx": "catalog:",
		"mobx-react-lite": "catalog:",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.0",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.0",
		"react-native-svg": "15.16.0",
		"react-native-web": "~0.21.4",
		"react-native-worklets": "0.13.0",
		"react-test-renderer": "19.3.0",
		"storybook": "10.4.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "catalog:",
		"uniwind": "^1.13.0"
	},
	"devDependencies": {
		"@react-native/jest-preset": "0.88.0",
		"@types/react": "~19.3.0",
		"@types/react-dom": "~19.3.0",
		"typescript": "~6.0.3"
	},
	"expo": {
		"autolinking": {
			"legacy_shallowReactNativeLinking": true
		}
	}
}
