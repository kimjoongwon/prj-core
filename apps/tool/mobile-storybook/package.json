{
  "name": "tool-mobile-storybook",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "prestart": "pnpm run storybook:generate",
    "start": "expo start --port 8083",
    "prestart:dev": "pnpm run storybook:generate",
    "start:dev": "expo start --port 8083",
    "start:clear": "expo start --clear --port 8083",
    "preweb": "pnpm run storybook:generate",
    "web": "expo start --web --port 8083",
    "preios": "pnpm run storybook:generate",
    "ios": "expo start --ios --port 8083",
    "preandroid": "pnpm run storybook:generate",
    "android": "expo start --android --port 8083",
    "storybook:generate": "sb-rn-get-stories --config-path ./.rnstorybook",
    "type-check": "pnpm run storybook:generate && tsc --noEmit",
    "type-check:prod": "pnpm run storybook:generate && tsc --noEmit",
    "lint": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs",
    "lint:fix": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --fix",
    "lint:prod": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --prod"
  },
  "dependencies": {
    "@cocrepo/api": "workspace:*",
    "@cocrepo/mo-ui": "workspace:*",
    "@expo/dom-webview": "~56.0.6",
    "@expo/metro-runtime": "~56.0.21",
    "@gorhom/bottom-sheet": "catalog:",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@storybook/addon-ondevice-actions": "10.4.0",
    "@storybook/addon-ondevice-backgrounds": "10.4.0",
    "@storybook/addon-ondevice-controls": "10.4.0",
    "@storybook/react-native": "10.4.0",
    "expo": "~56.0.21",
    "expo-constants": "~56.0.25",
    "heroui-native": "catalog:",
    "lottie-react-native": "~7.3.4",
    "mobx": "catalog:",
    "mobx-react-lite": "catalog:",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "react-test-renderer": "19.2.3",
    "storybook": "10.4.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "catalog:",
    "uniwind": "^1.6.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "legacy_shallowReactNativeLinking": true
    }
  }
}
