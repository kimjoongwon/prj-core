{
  "name": "tool-storybook",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "STORYBOOK_DISABLE_CHROMATIC=${STORYBOOK_DISABLE_CHROMATIC:-true} STORYBOOK_DISABLE_VITEST_ADDON=${STORYBOOK_DISABLE_VITEST_ADDON:-true} storybook build && node ./scripts/fix-static-subpath.mjs",
    "test": "PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-./.playwright} vitest --config vitest.config.js --passWithNoTests",
    "test:ui": "PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-./.playwright} vitest --ui",
    "test:run": "PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-./.playwright} vitest run",
    "test:watch": "PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-./.playwright} vitest watch",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "start:dev": "STORYBOOK_REQUIRE_AUTH=true storybook dev -p ${STORYBOOK_PORT:-6006}",
    "build-storybook": "STORYBOOK_DISABLE_CHROMATIC=${STORYBOOK_DISABLE_CHROMATIC:-true} STORYBOOK_DISABLE_VITEST_ADDON=${STORYBOOK_DISABLE_VITEST_ADDON:-true} storybook build && node ./scripts/fix-static-subpath.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "@dagrejs/dagre": "catalog:",
    "@cocrepo/store": "workspace:^",
    "@cocrepo/ui": "workspace:^",
    "@heroui/react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@xyflow/react": "catalog:",
    "mobx": "catalog:",
    "next": "^16.1.0",
    "mobx-react-lite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^7.7.1",
    "react-router-dom": "^7.7.1"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@chromatic-com/storybook": "^4.0.1",
    "@storybook/addon-a11y": "^9.0.18",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-vitest": "^9.0.18",
    "@storybook/nextjs-vite": "9.1.17",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react-swc": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "markdown-to-jsx": "^9.7.13",
    "playwright": "^1.54.1",
    "prop-types": "^15.8.1",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
