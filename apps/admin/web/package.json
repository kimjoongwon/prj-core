{
	"name": "admin-web",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev": "set -a; [ -f .env.local ] && . ./.env.local; set +a; PORT=${ADMIN_WEB_PORT:-3000}; next dev --turbopack -p \"$PORT\" & sleep 2 && open http://localhost:$PORT/admin && wait",
		"start:dev": "set -a; [ -f .env.local ] && . ./.env.local; set +a; next dev --turbopack -p \"${ADMIN_WEB_PORT:-3000}\"",
		"build": "next build",
		"analyze": "ANALYZE=true pnpm build",
		"start": "next start",
		"type-check": "tsc --noEmit",
		"type-check:prod": "tsc --noEmit --incremental false -p tsconfig.prod.json",
		"lint": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs",
		"lint:fix": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --fix",
		"format": "biome check --write .",
		"clean": "rm -rf node_modules && rm -rf .next && rm -rf package-lock.json",
		"clean:next": "rm -rf .next",
		"lint:prod": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --prod"
	},
	"dependencies": {
		"@cocrepo/api": "workspace:^",
		"@cocrepo/constant": "workspace:^",
		"@cocrepo/hook": "workspace:^",
		"@cocrepo/schema": "workspace:^",
		"@cocrepo/store": "workspace:^",
		"@cocrepo/toolkit": "workspace:^1.3.0",
		"@cocrepo/type": "workspace:^",
		"@cocrepo/ui": "workspace:^1.5.0",
		"@heroui/react": "catalog:",
		"@heroui/styles": "catalog:",
		"@tanstack/react-query": "catalog:",
		"@tanstack/react-table": "^8.21.3",
		"axios": "catalog:",
		"class-variance-authority": "catalog:",
		"dayjs": "catalog:",
		"lucide-react": "catalog:",
		"mobx": "catalog:",
		"mobx-react-lite": "catalog:",
		"next": "^16.3.5",
		"nuqs": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"recharts": "^2.15.0",
		"superjson": "catalog:"
	},
	"devDependencies": {
		"@cocrepo/e2e": "workspace:^",
		"@next/bundle-analyzer": "^16.1.6",
		"@tailwindcss/postcss": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:"
	}
}
