{
  "name": "core-api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "set -a; [ -f .env ] && . ./.env; set +a; APP_PORT=${CORE_API_PORT:-${APP_PORT:-3006}} nest build --webpack --webpackPath webpack.config.js --watch",
    "start:e2e": "node ./scripts/start-e2e.mjs",
    "start:debug": "set -a; [ -f .env ] && . ./.env; set +a; APP_PORT=${CORE_API_PORT:-${APP_PORT:-3006}} nest build --webpack --webpackPath webpack.config.js --watch",
    "start:prod": "node dist/main",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "type-check:prod": "tsc --noEmit -p tsconfig.build.json",
    "lint": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs",
    "lint:fix": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --fix",
    "format": "biome check --write src",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules' jest --config ./test/jest-e2e.json",
    "clean": "rm -rf dist && rm -rf node_modules",
    "lint:prod": "node $(git rev-parse --show-toplevel)/scripts/lint-biome-workspace.mjs --prod"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@cocrepo/aggregate": "workspace:*",
    "@cocrepo/be-common": "workspace:*",
    "@cocrepo/client": "workspace:*",
    "@cocrepo/command": "workspace:*",
    "@cocrepo/constant": "workspace:*",
    "@cocrepo/context": "workspace:*",
    "@cocrepo/controller": "workspace:*",
    "@cocrepo/decorator": "workspace:^",
    "@cocrepo/dto": "workspace:^",
    "@cocrepo/entity": "workspace:*",
    "@cocrepo/enum": "workspace:*",
    "@cocrepo/repository": "workspace:*",
    "@cocrepo/service": "workspace:*",
    "@cocrepo/type": "workspace:*",
    "@cocrepo/usecase": "workspace:*",
    "@cocrepo/vo": "workspace:*",
    "@nestjs-cls/transactional": "^3.3.1",
    "@nestjs-cls/transactional-adapter-prisma": "^1.4.1",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "catalog:",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "dayjs": "catalog:",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "libphonenumber-js": "^1.13.15",
    "multer": "^2.5.0",
    "nestjs-cls": "^6.3.1",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^10.2.1",
    "oidc-provider": "^8.8.1",
    "passport": "^0.7.0",
