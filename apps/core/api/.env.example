# Copy this file to .env for local development.
# .env.example is a committed template and is not read at runtime.

# App
APP_NAME=core-api
APP_PORT=3006
NODE_ENV=development
APP_ADMIN_EMAIL=admin@example.com
LOCAL_BOOTSTRAP_ADMIN_EMAIL=local-admin@example.com
LOCAL_BOOTSTRAP_ADMIN_PASSWORD=local-admin-password-change-me
LOCAL_BOOTSTRAP_ADMIN_NAME=Local Administrator
LOCAL_BOOTSTRAP_ADMIN_NICKNAME=local-admin
API_PREFIX=api
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3006
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang

# Database (Prisma)
DATABASE_URL=postgresql://cocrepo:devpassword@localhost:5432/plate?schema=public
DIRECT_URL=postgresql://cocrepo:devpassword@localhost:5432/plate?schema=public

# E2E Test Database
E2E_DATABASE_URL=postgresql://cocrepo:devpassword@localhost:5432/plate_e2e?schema=public
E2E_DIRECT_URL=postgresql://cocrepo:devpassword@localhost:5432/plate_e2e?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ENABLED=true
# 쉼표로 구분한 browser origin allowlist. Cookie 인증 상태 변경의 Origin/Referer 검증도 이 목록을 사용합니다.
# 개발에서는 비워두면 기존처럼 모든 origin을 허용합니다.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3011,http://localhost:6006

# Reverse proxy / security
# 로컬에서 직접 실행하면 0입니다. production은 ingress까지의 trusted proxy hop 수(1~32)를 명시해야 합니다.
TRUST_PROXY_HOPS=0

# Swagger는 development에서 기본 활성화됩니다. production은 SWAGGER_ENABLED=true와 아래 세 보호값을 모두 요구합니다.
SWAGGER_ENABLED=true
SWAGGER_ALLOWED_IPS=
SWAGGER_BASIC_AUTH_USERNAME=
SWAGGER_BASIC_AUTH_PASSWORD=
SWAGGER_OAUTH_REDIRECT_URI=http://localhost:3006/api/oauth2-redirect.html

# SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=resend
SMTP_PASSWORD=re_xxxxxxxxx
SMTP_SENDER=noreply@cocdev.co.kr

# Object Storage
OBJECT_STORAGE_PROVIDER=cloudflare-r2
OBJECT_STORAGE_ACCESS_KEY=your-access-key
OBJECT_STORAGE_SECRET_KEY=your-secret-key
OBJECT_STORAGE_API_TOKEN=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=your-bucket
OBJECT_STORAGE_ENDPOINT=https://example.r2.cloudflarestorage.com
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# OIDC
OIDC_ISSUER=http://localhost:3000
OIDC_COOKIE_SECRET=dev-cookie-secret-must-be-at-least-32-characters
OIDC_JWKS_URI=http://localhost:3000/oidc/jwks
# OIDC 서명 키(RS256 JWKS JSON). 미설정 시 oidc-provider가 프로세스마다 개발용 키를
# 새로 만들고 경고를 출력하며, 재시작마다 발급된 토큰이 무효화된다.
# 아래 명령으로 생성한 JSON을 작은따옴표로 감싸 넣는다:
#   node -e "const {generateKeyPair,exportJWK}=require('jose');generateKeyPair('RS256',{extractable:true}).then(async({privateKey})=>{const j=await exportJWK(privateKey);Object.assign(j,{alg:'RS256',use:'sig',kid:'core-api-dev-rs256-1'});console.log(JSON.stringify({keys:[j]}))})"
OIDC_JWKS_KEYS=
OIDC_ADMIN_BASE_URL=http://localhost:3000
OIDC_INTERACTION_BASE_URL=http://localhost:3000/admin
OIDC_ADMIN_CLIENT_ID=admin-web
OIDC_ADMIN_CLIENT_SECRET=admin-secret-change-in-development
OIDC_STORYBOOK_BASE_URL=http://localhost:6006
OIDC_STORYBOOK_CLIENT_ID=storybook-web
OIDC_STORYBOOK_CLIENT_SECRET=storybook-secret-change-in-development

# JWT
AUTH_JWT_SECRET=your-jwt-secret
AUTH_JWT_TOKEN_EXPIRES_IN=10d
AUTH_JWT_TOKEN_REFRESH_IN=7d
AUTH_JWT_SALT_ROUNDS=10

# Optional
ENABLE_NEST_DEVTOOLS=false
CORE_API_NEST_DEVTOOLS_PORT=8000
