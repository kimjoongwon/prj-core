# Copy this file to .env for local development.
# .env.example is a committed template and is not read at runtime.

# App
APP_NAME=core-api
APP_PORT=3006
NODE_ENV=development
APP_ADMIN_EMAIL=admin@example.com
API_PREFIX=api
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3006
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang

# Database (Prisma)
DATABASE_URL=postgresql://cocrepo:devpassword@localhost:5432/plate?schema=public
DIRECT_URL=postgresql://cocrepo:devpassword@localhost:5432/plate?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ENABLED=true

# SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=resend
SMTP_PASSWORD=re_xxxxxxxxx
SMTP_SENDER=noreply@cocdev.co.kr

# Object Storage
OBJECT_STORAGE_PROVIDER=cloudflare-r2
OBJECT_STORAGE_ACCESS_KEY=your-access-key
OBJECT_STORAGE_SECRET_KEY=your-secret-key
OBJECT_STORAGE_API_TOKEN=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=your-bucket
OBJECT_STORAGE_ENDPOINT=https://example.r2.cloudflarestorage.com
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# OIDC
OIDC_ISSUER=http://localhost:3007
OIDC_JWKS_URI=http://localhost:3007/oidc/jwks
OIDC_ADMIN_BASE_URL=http://localhost:3000
OIDC_ADMIN_CLIENT_ID=admin-web
OIDC_ADMIN_CLIENT_SECRET=admin-secret-change-in-development
OIDC_STORYBOOK_BASE_URL=http://localhost:6006
OIDC_STORYBOOK_CLIENT_ID=storybook
OIDC_STORYBOOK_CLIENT_SECRET=storybook-secret-change-in-development

# JWT
AUTH_JWT_SECRET=your-jwt-secret
AUTH_JWT_TOKEN_EXPIRES_IN=10d
AUTH_JWT_TOKEN_REFRESH_IN=7d
AUTH_JWT_SALT_ROUNDS=10

# Optional
ENABLE_NEST_DEVTOOLS=false
CORE_API_NEST_DEVTOOLS_PORT=8000
