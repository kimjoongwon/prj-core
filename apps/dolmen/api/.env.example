# Copy to .env for local development. Do not add real secrets.
DOLMEN_API_PORT=3012

# hello-agents LLM 설정 (OpenAI 호환, 패키지가 읽는 env명: LLM_MODEL_ID/LLM_API_KEY/LLM_BASE_URL)
# 사용하는 계정의 OpenAI 호환 엔드포인트/키/모델명으로 교체하세요.
LLM_API_KEY=sk-your-openai-compatible-key
LLM_MODEL_ID=your-model-id
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
