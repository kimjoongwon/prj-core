{
  "name": "test-e2e",
  "version": "0.0.1",
  "private": true,
  "description": "E2E tests using Playwright",
  "scripts": {
    "test": "echo 'Skip default e2e test. Use test:admin or test:idp instead.'",
    "test:admin": "PLAYWRIGHT_BROWSERS_PATH=./browsers playwright test --project=admin-chromium",
    "test:admin:mobile": "PLAYWRIGHT_BROWSERS_PATH=./browsers playwright test --project=admin-mobile",
    "test:idp": "PLAYWRIGHT_BROWSERS_PATH=./browsers playwright test --project=idp-chromium",
    "test:idp:mobile": "PLAYWRIGHT_BROWSERS_PATH=./browsers playwright test --project=idp-mobile",
    "test:ui": "PLAYWRIGHT_BROWSERS_PATH=./browsers playwright test --ui",
    "test:headed": "PLAYWRIGHT_BROWSERS_PATH=./browsers playwright test --headed",
    "test:debug": "PLAYWRIGHT_BROWSERS_PATH=./browsers playwright test --debug",
    "test:report": "playwright show-report",
    "codegen:admin": "PLAYWRIGHT_BROWSERS_PATH=./browsers playwright codegen http://localhost:3000/admin/",
    "codegen:idp": "PLAYWRIGHT_BROWSERS_PATH=./browsers playwright codegen http://localhost:3008/",
    "install:browsers": "PLAYWRIGHT_BROWSERS_PATH=./browsers playwright install chromium",
    "install:browsers:all": "PLAYWRIGHT_BROWSERS_PATH=./browsers playwright install"
  },
  "devDependencies": {
    "@cocrepo/e2e": "workspace:^",
    "@playwright/test": "^1.57.0",
    "@types/node": "catalog:"
  }
}
