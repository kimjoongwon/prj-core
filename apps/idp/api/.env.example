# Copy this file to .env for local development.
# .env.example is a committed template and is not read at runtime.

# App
APP_NAME=idp
APP_PORT=3007
NODE_ENV=development

# Database (Prisma)
DATABASE_URL=postgresql://cocrepo:devpassword@localhost:5432/plate?schema=public
DIRECT_URL=postgresql://cocrepo:devpassword@localhost:5432/plate?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ENABLED=true

# SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=resend
SMTP_PASSWORD=re_xxxxxxxxx
SMTP_SENDER=noreply@onjitda.com

# OIDC Configuration
OIDC_ISSUER=http://localhost:3007
OIDC_COOKIE_SECRET=your-cookie-secret-must-be-at-least-32-characters
OIDC_ADMIN_BASE_URL=http://localhost:3000
OIDC_ADMIN_CLIENT_SECRET=admin-secret-change-in-production
OIDC_STORYBOOK_BASE_URL=http://localhost:6006
OIDC_STORYBOOK_CLIENT_SECRET=storybook-secret-change-in-production
# 로그인 인터랙션 UI(idp-web)의 공개 base URL — 없으면 로그인 리다이렉트가 localhost로 떨어짐
OIDC_INTERACTION_BASE_URL=http://localhost:3008
OIDC_JWKS_URI=http://localhost:3007/oidc/jwks
OIDC_JWKS_KEYS={"keys":[{"kty":"RSA","kid":"replace-me","use":"sig","alg":"RS256","n":"replace-me","e":"AQAB","d":"replace-me","p":"replace-me","q":"replace-me","dp":"replace-me","dq":"replace-me","qi":"replace-me"}]}

# Devtools (production 비활성)
ENABLE_NEST_DEVTOOLS=true
IDP_API_NEST_DEVTOOLS_PORT=8001

# OIDC 토큰 쿠키/세션 TTL
AUTH_JWT_TOKEN_EXPIRES_IN=1h
AUTH_JWT_TOKEN_REFRESH_IN=7d

# IDP Client URL (로그인 페이지)
IDP_CLIENT_URL=http://localhost:3008
