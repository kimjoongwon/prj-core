# Copy this file to .env for local development.
# .env.example is a committed template and is not read at runtime.

# App
APP_NAME=idp
APP_PORT=3007
NODE_ENV=development
APP_ADMIN_EMAIL=admin@example.com
API_PREFIX=api
FRONTEND_DOMAIN=http://localhost:3008
BACKEND_DOMAIN=http://localhost:3007
APP_FALLBACK_LANGUAGE=ko
APP_HEADER_LANGUAGE=x-custom-lang

# Database (Prisma)
DATABASE_URL=postgresql://cocrepo:devpassword@localhost:5432/plate?schema=public
DIRECT_URL=postgresql://cocrepo:devpassword@localhost:5432/plate?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ENABLED=true

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=dev@example.com
SMTP_PASSWORD=dev-password
SMTP_SENDER=noreply@example.com

# OIDC Configuration
OIDC_ISSUER=http://localhost:3007
OIDC_COOKIE_SECRET=your-cookie-secret-must-be-at-least-32-characters
OIDC_ADMIN_BASE_URL=http://localhost:3000
OIDC_ADMIN_CLIENT_ID=admin-web
OIDC_ADMIN_CLIENT_SECRET=admin-secret-change-in-production
OIDC_STORYBOOK_BASE_URL=http://localhost:6006
OIDC_STORYBOOK_CLIENT_ID=storybook
OIDC_STORYBOOK_CLIENT_SECRET=storybook-secret-change-in-production
OIDC_IDP_WEB_CLIENT_ID=idp-web
OIDC_IDP_WEB_CLIENT_SECRET=idp-web-secret-change-in-production
OIDC_IDP_WEB_REDIRECT_URI=http://localhost:3008/api/v1/auth/callback
OIDC_JWKS_URI=http://localhost:3007/oidc/jwks

# JWT (shared with main server if needed)
AUTH_JWT_SECRET=your-jwt-secret
AUTH_JWT_TOKEN_EXPIRES_IN=1h
AUTH_JWT_TOKEN_REFRESH_IN=7d
AUTH_JWT_SALT_ROUNDS=10

# IDP Client URL (로그인 페이지)
IDP_CLIENT_URL=http://localhost:3008
