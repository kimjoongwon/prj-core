{
	"name": "idp-api",
	"version": "0.0.1",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"start": "nest start",
		"start:dev": "set -a; [ -f .env ] && . ./.env; set +a; APP_PORT=${IDP_API_PORT:-${APP_PORT:-3007}} nest build --webpack --webpackPath webpack.config.js --watch",
		"start:debug": "set -a; [ -f .env ] && . ./.env; set +a; APP_PORT=${IDP_API_PORT:-${APP_PORT:-3007}} nest build --webpack --webpackPath webpack.config.js --watch",
		"start:prod": "node dist/main.js",
		"start:e2e": "node ./scripts/start-e2e.mjs",
		"type-check": "tsc --noEmit",
		"lint": "biome check src",
		"lint:fix": "biome check --write src",
		"format": "biome format --write src",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
		"test:e2e": "jest --testRegex \\.e2e-spec\\.ts$ --passWithNoTests",
		"test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
		"test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
		"clean": "rm -rf dist && rm -rf node_modules"
	},
	"dependencies": {
		"@cocrepo/aggregate": "workspace:*",
		"@cocrepo/be-common": "workspace:*",
		"@cocrepo/client": "workspace:*",
		"@cocrepo/command": "workspace:*",
		"@cocrepo/constant": "workspace:*",
		"@cocrepo/context": "workspace:*",
		"@cocrepo/controller": "workspace:*",
		"@cocrepo/decorator": "workspace:*",
		"@cocrepo/dto": "workspace:*",
		"@cocrepo/prisma": "workspace:*",
		"@cocrepo/repository": "workspace:*",
		"@cocrepo/service": "workspace:*",
		"@cocrepo/type": "workspace:*",
		"@cocrepo/usecase": "workspace:*",
		"@nestjs-cls/transactional": "^4.0.1",
		"@nestjs-cls/transactional-adapter-prisma": "^2.0.1",
		"@nestjs/common": "^12.0.0",
		"@nestjs/config": "^12.0.0",
		"@nestjs/core": "^12.0.0",
		"@nestjs/cqrs": "^12.0.0",
		"@nestjs/jwt": "^12.0.0",
		"@nestjs/passport": "^12.0.0",
		"@nestjs/platform-express": "^12.0.0",
		"@nestjs/swagger": "^12.0.0",
		"@nestjs/throttler": "^6.7.1",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "catalog:",
		"bcrypt": "^6.0.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"cookie-parser": "^1.4.7",
		"dayjs": "catalog:",
		"express": "^5.3.0",
		"ioredis": "^5.11.1",
		"jose": "^5.10.0",
		"nestjs-cls": "^7.0.1",
		"nestjs-pino": "^5.3.1",
		"pino-http": "^11.0.0",
		"nodemailer": "^10.2.1",
		"oidc-provider": "^8.8.1",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"pg": "^8.23.1",
		"pino-pretty": "^13.2.0",
		"reflect-metadata": "^0.2.2"
	},
	"devDependencies": {
		"@cocrepo/tsconfig": "workspace:*",
		"@nestjs/cli": "^12.0.10",
		"@nestjs/devtools-integration": "12.0.0",
		"@nestjs/schematics": "^12.0.10",
		"@nestjs/testing": "^12.0.0",
		"@types/bcrypt": "^5.0.2",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "catalog:",
		"@types/oidc-provider": "^8.8.1",
		"jest": "^30.5.2",
		"run-script-webpack-plugin": "^0.2.3",
		"ts-jest": "^29.4.15",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "4.2.0",
		"typescript": "catalog:"
	}
}
