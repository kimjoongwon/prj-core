{
  "name": "idp-api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "set -a; [ -f .env ] && . ./.env; set +a; APP_PORT=${IDP_API_PORT:-${APP_PORT:-3007}} nest build --webpack --webpackPath webpack.config.js --watch",
    "start:debug": "set -a; [ -f .env ] && . ./.env; set +a; APP_PORT=${IDP_API_PORT:-${APP_PORT:-3007}} nest build --webpack --webpackPath webpack.config.js --watch",
    "start:prod": "node dist/main.js",
    "type-check": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --testRegex \\.e2e-spec\\.ts$ --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "clean": "rm -rf dist && rm -rf node_modules"
  },
  "dependencies": {
    "@cocrepo/aggregate": "workspace:*",
    "@cocrepo/be-common": "workspace:*",
    "@cocrepo/client": "workspace:*",
    "@cocrepo/command": "workspace:*",
    "@cocrepo/constant": "workspace:*",
    "@cocrepo/context": "workspace:*",
    "@cocrepo/controller": "workspace:*",
    "@cocrepo/decorator": "workspace:*",
    "@cocrepo/dto": "workspace:*",
    "@cocrepo/prisma": "workspace:*",
    "@cocrepo/repository": "workspace:*",
    "@cocrepo/service": "workspace:*",
    "@cocrepo/type": "workspace:*",
    "@cocrepo/usecase": "workspace:*",
    "@nestjs-cls/transactional": "^3.1.1",
    "@nestjs-cls/transactional-adapter-prisma": "^1.3.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "catalog:",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dayjs": "catalog:",
    "express": "^5.1.0",
    "ioredis": "^5.8.2",
    "jose": "^5.10.0",
    "nestjs-cls": "^6.1.0",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^10.0.10",
    "oidc-provider": "^8.5.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "pino-pretty": "^13.1.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@cocrepo/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/devtools-integration": "0.2.1",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/oidc-provider": "^8.5.2",
    "jest": "^30.1.3",
    "run-script-webpack-plugin": "^0.2.3",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "catalog:"
  }
