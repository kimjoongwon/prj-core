# Copy to .env.local for local development. Do not add real secrets.
IDP_WEB_PORT=3008
# idp-api 내부 주소 — 로그인/동의 페이지의 SSR interaction 조회와
# next.config.ts rewrites(개발 프록시)가 함께 사용. prod에서는
# idp-api 서비스 주소(예: http://idp-api-prod) 필수.
IDP_API_INTERNAL_URL=http://localhost:3007
# 루트 접근 시 리다이렉트할 어드민 웹 URL
ADMIN_WEB_URL=http://localhost:3000
NODE_ENV=development
