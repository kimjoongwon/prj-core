<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>권한 동의 - <%= locals.client?.clientName || 'Application' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen flex items-center justify-center">
  <!-- Background blur orbs -->
  <div class="fixed bottom-0 left-0 w-[500px] h-[500px] bg-blue-500/20 rounded-full blur-3xl -translate-x-1/2 translate-y-1/2"></div>
  <div class="fixed top-0 right-0 w-[400px] h-[400px] bg-purple-500/10 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2"></div>

  <div class="relative z-10 w-full max-w-md px-6">
    <div class="bg-gray-800/80 backdrop-blur-sm p-8 rounded-2xl shadow-xl border border-gray-700">
      <!-- Client Info -->
      <div class="text-center mb-8">
        <% if (locals.client?.logoUri) { %>
          <img src="<%= client.logoUri %>" alt="<%= client.clientName %>" class="w-16 h-16 rounded-2xl mx-auto mb-4">
        <% } else { %>
          <div class="w-16 h-16 bg-gradient-to-br from-green-500 to-teal-600 rounded-2xl mx-auto mb-4 flex items-center justify-center">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
        <% } %>
        <h1 class="text-2xl font-bold"><%= locals.client?.clientName || '애플리케이션' %></h1>
        <p class="text-gray-400 mt-2">이 애플리케이션이 다음 권한을 요청합니다</p>
      </div>

      <!-- Error Message -->
      <% if (locals.error) { %>
        <div class="bg-red-500/20 border border-red-500/50 text-red-400 p-4 rounded-lg mb-6">
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <%= error %>
          </div>
        </div>
      <% } %>

      <!-- Requested Scopes -->
      <div class="bg-gray-700/30 rounded-xl p-4 mb-6">
        <h3 class="text-sm font-medium text-gray-300 mb-3">요청된 권한</h3>
        <ul class="space-y-3">
          <% if (locals.prompt?.details?.missingOIDCScope) { %>
            <% prompt.details.missingOIDCScope.forEach(function(scope) { %>
              <li class="flex items-center">
                <div class="w-8 h-8 rounded-lg bg-blue-500/20 flex items-center justify-center mr-3">
                  <% if (scope === 'openid') { %>
                    <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                  <% } else if (scope === 'email') { %>
                    <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                  <% } else if (scope === 'profile') { %>
                    <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  <% } else if (scope === 'phone') { %>
                    <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                  <% } else { %>
                    <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  <% } %>
                </div>
                <div>
                  <p class="text-white font-medium">
                    <% if (scope === 'openid') { %>
                      기본 프로필 정보
                    <% } else if (scope === 'email') { %>
                      이메일 주소
                    <% } else if (scope === 'profile') { %>
                      프로필 정보 (이름)
                    <% } else if (scope === 'phone') { %>
                      전화번호
                    <% } else if (scope === 'roles') { %>
                      역할 정보
                    <% } else if (scope === 'permissions') { %>
                      권한 정보
                    <% } else { %>
                      <%= scope %>
                    <% } %>
                  </p>
                </div>
              </li>
            <% }); %>
          <% } %>
        </ul>
      </div>

      <!-- Action Buttons -->
      <div class="flex space-x-4">
        <form method="post" action="/interaction/<%= uid %>/confirm" class="flex-1">
          <button
            type="submit"
            class="w-full py-3 px-4 bg-gradient-to-r from-green-500 to-teal-600 hover:from-green-600 hover:to-teal-700 text-white font-semibold rounded-xl transition-all duration-200 shadow-lg hover:shadow-xl"
          >
            허용
          </button>
        </form>

        <form method="post" action="/interaction/<%= uid %>/abort" class="flex-1">
          <button
            type="submit"
            class="w-full py-3 px-4 bg-gray-600 hover:bg-gray-700 text-white font-semibold rounded-xl transition-all duration-200"
          >
            거부
          </button>
        </form>
      </div>

      <!-- Privacy Note -->
      <p class="text-center text-gray-500 text-xs mt-6">
        허용하면 위 정보가 <%= locals.client?.clientName || '애플리케이션' %>과(와) 공유됩니다.
      </p>
    </div>
  </div>
</body>
</html>
