<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>오류 발생</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen flex items-center justify-center">
  <!-- Background blur orbs -->
  <div class="fixed bottom-0 left-0 w-[500px] h-[500px] bg-red-500/20 rounded-full blur-3xl -translate-x-1/2 translate-y-1/2"></div>
  <div class="fixed top-0 right-0 w-[400px] h-[400px] bg-purple-500/10 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2"></div>

  <div class="relative z-10 w-full max-w-md px-6">
    <div class="bg-gray-800/80 backdrop-blur-sm p-8 rounded-2xl shadow-xl border border-gray-700">
      <!-- Error Icon -->
      <div class="text-center mb-6">
        <div class="w-16 h-16 bg-gradient-to-br from-red-500 to-red-700 rounded-2xl mx-auto mb-4 flex items-center justify-center">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-red-400">오류 발생</h1>
      </div>

      <!-- Error Details -->
      <div class="space-y-4">
        <div class="bg-red-900/30 border border-red-800/50 rounded-lg p-4">
          <p class="text-sm text-red-300 font-medium"><%= error %></p>
          <% if (locals.error_description) { %>
            <p class="text-sm text-gray-400 mt-2"><%= error_description %></p>
          <% } %>
        </div>

        <% if (process.env.NODE_ENV !== 'production') { %>
          <details class="text-sm">
            <summary class="text-gray-500 cursor-pointer hover:text-gray-400 transition-colors">상세 정보</summary>
            <pre class="mt-2 bg-gray-900/50 border border-gray-700 rounded-lg p-3 text-xs text-gray-400 overflow-auto max-h-48"><%= JSON.stringify(details, null, 2) %></pre>
          </details>
        <% } %>
      </div>

      <!-- Action -->
      <div class="mt-6 text-center">
        <a href="javascript:history.back()" class="inline-block px-6 py-2.5 bg-gray-700 hover:bg-gray-600 text-white font-medium rounded-lg transition-colors">
          돌아가기
        </a>
      </div>
    </div>
  </div>
</body>
</html>
