<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>로그인 - <%= locals.client?.clientName || 'Application' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen flex items-center justify-center">
  <!-- Background blur orbs -->
  <div class="fixed bottom-0 left-0 w-[500px] h-[500px] bg-blue-500/20 rounded-full blur-3xl -translate-x-1/2 translate-y-1/2"></div>
  <div class="fixed top-0 right-0 w-[400px] h-[400px] bg-purple-500/10 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2"></div>

  <div class="relative z-10 w-full max-w-md px-6">
    <div class="bg-gray-800/80 backdrop-blur-sm p-8 rounded-2xl shadow-xl border border-gray-700">
      <!-- Logo/Title -->
      <div class="text-center mb-8">
        <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-purple-600 rounded-2xl mx-auto mb-4 flex items-center justify-center">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
        </div>
        <h1 class="text-2xl font-bold">로그인</h1>
        <% if (locals.client) { %>
          <p class="text-gray-400 mt-2"><%= client.clientName %>에 로그인</p>
        <% } %>
      </div>

      <!-- Dev Mode Badge -->
      <% if (locals.isDev) { %>
        <div class="bg-yellow-500/20 border border-yellow-500/50 text-yellow-400 p-3 rounded-lg mb-6 text-center text-sm">
          DEV MODE - Super Admin 계정이 자동 입력되었습니다
        </div>
      <% } %>

      <!-- Error Message -->
      <% if (locals.error) { %>
        <div class="bg-red-500/20 border border-red-500/50 text-red-400 p-4 rounded-lg mb-6">
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <%= error %>
          </div>
        </div>
      <% } %>

      <!-- Login Form -->
      <form method="post" action="/interaction/<%= uid %>/login" class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-2">이메일</label>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            class="w-full px-4 py-3 bg-gray-700/50 border border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all placeholder-gray-400"
            placeholder="your@email.com"
            <% if (locals.isDev) { %>value="ceo@f45training.co.kr"<% } %>
          >
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-300 mb-2">비밀번호</label>
          <input
            type="password"
            name="password"
            required
            autocomplete="current-password"
            class="w-full px-4 py-3 bg-gray-700/50 border border-gray-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all placeholder-gray-400"
            placeholder="********"
            <% if (locals.isDev) { %>value="SuperAdmin123!@#"<% } %>
          >
        </div>

        <div class="flex items-center">
          <input
            type="checkbox"
            name="remember"
            id="remember"
            class="w-4 h-4 rounded border-gray-600 bg-gray-700 text-blue-500 focus:ring-blue-500 focus:ring-offset-gray-800"
          >
          <label for="remember" class="ml-2 text-sm text-gray-300">로그인 상태 유지</label>
        </div>

        <button
          type="submit"
          class="w-full py-3 px-4 bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white font-semibold rounded-xl transition-all duration-200 shadow-lg hover:shadow-xl"
        >
          로그인
        </button>
      </form>

      <!-- Cancel Link -->
      <div class="mt-6 text-center">
        <form method="post" action="/interaction/<%= uid %>/abort" class="inline">
          <button type="submit" class="text-gray-400 hover:text-gray-300 text-sm transition-colors">
            취소하고 돌아가기
          </button>
        </form>
      </div>
    </div>

    <!-- Footer -->
    <p class="text-center text-gray-500 text-sm mt-6">
      Powered by OIDC Identity Provider
    </p>
  </div>
</body>
</html>
