		"build": "tsc --noEmit && vite build",
		"preview": "vite preview --host 0.0.0.0 --port ${COVER_LETTER_WEB_PORT:-3016}",
		"type-check": "tsc --noEmit",
		"lint": "node ../../../scripts/lint-biome-workspace.mjs",
		"test": "tsx --test src/**/*.test.ts src/**/*.test.tsx"
	},
	"dependencies": {
		"@react-docx/core": "0.1.8",
		"docx": "^9.5.1",
		"mobx": "catalog:",
