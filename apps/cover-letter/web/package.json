		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"devDependencies": {
		"@types/jsdom": "^21.1.7",
		"@types/node": "catalog:",
		"@types/react": "^18.3.0",
		"@types/react-dom": "^18.3.0",
		"@vitejs/plugin-react": "5.1.4",
		"jsdom": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite": "7.3.7"
