{
	"$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"./apps/admin/web/**/*.{cjs,js,jsx,mjs,ts,tsx}",
			"./apps/core/api/**/*.{cjs,js,jsx,mjs,ts,tsx}",
			"./apps/proposal/web/**/*.{cjs,js,jsx,mjs,ts,tsx}",
			"./apps/test/e2e/**/*.{cjs,js,jsx,mjs,ts,tsx}",
			"./apps/tool/mobile-storybook/**/*.{cjs,js,jsx,mjs,ts,tsx}",
			"./apps/tool/storybook/**/*.{cjs,js,jsx,mjs,ts,tsx}",
			"./packages/**/*.{cjs,js,jsx,mjs,ts,tsx}",
			"./scripts/**/*.{cjs,js,jsx,mjs,ts,tsx}"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noShadowRestrictedNames": "off",
				"noRedeclare": "off",
				"noTemplateCurlyInString": "off"
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"useExhaustiveDependencies": "off",
				"useHookAtTopLevel": "off"
			},
			"complexity": {
				"noStaticOnlyClass": "off",
				"noUselessTypeConstraint": "off"
			},
			"style": {
				"useImportType": "off",
				"noNonNullAssertion": "off",
				"useNodejsImportProtocol": "error"
			},
			"a11y": {
				"useValidAnchor": "off",
				"noSvgWithoutTitle": "off",
				"noLabelWithoutControl": "off"
			},
			"security": {
				"noDangerouslySetInnerHtml": "off"
			},
			"nursery": {
				"useSortedClasses": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
