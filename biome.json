{
	"$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"./apps/admin/web/**/*.ts",
			"./apps/admin/web/**/*.tsx",
			"./apps/idp/api/src/**/*.ts",
			"./apps/idp/web/**/*.ts",
			"./apps/idp/web/**/*.tsx",
			"./apps/introduction/**/*.ts",
			"./apps/introduction/**/*.tsx",
			"./apps/introduction/**/*.css",
			"./apps/core/api/src/module/**/*.ts",
			"./apps/tool/storybook/**/*.ts",
			"./apps/tool/storybook/**/*.tsx",
			"./packages/be-common/**/*.ts",
			"./packages/be-decorator/**/*.ts",
			"./packages/be-dto/**/*.ts",
			"./packages/be-entity/**/*.ts",
			"./packages/be-app/**/*.ts",
			"./packages/be-integration/**/*.ts",
			"./packages/be-prisma/**/*.ts",
			"./packages/be-repository/**/*.ts",
			"./packages/be-service/**/*.ts",
			"./packages/be-vo/**/*.ts",
			"./packages/common-constant/**/*.ts",
			"./packages/common-enum/**/*.ts",
			"./packages/common-schema/**/*.ts",
			"./packages/common-toolkit/**/*.ts",
			"./packages/common-type/**/*.ts",
			"./packages/fe-api/**/*.ts",
			"./packages/fe-hook/**/*.ts",
			"./packages/fe-store/**/*.ts",
			"./packages/fe-store/**/*.tsx",
			"./packages/fe-ui/**/*.ts",
			"./packages/fe-ui/**/*.tsx"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noShadowRestrictedNames": "off",
				"noRedeclare": "off",
				"noTemplateCurlyInString": "off"
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"useExhaustiveDependencies": "off",
				"useHookAtTopLevel": "off"
			},
			"complexity": {
				"noStaticOnlyClass": "off",
				"noUselessTypeConstraint": "off"
			},
			"style": {
				"useImportType": "off",
				"noNonNullAssertion": "off",
				"useNodejsImportProtocol": "error"
			},
			"a11y": {
				"useValidAnchor": "off",
				"noSvgWithoutTitle": "off",
				"noLabelWithoutControl": "off"
			},
			"security": {
				"noDangerouslySetInnerHtml": "off"
			},
			"nursery": {
				"useSortedClasses": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
