{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml"
  ],
  "globalEnv": [
    "NODE_ENV",
    "REDIS_HOST",
    "REDIS_PORT",
    "REDIS_PASSWORD",
    "STORYBOOK_DISABLE_CHROMATIC",
    "STORYBOOK_REQUIRE_AUTH",
    "STORYBOOK_CORE_API_TARGET"
  ],
  "tasks": {
    // === 기본 태스크 ===
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "index.ts", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "start:dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "type-check": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "type-check:prod": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "lint": {},
    "lint:prod": {},
    "lint:fix": {},
    "format": {},
    "test": {
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    },

    // === 특수 빌드 패키지 ===
    "@cocrepo/prisma#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "schema/**",
        "scripts/**",
        "prisma.config.ts",
        "seed.ts",
        "data-migrate.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": ["dist/**"],
      "cache": true
    },
    "@cocrepo/e2e#build": {
      "outputs": []
    },
    "@cocrepo/hook#build": {
      "outputs": []
    },
    "@cocrepo/store#build": {
      "outputs": []
    },
    "@cocrepo/type#build": {
      "outputs": []
    },
    "@cocrepo/ui#build": {
      "outputs": []
    },

    // === 앱 태스크 ===
    "admin-web#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json", "next.config.*", "postcss.config.*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "cache": true
    },
    "admin-web#start:dev": {
      "dependsOn": ["^build"],
      "with": ["@cocrepo/constant#start:dev"],
      "cache": false,
      "persistent": true
    },
    "proposal-web#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json", "next.config.*", "postcss.config.*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "cache": true
    },
    "core-api#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "tsconfig.build.json", "package.json", "nest-cli.json"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "tool-storybook#build": {
      "dependsOn": ["^build"],
      "inputs": [
        ".storybook/**",
        "package.json",
        "postcss.config.*",
        "public/**",
        "tailwind.css",
        "test-setup.js",
        "tsconfig.json",
        "vitest.config.*",
        "hero.ts"
      ],
      "outputs": ["storybook-static/**"],
      "cache": true
    },
    "core-api#start:dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },

    // === DB 태스크 ===
    "db:push": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
